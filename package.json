{
  "name": "assured-methodology-docs",
  "version": "1.0.0",
  "description": "Documentation for the ASSURED methodology - A Structured Methodology for Event Triage and Investigation.",
  "author": {
    "name": "ASSURED Methodology Team"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/extract-glossary.mjs --check && node scripts/check-defineterms.mjs && astro build && pagefind --site dist",
    "glossary": "node scripts/extract-glossary.mjs",
    "glossary:check": "node scripts/extract-glossary.mjs --check",
    "dev": "astro dev",
    "preview": "astro preview",
    "start": "astro dev",
    "format": "biome format --write .",
    "check:terms": "node scripts/check-defineterms.mjs",
    "lint": "biome check src"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.1.8",
    "astro": "^5.18.1",
    "astro-breadcrumbs": "^3.3.1",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.15.29",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.11.1"
}
