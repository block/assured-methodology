{
  "name": "assured-methodology-docs",
  "version": "2.0.0",
  "description": "ASSURED: a methodology for security event triage. Source for the documentation site.",
  "author": {
    "name": "Timothy Zilber"
  },
  "license": "MIT AND CC-BY-4.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/extract-glossary.mjs --check && node scripts/check-defineterms.mjs && node scripts/check-content-contracts.mjs && node scripts/check-engineering-contracts.mjs && node scripts/check-contrast.mjs && node scripts/check-reading-order.mjs && node scripts/check-quiz-balance.mjs && node scripts/export-quiz-csv.mjs --check && node scripts/check-reserved-names.mjs && node scripts/check-attack-ids.mjs && node scripts/check-raw-headings.mjs && node scripts/check-template-schemas.mjs && node scripts/build-acronyms.mjs --check && astro build && node scripts/stamp-templates.mjs && node scripts/check-links.mjs && pagefind --site dist && node scripts/check-csp.mjs",
    "glossary": "node scripts/extract-glossary.mjs",
    "glossary:check": "node scripts/extract-glossary.mjs --check",
    "dev": "astro dev",
    "preview": "astro preview",
    "start": "astro dev",
    "format": "biome format --write .",
    "check:terms": "node scripts/check-defineterms.mjs",
    "check:terms:style": "node scripts/check-defineterms.mjs --style",
    "check:csp": "node scripts/check-csp.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:reading-order": "node scripts/check-reading-order.mjs",
    "quiz:csv": "node scripts/export-quiz-csv.mjs",
    "check:quiz-csv": "node scripts/export-quiz-csv.mjs --check",
    "typecheck": "astro check",
    "lint": "biome check src",
    "check:contracts": "node scripts/check-content-contracts.mjs && node scripts/check-engineering-contracts.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:determinism": "node scripts/check-build-determinism.mjs",
    "check:quiz": "node scripts/check-quiz-balance.mjs",
    "check:reserved-names": "node scripts/check-reserved-names.mjs",
    "check:attack-ids": "node scripts/check-attack-ids.mjs",
    "check:headings": "node scripts/check-raw-headings.mjs",
    "check:print": "node scripts/check-print-pages.mjs",
    "check:templates": "node scripts/check-template-schemas.mjs",
    "acronyms": "node scripts/build-acronyms.mjs",
    "check:acronyms": "node scripts/build-acronyms.mjs --check",
    "stamp:templates": "node scripts/stamp-templates.mjs",
    "test:gates": "node --test \"tests/scripts/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.8",
    "astro-breadcrumbs": "^3.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
