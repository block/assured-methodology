{
  "name": "assured-methodology-docs",
  "version": "1.2.0",
  "description": "Documentation for the ASSURED methodology - A Structured Methodology for Event Triage and Investigation.",
  "author": {
    "name": "ASSURED Methodology Team"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "node scripts/extract-glossary.mjs --check && node scripts/check-defineterms.mjs && node scripts/check-content-contracts.mjs && node scripts/check-engineering-contracts.mjs && node scripts/check-contrast.mjs && node scripts/check-reading-order.mjs && astro build && node scripts/check-links.mjs && pagefind --site dist && node scripts/check-csp.mjs",
    "glossary": "node scripts/extract-glossary.mjs",
    "glossary:check": "node scripts/extract-glossary.mjs --check",
    "dev": "astro dev",
    "preview": "astro preview",
    "start": "astro dev",
    "format": "biome format --write .",
    "check:terms": "node scripts/check-defineterms.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:reading-order": "node scripts/check-reading-order.mjs",
    "typecheck": "astro check",
    "lint": "biome check src",
    "check:contracts": "node scripts/check-content-contracts.mjs && node scripts/check-engineering-contracts.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:determinism": "node scripts/check-build-determinism.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.1",
    "astro-breadcrumbs": "^3.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "overrides": {
      "js-yaml@>=4.0.0 <4.2.0": ">=4.2.0 <5",
      "mdast-util-to-hast@>=13.0.0 <13.2.1": ">=13.2.1",
      "smol-toml@<1.6.1": ">=1.6.1",
      "vite@>=6.0.0 <6.4.3": ">=6.4.3 <7"
    }
  }
}
