{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assured-methodology.vercel.app/templates/schema/alert-report-identity.schema.json",
  "title": "Alert report variant: identity compromise",
  "description": "Identity-compromise add-on blocks for the core alert report (alert-report.schema.json): identity and sessions, the sign-in chain, the MFA ceremony, consent grants and mailbox changes, and the revocation order. A record using it carries the core report's fields as well.",
  "x-assured-template": "alert-report-identity.md",
  "type": "object",
  "properties": {
    "identityAndSessions": {
      "x-assured-section": "Identity and sessions",
      "type": "object",
      "properties": {
        "account": {
          "x-assured-prompt": "Account",
          "type": "object",
          "properties": {
            "signInName": {
              "type": "string"
            },
            "kind": {
              "enum": ["human", "non-human"]
            },
            "owner": {
              "type": "string"
            },
            "rolesAndPrivilege": {
              "type": "string"
            }
          },
          "required": ["signInName", "kind", "owner"],
          "description": "Account (sign-in name, human or non-human, owner, roles and privilege)"
        },
        "sessions": {
          "x-assured-prompt": "Session IDs and token types in play",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "tokenType": {
                "type": "string"
              },
              "issuedAt": {
                "$ref": "assured-vocabulary.schema.json#/$defs/utc"
              }
            },
            "required": ["id", "tokenType"]
          },
          "description": "Session IDs and token types in play (session cookie, refresh token, access token, app-side session), each with issued at (UTC)"
        },
        "baseline": {
          "x-assured-prompt": "Baseline",
          "type": "string",
          "description": "Baseline (usual networks, devices, hours, client apps; source and period)"
        }
      },
      "required": ["account", "sessions", "baseline"]
    },
    "signInChain": {
      "x-assured-section": "Sign-in chain",
      "type": "object",
      "properties": {
        "rows": {
          "x-assured-columns": [
            "Time (UTC)",
            "Source IP and ASN",
            "Device and client app",
            "Authentication method",
            "Result",
            "Session or correlation ID"
          ],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": {
                "x-assured-column": "Time (UTC)",
                "$ref": "assured-vocabulary.schema.json#/$defs/utc"
              },
              "sourceIpAnd": {
                "x-assured-column": "Source IP and ASN",
                "type": "string"
              },
              "deviceAndClient": {
                "x-assured-column": "Device and client app",
                "type": "string"
              },
              "authenticationMethod": {
                "x-assured-column": "Authentication method",
                "type": "string"
              },
              "result": {
                "x-assured-column": "Result",
                "type": "string"
              },
              "sessionOrCorrelation": {
                "x-assured-column": "Session or correlation ID",
                "type": "string"
              }
            },
            "required": ["time", "result"]
          }
        }
      },
      "required": ["rows"]
    },
    "mfaCeremony": {
      "x-assured-section": "MFA ceremony",
      "type": "object",
      "properties": {
        "mfaPrompts": {
          "x-assured-prompt": "Prompts sent, denied and approved",
          "type": "object",
          "properties": {
            "sent": {
              "type": "integer",
              "minimum": 0
            },
            "denied": {
              "type": "integer",
              "minimum": 0
            },
            "approved": {
              "type": "integer",
              "minimum": 0
            },
            "times": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verifiedPushInForce": {
              "type": "string"
            }
          },
          "description": "Prompts sent, denied and approved (counts, times UTC), and whether number matching or another verified-push method was in force"
        },
        "methodChanges": {
          "x-assured-prompt": "Authentication methods or devices registered or changed in the window",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string"
              },
              "device": {
                "type": "string"
              },
              "registeredFrom": {
                "type": "string"
              },
              "at": {
                "$ref": "assured-vocabulary.schema.json#/$defs/utc"
              }
            },
            "required": ["method"]
          },
          "description": "Authentication methods or devices registered or changed in the window (method, device, registered from, at UTC)"
        },
        "userAccount": {
          "x-assured-prompt": "The user's own account of the prompts",
          "type": "object",
          "properties": {
            "channel": {
              "type": "string"
            },
            "at": {
              "$ref": "assured-vocabulary.schema.json#/$defs/utc"
            },
            "statement": {
              "type": "string"
            }
          },
          "description": "The user's own account of the prompts (channel and time UTC; an out-of-band statement settles \"was it you\", not what the session did)"
        }
      },
      "required": ["mfaPrompts", "methodChanges", "userAccount"]
    },
    "consentGrantsAndMailbox": {
      "x-assured-section": "Consent grants and mailbox changes",
      "type": "object",
      "properties": {
        "rows": {
          "x-assured-columns": [
            "Change (OAuth consent grant, mailbox rule, forwarding, delegate)",
            "Detail (app and publisher, scopes; rule conditions and action)",
            "Made by, from where",
            "At (UTC)",
            "Still in force (yes / no)"
          ],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "change": {
                "x-assured-column": "Change (OAuth consent grant, mailbox rule, forwarding, delegate)",
                "type": "string"
              },
              "detail": {
                "x-assured-column": "Detail (app and publisher, scopes; rule conditions and action)",
                "type": "string"
              },
              "madeByFrom": {
                "x-assured-column": "Made by, from where",
                "type": "string"
              },
              "at": {
                "x-assured-column": "At (UTC)",
                "$ref": "assured-vocabulary.schema.json#/$defs/utc"
              },
              "stillInForce": {
                "x-assured-column": "Still in force (yes / no)",
                "$ref": "assured-vocabulary.schema.json#/$defs/yesNo"
              }
            }
          }
        }
      }
    },
    "revocationOrder": {
      "x-assured-section": "Revocation order",
      "type": "object",
      "properties": {
        "credentialExposureStatus": {
          "x-assured-prompt": "Credential-exposure status",
          "type": "object",
          "properties": {
            "passwordResetAt": {
              "$ref": "assured-vocabulary.schema.json#/$defs/utc"
            },
            "sessionsRevokedAt": {
              "$ref": "assured-vocabulary.schema.json#/$defs/utc"
            },
            "mfaMethodsReviewedAt": {
              "$ref": "assured-vocabulary.schema.json#/$defs/utc"
            }
          },
          "description": "Credential-exposure status (exposed until the password is reset, sessions are revoked and MFA methods are reviewed; each with time UTC)"
        },
        "rows": {
          "x-assured-columns": [
            "Step",
            "Action",
            "Pre-authorized or approved by (who)",
            "Done at (UTC)",
            "Verified how"
          ],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step": {
                "x-assured-column": "Step",
                "type": "integer",
                "minimum": 1
              },
              "action": {
                "x-assured-column": "Action",
                "type": "string"
              },
              "authorizedBy": {
                "x-assured-column": "Pre-authorized or approved by (who)",
                "type": "string"
              },
              "doneAt": {
                "x-assured-column": "Done at (UTC)",
                "$ref": "assured-vocabulary.schema.json#/$defs/utc"
              },
              "verifiedHow": {
                "x-assured-column": "Verified how",
                "type": "string"
              }
            },
            "required": ["step", "action"]
          }
        }
      },
      "required": ["credentialExposureStatus", "rows"]
    }
  },
  "required": [
    "identityAndSessions",
    "signInChain",
    "mfaCeremony",
    "consentGrantsAndMailbox",
    "revocationOrder"
  ]
}
