---
import { getUrlRelativeToBase } from "@/lib/utils";
---

<!-- Logo/Brand. The puzzle piece carries the methodology's central metaphor:
     each alert is a piece, ASSURED is the way you assemble them. -->
<a href={getUrlRelativeToBase("/")} class="brand-link" aria-label="ASSURED home">
  <div class="brand-content">
    <div class="brand-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path
          d="M5 4h5v2.4a1.6 1.6 0 0 0 3.2 0V4H19a1 1 0 0 1 1 1v5h-2.4a1.6 1.6 0 0 0 0 3.2H20v5a1 1 0 0 1-1 1h-5v-2.4a1.6 1.6 0 0 0-3.2 0V19H5a1 1 0 0 1-1-1v-5h2.4a1.6 1.6 0 0 0 0-3.2H4V5a1 1 0 0 1 1-1z"
          fill="currentColor"
          fill-opacity="0.18"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
      </svg>
    </div>
    <span class="brand-text whitespace-nowrap">ASSURED</span>
  </div>
</a>

<style>

  /* Brand Styling */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .brand-link:hover {
    opacity: 0.8;
  }

  .brand-content {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: hsl(var(--primary));
    transition: color 0.2s ease;
  }

  .brand-link:hover .brand-icon {
    color: hsl(var(--accent));
  }

  .brand-text {
    font-weight: 700;
    font-size: 1.125rem;
    color: hsl(var(--foreground));
  }

</style>