---
interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogImage?: URL | undefined;
  noindex?: boolean | undefined;
}

// Canonical URLs use a trailing slash to match Vercel's serving behavior
// (vercel.json sets trailingSlash: true), so /docs/alert and /docs/alert/
// consolidate onto one indexed URL.
const canonicalPathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPathname, Astro.site);

// og:image must resolve against the site root, not the page URL; a
// page-relative reference turns into /docs/intro/og-image.png and 404s.
const ogImage = Astro.props.ogImage ?? new URL("og-image.png", Astro.site);

const { title, description, noindex } = Astro.props;
const siteName = "ASSURED Methodology";
const fullTitle = title
  ? title.includes("ASSURED")
    ? title
    : `${title} · ${siteName}`
  : siteName;

const websiteSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  alternateName: "ASSURED",
  url: Astro.site?.href,
  description:
    "A structured, repeatable methodology for security event triage.",
});
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{/* The site is dark-only; theme-color keeps browser chrome (mobile address
    bar, PWA title bar) on the page's own slate instead of white. The
    matching color-scheme declaration lives in assured.css. */}
<meta name="theme-color" content="#0f172a" />
<meta name="generator" content={Astro.generator} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
{/* The Content-Security-Policy is delivered as a header from vercel.json
    (headers support frame-ancestors and per-script hashes; a meta CSP
    can't and would have to allow 'unsafe-inline'). scripts/check-csp.mjs
    keeps the header's hashes in sync with the built inline scripts. */}
<link rel="canonical" href={canonicalURL} />
{/* favicon.ico carries sizes="32x32" so Chrome prefers the SVG icon;
    without a sizes hint Chrome picks the .ico regardless of order.
    The manifest's PNG icons live in /site.webmanifest. */}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
{/* Error pages opt out of indexing explicitly: unknown paths return a real
    404 status, but Vercel serves the literal file /404.html with a 200, so
    the page is otherwise reachable at an indexable URL. */}
{noindex && <meta name="robots" content="noindex" />}
<script is:inline type="application/ld+json" set:html={websiteSchema} />

<meta property="og:type" content="website" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={siteName} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="ASSURED: a structured methodology for security event triage" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
