---
interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogImage?: URL | undefined;
}

// Canonical URLs use a trailing slash to match Vercel's serving behavior
// (vercel.json sets trailingSlash: true), so /docs/alert and /docs/alert/
// consolidate onto one indexed URL.
const canonicalPathname = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPathname, Astro.site);

// og:image must resolve against the site root, not the page URL — a
// page-relative reference turns into /docs/intro/og-image.png and 404s.
const ogImage = Astro.props.ogImage ?? new URL("og-image.png", Astro.site);

const { title, description } = Astro.props;
const siteName = "ASSURED Methodology";
const fullTitle = title
  ? title.includes("ASSURED")
    ? title
    : `${title} · ${siteName}`
  : siteName;
---

<meta charset="utf-8" />
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="referrer" content="strict-origin-when-cross-origin" />
{/* frame-ancestors is intentionally absent: browsers ignore it in a meta CSP.
    Framing protection comes from the X-Frame-Options header in vercel.json. */}
<meta
  http-equiv="Content-Security-Policy"
  content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'none'"
/>
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="ASSURED — a structured methodology for security event triage" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
