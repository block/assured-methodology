---
import Brand from "@/components/Brand.astro";
import SiteSearch from "@/components/SiteSearch.astro";
import type { NavItem } from "@/data/navigation";
import { primaryNavigation, quickReference } from "@/data/navigation";
import { getUrlRelativeToBase, isActivePage } from "@/lib/utils";

// Nav hrefs use the trailing-slash form, so normalize the pathname to match.
const currentPath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

// Fragment-insensitive exact match (Reading telemetry's href carries
// "#reading-telemetry"; the Field reference hub must not light up for it).
const pathOf = (href: string) => getUrlRelativeToBase(href.split("#")[0]);

// A group is active when the current page lives anywhere in its subtree.
// Most groups' children sit at sibling paths (Operate holds /docs/fast-path/
// and /docs/adoption/), so the parent's href prefix alone cannot see them.
const isActiveSection = (item: NavItem): boolean =>
  (!item.href.includes("#") && isActivePage(item.href, currentPath)) ||
  (item.children?.some(isActiveSection) ?? false);

// A dropdown row: exact page, or a section whose subsection is open.
const isActiveRow = (item: NavItem): boolean =>
  item.href.includes("#")
    ? (item.children?.some(isActiveRow) ?? false)
    : isActivePage(item.href, currentPath);

const quickRefActive = currentPath === pathOf(quickReference.href);
---

<header class="header">
  <div class="header__inner">
    <div class="header__left">
      <Brand />

      <nav class="header__nav" aria-label="Primary">
        {primaryNavigation.map((item) => {
          const isActive = isActiveSection(item);
          // aria-current="page" is only true on the exact page; an ancestor
          // section link gets "true" so screen readers don't hear "current
          // page" on every subpage of the section (WAI-ARIA aria-current).
          const ariaCurrent = isActive
            ? currentPath === pathOf(item.href)
              ? "page"
              : "true"
            : undefined;
          // Disclosure navigation (WAI-ARIA APG "disclosure navigation menu"),
          // not an ARIA menu widget: the top-level link stays a plain link to
          // the group's hub page, and an adjacent button with aria-expanded
          // opens its dropdown. A closed dropdown is visibility:hidden, so its
          // links are out of the Tab order; keyboard users tab across the six
          // groups (link, toggle, link, toggle...) instead of through every
          // dropdown link. Mouse users still get the dropdown on :hover.
          // Before the script runs (or without JS) the toggle is out of the
          // Tab order and the old :focus-within reveal applies, so nothing
          // becomes unreachable.
          const children = item.children ?? [];
          const dropdownId = `header-dropdown-${item.href.replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "")}`;
          // A hub row only when no child already links to the hub page
          // (Start here's "Choose your path" is its hub).
          const hasOverviewPage = !children.some((child) => child.href === item.href);
          return (
            <div class="header__menu-item">
              <a
                href={getUrlRelativeToBase(item.href)}
                class={`header__link header__link--has-menu ${isActive ? "is-active" : ""}`}
                aria-current={ariaCurrent}
              >
                {item.title}
              </a>
              <button
                type="button"
                class={`header__menu-toggle ${isActive ? "is-active" : ""}`}
                aria-expanded="false"
                aria-controls={dropdownId}
                aria-label={`${item.title} pages`}
                tabindex="-1"
                data-menu-disclosure
              >
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
              <div class="header__dropdown" id={dropdownId}>
                {hasOverviewPage && (
                  <a
                    href={getUrlRelativeToBase(item.href)}
                    class={`header__dropdown-link header__dropdown-link--overview ${currentPath === pathOf(item.href) ? "is-active" : ""}`}
                  >
                    <span class="header__dropdown-title">{item.title}: all pages</span>
                    {item.description && (
                      <span class="header__dropdown-sub">{item.description}</span>
                    )}
                  </a>
                )}
                {children.map((child) =>
                  child.expandInMenu && child.children ? (
                    <div class="header__dropdown-group">
                      <a
                        href={getUrlRelativeToBase(child.href)}
                        class="header__dropdown-heading"
                      >
                        {child.title}
                      </a>
                      {child.children.map((grandchild) => (
                        <a
                          href={getUrlRelativeToBase(grandchild.href)}
                          class={`header__dropdown-link header__dropdown-link--nested ${isActiveRow(grandchild) ? "is-active" : ""}`}
                        >
                          <span class="header__dropdown-title">{grandchild.title}</span>
                        </a>
                      ))}
                    </div>
                  ) : (
                    // Sections only: Alert's pillars and the Reading
                    // telemetry pages are reached from their section page.
                    // Prefix-match so a section row stays lit while reading
                    // one of its subsections.
                    <a
                      href={getUrlRelativeToBase(child.href)}
                      class={`header__dropdown-link ${isActiveRow(child) ? "is-active" : ""}`}
                    >
                      <span class="header__dropdown-title">
                        {child.letter && <span class="header__dropdown-letter" aria-hidden="true">{child.letter}</span>}
                        {child.title}
                      </span>
                    </a>
                  ),
                )}
              </div>
            </div>
          );
        })}
      </nav>
    </div>

    <div class="header__right">
      {/* The desk card stays one click away at every width: the on-shift
          reader's fastest route, outside any dropdown. */}
      <a
        href={getUrlRelativeToBase(quickReference.href)}
        class={`header__quickref ${quickRefActive ? "is-active" : ""}`}
        aria-current={quickRefActive ? "page" : undefined}
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="3" width="16" height="18" rx="2"></rect>
          <line x1="8" y1="8" x2="16" y2="8"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
          <line x1="8" y1="16" x2="13" y2="16"></line>
        </svg>
        <span>{quickReference.title}</span>
      </a>

      <SiteSearch />

      <a
        href="https://github.com/block/assured-methodology"
        target="_blank"
        rel="noopener noreferrer"
        class="header__icon"
        title="View on GitHub"
        aria-label="View on GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>

      <button type="button" class="header__menu-btn" aria-label="Toggle navigation" aria-expanded="false" aria-controls="header-mobile-menu" data-menu-toggle>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6"  x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav class="header__mobile" id="header-mobile-menu" data-mobile-menu aria-label="Mobile">
    <a
      href={getUrlRelativeToBase(quickReference.href)}
      class={`header__mobile-link header__mobile-link--quickref ${quickRefActive ? "is-active" : ""}`}
    >
      {quickReference.title}
    </a>
    {primaryNavigation.map((item) => {
      const isActive = isActiveSection(item);
      return (
        <div class="header__mobile-group">
          <a
            href={getUrlRelativeToBase(item.href)}
            class={`header__mobile-link ${isActive ? "is-active" : ""}`}
          >
            {item.title}
          </a>
          {item.children && item.children.length > 0 && (
            <div class="header__mobile-sublist">
              {item.children.map((child) => (
                <>
                  <a
                    href={getUrlRelativeToBase(child.href)}
                    class={`header__mobile-sublink ${!child.expandInMenu && isActiveRow(child) ? "is-active" : ""}`}
                  >
                    {child.title}
                  </a>
                  {child.expandInMenu && child.children && (
                    <div class="header__mobile-sublist header__mobile-sublist--nested">
                      {child.children.map((grandchild) => (
                        <a
                          href={getUrlRelativeToBase(grandchild.href)}
                          class={`header__mobile-sublink ${isActiveRow(grandchild) ? "is-active" : ""}`}
                        >
                          {grandchild.title}
                        </a>
                      ))}
                    </div>
                  )}
                </>
              ))}
            </div>
          )}
        </div>
      );
    })}
  </nav>

  {/* No-JS fallback: below 1240px the desktop nav is display:none and the
      mobile menu only opens via the toggle script, leaving no way to reach
      other pages. Without JavaScript, show the mobile link list in place
      (the header drops its stickiness so the list reads as a plain
      top-of-page nav) and hide the toggle that would otherwise do nothing.
      Desktop (>=1240px) needs nothing: the nav and its dropdowns are pure
      CSS (:hover/:focus-within). */}
  <noscript>
    <style is:inline>
      /* !important like ExampleStepper's no-JS block: Astro's scoped
         selectors (.header__mobile[data-astro-cid-*]) outrank these plain
         class selectors. */
      @media (max-width: 1239.98px) {
        .header { position: static !important; }
        .header__mobile { display: flex !important; }
        .header__menu-btn { display: none !important; }
      }
    </style>
  </noscript>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .header__inner {
    width: 100%;
    margin: 0;
    padding: 0 1.5rem;
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .header__inner { padding: 0 2rem; }
  }

  .header__left {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex: 1;
    min-width: 0;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: nowrap;
  }

  /* Six top-level groups (Start here, Method, Operate, Field reference,
     Teach and train, About), plus the Quick reference button, search and
     GitHub on the right. The desktop nav starts at 1240px, the width at
     which SiteSearch's own compact tier begins (Windows scrollbars eat
     ~17px of the media-query width). Below that the hamburger menu takes
     over. */
  @media (min-width: 1240px) {
    .header__nav { display: flex; }
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.55rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--assured-text-muted);
    text-decoration: none;
    border-radius: 0.5rem;
    transition: color 0.15s ease, background 0.15s ease;
    position: relative;
    white-space: nowrap;
  }

  /* Tightest tier, for laptop widths: minimal spacing and a slightly
     smaller label size; SiteSearch drops its shortcut hint over the same range. */
  @media (min-width: 1240px) and (max-width: 1449px) {
    .header__inner { padding: 0 1.5rem; gap: 1rem; }
    .header__left { gap: 0.85rem; }
    .header__link { padding: 0.45rem 0.3rem; font-size: 0.86rem; }
    .header__nav { gap: 0.1rem; }
  }

  /* Compact spacing until the viewport can hold the roomier layout. */
  @media (min-width: 1450px) and (max-width: 1549px) {
    .header__left { gap: 1.25rem; }
    .header__link { padding: 0.45rem 0.35rem; }
    .header__nav { gap: 0.15rem; }
  }

  @media (min-width: 1550px) {
    .header__link { padding: 0.45rem 0.7rem; }
    .header__nav { gap: 0.4rem; }
  }

  .header__link:hover {
    color: var(--assured-text);
    background: rgba(248, 250, 252, 0.06);
  }

  .header__link.is-active {
    color: var(--assured-accent-soft);
    background: rgba(20, 184, 166, 0.12);
  }

  .header__menu-item {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  /* The link and its toggle read as one control: the link gives up its
     right padding and the toggle carries the chevron that used to sit
     inside the link. */
  .header__link--has-menu {
    padding-right: 0.1rem;
  }

  .header__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    /* WCAG 2.5.8 target size: at least 24 by 24 CSS px. */
    min-width: 24px;
    min-height: 24px;
    padding: 0;
    margin: 0;
    background: transparent;
    border: none;
    border-radius: 0.4rem;
    color: var(--assured-text-muted);
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .header__menu-toggle:hover {
    color: var(--assured-text);
    background: rgba(248, 250, 252, 0.06);
  }

  .header__menu-toggle.is-active {
    color: var(--assured-accent-soft);
  }

  /* Visible focus indicator (WCAG 2.4.7). */
  .header__menu-toggle:focus-visible {
    outline: 2px solid var(--assured-accent-soft);
    outline-offset: 1px;
  }

  .header__menu-toggle svg {
    transition: transform 0.2s ease;
    opacity: 0.7;
  }


  .header__menu-item:hover .header__menu-toggle svg,
  .header__menu-item.is-open .header__menu-toggle svg,
  .header:not([data-disclosure-ready]) .header__menu-item:focus-within .header__menu-toggle svg {
    transform: rotate(180deg);
    opacity: 1;
  }

  .header__dropdown {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    min-width: 16rem;
    /* Cap the menu so short landscape viewports scroll it instead of
       clipping it. */
    max-height: calc(100vh - 90px);
    overflow-y: auto;
    padding: 0.5rem;
    background: rgba(15, 23, 42, 0.98);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 0.6rem;
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    z-index: 100;
  }

  /* The last nav item sits near the viewport edge; a left-aligned dropdown
     there extends past the page and adds a horizontal scrollbar even while
     hidden (visibility:hidden still occupies layout space). */
  .header__nav > :last-child .header__dropdown {
    left: auto;
    right: 0;
  }

  /* Revealed by hover (mouse) or by the toggle button (.is-open). Without
     the script, :focus-within keeps the links reachable by keyboard. */
  .header__menu-item:hover .header__dropdown,
  .header__menu-item.is-open .header__dropdown,
  .header:not([data-disclosure-ready]) .header__menu-item:focus-within .header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Escape dismisses a hover- or focus-revealed dropdown without moving the
     pointer or focus (WCAG 1.4.13 dismissable); the script clears the class
     on mouseleave/focusout so the next reveal works. Must come after the
     reveal rule: equal specificity, so source order decides. */
  .header__menu-item.is-dismissed .header__dropdown {
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
  }

  .header__menu-item.is-dismissed .header__menu-toggle svg {
    transform: none;
  }

  .header__dropdown-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.4rem;
    color: var(--assured-text-soft);
    text-decoration: none;
    transition: background 0.12s ease, color 0.12s ease;
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .header__dropdown-link:hover,
  .header__dropdown-link:focus-visible {
    background: rgba(20, 184, 166, 0.14);
    color: var(--assured-text);
  }

  /* Keyboard users need a visible focus indicator (WCAG 2.4.7); the faint
     background tint alone fails for low-vision users. */
  .header__dropdown-link:focus-visible {
    outline: 2px solid var(--assured-accent-soft);
    outline-offset: -2px;
  }

  .header__dropdown-link.is-active {
    background: rgba(20, 184, 166, 0.18);
    color: var(--assured-accent-soft);
  }

  .header__dropdown-link--overview {
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    padding-bottom: 0.65rem;
    margin-bottom: 0.25rem;
  }

  .header__dropdown-link--overview .header__dropdown-title {
    color: var(--assured-accent-soft);
  }

  .header__dropdown-title {
    font-weight: 600;
  }

  .header__dropdown-letter {
    display: inline-block;
    width: 1.1rem;
    margin-right: 0.35rem;
    color: var(--assured-accent-soft);
    font-weight: 800;
  }

  .header__dropdown-group {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-top: 0.25rem;
    padding-top: 0.35rem;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
  }

  .header__dropdown-heading {
    padding: 0.35rem 0.75rem 0.2rem;
    color: var(--assured-text-dim);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0.4rem;
  }

  .header__dropdown-heading:hover {
    color: var(--assured-text);
  }

  .header__dropdown-heading:focus-visible {
    outline: 2px solid var(--assured-accent-soft);
    outline-offset: -2px;
  }

  .header__dropdown-link--nested {
    padding-left: 1.25rem;
  }

  .header__dropdown-sub {
    font-size: 0.74rem;
    color: var(--assured-text-dim);
    font-weight: 400;
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .header__quickref {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    color: var(--assured-accent-soft);
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    border: 1px solid rgba(20, 184, 166, 0.4);
    border-radius: 0.5rem;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }

  .header__quickref:hover,
  .header__quickref.is-active {
    color: var(--assured-text);
    background: rgba(20, 184, 166, 0.14);
    border-color: rgba(20, 184, 166, 0.65);
  }

  .header__quickref:focus-visible {
    outline: 2px solid var(--assured-accent-soft);
    outline-offset: 2px;
  }

  /* Narrow phones: icon only, the label stays in the accessibility tree. */
  @media (max-width: 479.98px) {
    .header__quickref { padding: 0.45rem; }
    .header__quickref span {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
  }

  .header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem;
    color: var(--assured-text-muted);
    border-radius: 0.5rem;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .header__icon:hover {
    color: var(--assured-accent-soft);
    background: rgba(20, 184, 166, 0.08);
  }

  .header__menu-btn {
    display: inline-flex;
    padding: 0.45rem;
    color: var(--assured-text-muted);
    background: transparent;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 0.5rem;
    cursor: pointer;
  }

  @media (min-width: 1240px) {
    .header__menu-btn { display: none; }
  }

  .header__menu-btn:hover {
    color: var(--assured-text);
    border-color: rgba(20, 184, 166, 0.4);
  }

  /* 44px touch-target floor for the header's icon controls on touch devices
     and narrow screens (WCAG 2.5.5; these controls measured ~32px before). */
  @media (max-width: 1239px), (pointer: coarse) {
    .header__icon,
    .header__quickref,
    .header__menu-btn {
      min-width: 2.75rem;
      min-height: 2.75rem;
      align-items: center;
      justify-content: center;
    }
  }

  .header__mobile {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem 1rem;
    background: rgba(15, 23, 42, 0.95);
    border-top: 1px solid rgba(148, 163, 184, 0.18);
  }

  .header__mobile.is-open {
    display: flex;
    /* The panel lives inside the sticky header, so it must scroll itself:
       page scroll can never bring its lower links into view. */
    max-height: calc(100vh - var(--header-height));
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .header__mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.85rem;
    color: var(--assured-text-soft);
    text-decoration: none;
    border-radius: 0.5rem;
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(15, 23, 42, 0.5);
    font-weight: 500;
  }

  .header__mobile-link.is-active {
    color: var(--assured-accent-soft);
    border-color: rgba(20, 184, 166, 0.4);
  }

  .header__mobile-link--quickref {
    color: var(--assured-accent-soft);
    border-color: rgba(20, 184, 166, 0.4);
  }

  .header__mobile-link--label {
    cursor: default;
  }

  .header__mobile-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .header__mobile-sublist {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0.1rem 0 0.4rem 0.85rem;
    padding-left: 0.65rem;
    border-left: 2px solid rgba(20, 184, 166, 0.25);
  }

  .header__mobile-sublist--nested {
    margin-top: 0;
  }

  .header__mobile-sublink {
    display: flex;
    align-items: center;
    /* 44px touch-target floor (WCAG 2.5.5); padding alone measured ~35px. */
    min-height: 2.75rem;
    padding: 0.45rem 0.75rem;
    color: var(--assured-text-muted);
    text-decoration: none;
    border-radius: 0.4rem;
    font-size: 0.85rem;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .header__mobile-sublink:hover {
    color: var(--assured-text);
    background: rgba(20, 184, 166, 0.08);
  }

  .header__mobile-sublink.is-active {
    color: var(--assured-accent-soft);
    background: rgba(20, 184, 166, 0.12);
  }
</style>

<script>
  import { onPageReady } from "@/lib/dom";

  // ClientRouter idempotency: bind on both initial load and after every view transition.
  // Marker attribute prevents double-binding when the script re-runs against the same
  // element (e.g., view transition replaces the body but leaves the persistent island).
  function bindMobileMenu() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]:not([data-menu-bound])");
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    if (!toggle) return;
    toggle.setAttribute("data-menu-bound", "true");
    toggle.addEventListener("click", () => {
      menu?.classList.toggle("is-open");
      const isOpen = menu?.classList.contains("is-open");
      toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
      // Move focus to the first link so keyboard users land inside the menu
      // they just opened instead of having to tab past the rest of the header.
      if (isOpen) menu?.querySelector<HTMLAnchorElement>("a")?.focus();
    });
  }
  onPageReady(bindMobileMenu);

  // Desktop dropdowns: :hover reveals one for mouse users, and the
  // disclosure button (aria-expanded) opens it for keyboard and touch users.
  // The Escape handler below adds is-dismissed to close a hover-revealed one
  // without moving the pointer (WCAG 1.4.13). Clear the class once the
  // pointer or focus leaves the menu item so the next reveal works.
  function setOpen(item: HTMLElement, open: boolean) {
    item.classList.toggle("is-open", open);
    item
      .querySelector<HTMLButtonElement>("[data-menu-disclosure]")
      ?.setAttribute("aria-expanded", open ? "true" : "false");
  }

  function closeAllExcept(keep: HTMLElement | null) {
    document
      .querySelectorAll<HTMLElement>(".header__menu-item.is-open")
      .forEach((item) => {
        if (item !== keep) setOpen(item, false);
      });
  }

  function bindDesktopMenus() {
    const header = document.querySelector<HTMLElement>(".header");
    const items = document.querySelectorAll<HTMLElement>(
      ".header__menu-item:not([data-menu-esc-bound])",
    );
    items.forEach((item) => {
      item.setAttribute("data-menu-esc-bound", "true");
      const toggle = item.querySelector<HTMLButtonElement>("[data-menu-disclosure]");
      // Server HTML keeps the toggle out of the Tab order until it works.
      toggle?.removeAttribute("tabindex");
      toggle?.addEventListener("click", () => {
        const open = !item.classList.contains("is-open");
        closeAllExcept(item);
        item.classList.remove("is-dismissed");
        setOpen(item, open);
      });
      item.addEventListener("mouseleave", () => item.classList.remove("is-dismissed"));
      item.addEventListener("focusout", (e) => {
        if (!item.contains(e.relatedTarget as Node)) {
          item.classList.remove("is-dismissed");
          setOpen(item, false);
        }
      });
    });
    // Switches the CSS from the no-JS :focus-within reveal to the toggle.
    header?.setAttribute("data-disclosure-ready", "");
  }
  onPageReady(bindDesktopMenus);

  // A click outside an open dropdown closes it. Registered once per SPA
  // session; open items are queried live.
  if (!(window as any).__headerDisclosureOutsideBound) {
    (window as any).__headerDisclosureOutsideBound = true;
    document.addEventListener("click", (e) => {
      const target = e.target instanceof Element ? e.target : null;
      closeAllExcept(target?.closest<HTMLElement>(".header__menu-item") ?? null);
    });
  }

  // Escape closes exactly one navigation layer: the search dialog owns
  // Escape while it is open (its handler also stops propagation, but bundle
  // registration order isn't guaranteed, so guard here too), then the open
  // mobile menu, then a revealed desktop dropdown. Registered once per SPA
  // session (view transitions would stack duplicates); elements are
  // re-queried live because transitions swap the DOM.
  if (!(window as any).__mobileMenuEscBound) {
    (window as any).__mobileMenuEscBound = true;
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const searchModal = document.querySelector<HTMLDialogElement>("dialog[data-search-modal]");
      if (searchModal?.open) return;

      const openMenu = document.querySelector<HTMLElement>("[data-mobile-menu].is-open");
      if (openMenu) {
        openMenu.classList.remove("is-open");
        const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
        toggle?.setAttribute("aria-expanded", "false");
        toggle?.focus();
        return;
      }

      // Desktop dropdowns: close the toggle-opened menu and dismiss a
      // hover-revealed one. When Escape is pressed with focus inside the
      // dropdown, focus returns to its toggle (disclosure-nav pattern); a
      // hover-only dismissal leaves focus where it was.
      const active = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      const focusItem = active?.closest<HTMLElement>(".header__menu-item") ?? null;
      const openItems = new Set<HTMLElement>([
        ...Array.from(document.querySelectorAll<HTMLElement>(".header__menu-item:hover")),
        ...Array.from(document.querySelectorAll<HTMLElement>(".header__menu-item.is-open")),
      ]);
      if (focusItem) openItems.add(focusItem);
      if (openItems.size === 0) return;
      openItems.forEach((item) => {
        item.classList.add("is-dismissed");
        setOpen(item, false);
      });
      if (active?.closest(".header__dropdown")) {
        const toggle = focusItem?.querySelector<HTMLElement>("[data-menu-disclosure]");
        (toggle && !toggle.hasAttribute("tabindex")
          ? toggle
          : focusItem?.querySelector<HTMLAnchorElement>(".header__link--has-menu")
        )?.focus();
      }
    });
  }
</script>
