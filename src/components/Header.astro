---
import Brand from "@/components/Brand.astro";
import { getUrlRelativeToBase } from "@/lib/utils";
import { mainNavigation } from "@/data/navigation";
import { isActivePage } from "@/lib/utils";

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__inner">
    <div class="header__left">
      <Brand />

      <nav class="header__nav" aria-label="Primary">
        {mainNavigation[0].items.map((item) => {
          const isActive = isActivePage(item.href, currentPath);
          if (item.status === "soon") {
            return (
              <span class="header__link header__link--soon" aria-disabled="true" title="Coming soon">
                {item.title}
                <span class="header__soon-dot" aria-hidden="true"></span>
              </span>
            );
          }
          return (
            <a
              href={getUrlRelativeToBase(item.href)}
              class={`header__link ${isActive ? "is-active" : ""}`}
              aria-current={isActive ? "page" : undefined}
            >
              {item.title}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="header__right">
      <a
        href="https://github.com/block/assured-methodology"
        target="_blank"
        rel="noopener noreferrer"
        class="header__icon"
        title="View on GitHub"
        aria-label="View on GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>

      <button type="button" class="header__menu-btn" aria-label="Toggle navigation" data-menu-toggle>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6"  x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav class="header__mobile" data-mobile-menu aria-label="Mobile">
    {mainNavigation[0].items.map((item) => {
      const isActive = isActivePage(item.href, currentPath);
      if (item.status === "soon") {
        return (
          <span class="header__mobile-link header__mobile-link--soon" aria-disabled="true">
            {item.title}
            <span class="assured-soon">Soon</span>
          </span>
        );
      }
      return (
        <a
          href={getUrlRelativeToBase(item.href)}
          class={`header__mobile-link ${isActive ? "is-active" : ""}`}
        >
          {item.title}
        </a>
      );
    })}
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .header__inner {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .header__left {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex: 1;
    min-width: 0;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  @media (min-width: 768px) {
    .header__nav { display: flex; }
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #cbd5e1;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: color 0.15s ease, background 0.15s ease;
    position: relative;
    white-space: nowrap;
  }

  .header__link:hover {
    color: #f8fafc;
    background: rgba(248, 250, 252, 0.06);
  }

  .header__link.is-active {
    color: #5eead4;
    background: rgba(20, 184, 166, 0.12);
  }

  .header__link--soon {
    color: #94a3b8;
    cursor: not-allowed;
    opacity: 0.65;
  }

  .header__link--soon:hover {
    background: transparent;
    color: #94a3b8;
  }

  .header__soon-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: #f59e0b;
    box-shadow: 0 0 6px rgba(245, 158, 11, 0.5);
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem;
    color: #cbd5e1;
    border-radius: 0.5rem;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .header__icon:hover {
    color: #5eead4;
    background: rgba(20, 184, 166, 0.08);
  }

  .header__menu-btn {
    display: inline-flex;
    padding: 0.45rem;
    color: #cbd5e1;
    background: transparent;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 0.5rem;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .header__menu-btn { display: none; }
  }

  .header__menu-btn:hover {
    color: #f8fafc;
    border-color: rgba(20, 184, 166, 0.4);
  }

  .header__mobile {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem 1rem;
    background: rgba(15, 23, 42, 0.95);
    border-top: 1px solid rgba(148, 163, 184, 0.18);
  }

  .header__mobile.is-open {
    display: flex;
  }

  .header__mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.85rem;
    color: #e2e8f0;
    text-decoration: none;
    border-radius: 0.5rem;
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(15, 23, 42, 0.5);
    font-weight: 500;
  }

  .header__mobile-link.is-active {
    color: #5eead4;
    border-color: rgba(20, 184, 166, 0.4);
  }

  .header__mobile-link--soon {
    color: #94a3b8;
    opacity: 0.7;
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("is-open");
    const isOpen = menu?.classList.contains("is-open");
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });
</script>
