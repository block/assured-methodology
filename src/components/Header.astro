---
import Brand from "@/components/Brand.astro";
import SiteSearch from "@/components/SiteSearch.astro";
import { mainNavigation } from "@/data/navigation";
import { getUrlRelativeToBase } from "@/lib/utils";
import { isActivePage } from "@/lib/utils";

const currentPath = Astro.url.pathname;
---

<header class="header">
  <div class="header__inner">
    <div class="header__left">
      <Brand />

      <nav class="header__nav" aria-label="Primary">
        {mainNavigation[0].items.map((item) => {
          const isActive = isActivePage(item.href, currentPath);
          if (item.status === "soon") {
            return (
              <span class="header__link header__link--soon">
                {item.title}
                <span class="header__soon-dot" aria-hidden="true"></span>
                <span class="visually-hidden">(coming soon)</span>
              </span>
            );
          }
          // No role="menu"/"menuitem": these are plain navigation links revealed
          // by CSS :hover/:focus-within, not an ARIA menu widget (no roving
          // tabindex, no arrow-key handling, no managed expanded state). The
          // fake roles made screen readers promise menu semantics the keyboard
          // never delivered; honest links inside the nav landmark need none.
          if (item.children && item.children.length > 0) {
            return (
              <div class="header__menu-item">
                <a
                  href={getUrlRelativeToBase(item.href)}
                  class={`header__link header__link--has-menu ${isActive ? "is-active" : ""}`}
                  aria-current={isActive ? "page" : undefined}
                >
                  {item.title}
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </a>
                <div class="header__dropdown">
                  <a
                    href={getUrlRelativeToBase(item.href)}
                    class="header__dropdown-link header__dropdown-link--overview"
                  >
                    <span class="header__dropdown-title">{item.title} overview</span>
                    <span class="header__dropdown-sub">Chapter intro and outcomes</span>
                  </a>
                  {item.children.map((child) => {
                    if (child.status === "soon") {
                      return (
                        <span class="header__dropdown-link header__dropdown-link--soon">
                          <span class="header__dropdown-title">{child.title}</span>
                          <span class="assured-soon">Soon</span>
                        </span>
                      );
                    }
                    const childActive = currentPath === child.href || currentPath === child.href + "/";
                    return (
                      <>
                        <a
                          href={getUrlRelativeToBase(child.href)}
                          class={`header__dropdown-link ${childActive ? "is-active" : ""}`}
                        >
                          <span class="header__dropdown-title">{child.title}</span>
                        </a>
                        {child.children?.map((leaf) => {
                          const leafActive = currentPath === leaf.href || currentPath === leaf.href + "/";
                          return (
                            <a
                              href={getUrlRelativeToBase(leaf.href)}
                              class={`header__dropdown-link header__dropdown-link--sub ${leafActive ? "is-active" : ""}`}
                            >
                              <span class="header__dropdown-title">{leaf.title}</span>
                            </a>
                          );
                        })}
                      </>
                    );
                  })}
                </div>
              </div>
            );
          }
          return (
            <a
              href={getUrlRelativeToBase(item.href)}
              class={`header__link ${isActive ? "is-active" : ""}`}
              aria-current={isActive ? "page" : undefined}
            >
              {item.title}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="header__right">
      <SiteSearch />

      <a
        href="https://github.com/block/assured-methodology"
        target="_blank"
        rel="noopener noreferrer"
        class="header__icon"
        title="View on GitHub"
        aria-label="View on GitHub"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>

      <button type="button" class="header__menu-btn" aria-label="Toggle navigation" aria-expanded="false" aria-controls="header-mobile-menu" data-menu-toggle>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6"  x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <nav class="header__mobile" id="header-mobile-menu" data-mobile-menu aria-label="Mobile">
    {mainNavigation[0].items.map((item) => {
      const isActive = isActivePage(item.href, currentPath);
      if (item.status === "soon") {
        return (
          <span class="header__mobile-link header__mobile-link--soon">
            {item.title}
            <span class="assured-soon">Soon</span>
          </span>
        );
      }
      // Render nested children for items that have them (chapters, glossaries).
      const hasChildren = item.children && item.children.length > 0;
      return (
        <div class="header__mobile-group">
          <a
            href={getUrlRelativeToBase(item.href)}
            class={`header__mobile-link ${isActive ? "is-active" : ""}`}
          >
            {item.title}
          </a>
          {hasChildren && (
            <div class="header__mobile-sublist">
              {item.children!.map((child) => {
                if (child.status === "soon") return null;
                const childActive = currentPath === child.href || currentPath === child.href + "/";
                return (
                  <>
                    <a
                      href={getUrlRelativeToBase(child.href)}
                      class={`header__mobile-sublink ${childActive ? "is-active" : ""}`}
                    >
                      {child.title}
                    </a>
                    {child.children?.map((leaf) => {
                      const leafActive = currentPath === leaf.href || currentPath === leaf.href + "/";
                      return (
                        <a
                          href={getUrlRelativeToBase(leaf.href)}
                          class={`header__mobile-sublink header__mobile-sublink--sub ${leafActive ? "is-active" : ""}`}
                        >
                          {leaf.title}
                        </a>
                      );
                    })}
                  </>
                );
              })}
            </div>
          )}
        </div>
      );
    })}
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
  }

  .header__inner {
    width: 100%;
    margin: 0;
    padding: 0 1.5rem;
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .header__inner { padding: 0 2rem; }
  }

  .header__left {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex: 1;
    min-width: 0;
  }

  .header__nav {
    display: none;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: nowrap;
  }

  /* Eleven top-level items fit only from ~1350px up, even with compact spacing;
     below that the hamburger menu takes over (the nav used to paint over the
     search and GitHub controls when it was shown any narrower). */
  @media (min-width: 1350px) {
    .header__nav { display: flex; }
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.55rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--assured-text-muted);
    text-decoration: none;
    border-radius: 0.5rem;
    transition: color 0.15s ease, background 0.15s ease;
    position: relative;
    white-space: nowrap;
  }

  /* Compact spacing until the viewport can hold the roomier layout. */
  @media (min-width: 1350px) and (max-width: 1549px) {
    .header__left { gap: 1.25rem; }
    .header__link { padding: 0.45rem 0.35rem; }
    .header__nav { gap: 0.15rem; }
  }

  @media (min-width: 1550px) {
    .header__link { padding: 0.45rem 0.7rem; }
    .header__nav { gap: 0.4rem; }
  }

  .header__link:hover {
    color: var(--assured-text);
    background: rgba(248, 250, 252, 0.06);
  }

  .header__link.is-active {
    color: var(--assured-accent-soft);
    background: rgba(20, 184, 166, 0.12);
  }

  .header__link--soon {
    color: var(--assured-text-dim);
    cursor: not-allowed;
    opacity: 0.65;
  }

  .header__link--soon:hover {
    background: transparent;
    color: var(--assured-text-dim);
  }

  .header__soon-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 9999px;
    background: #f59e0b;
    box-shadow: 0 0 6px rgba(245, 158, 11, 0.5);
  }

  /* Visually hidden but present in the accessibility tree: gives the
     "soon" items a spoken status the amber dot only conveys visually. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Dropdown menus for nav items with children */
  .header__menu-item {
    position: relative;
  }

  .header__link--has-menu svg {
    transition: transform 0.2s ease;
    opacity: 0.7;
  }

  .header__menu-item:hover .header__link--has-menu svg,
  .header__menu-item:focus-within .header__link--has-menu svg {
    transform: rotate(180deg);
    opacity: 1;
  }

  .header__dropdown {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    min-width: 16rem;
    /* The Alert dropdown lists every leaf page; cap it so short viewports
       scroll the menu instead of clipping it. */
    max-height: calc(100vh - 90px);
    overflow-y: auto;
    padding: 0.5rem;
    background: rgba(15, 23, 42, 0.98);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 0.6rem;
    box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    z-index: 100;
  }

  /* The last nav item sits near the viewport edge; a left-aligned dropdown
     there extends past the page and adds a horizontal scrollbar even while
     hidden (visibility:hidden still occupies layout space). */
  .header__nav > :last-child .header__dropdown {
    left: auto;
    right: 0;
  }

  .header__menu-item:hover .header__dropdown,
  .header__menu-item:focus-within .header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__dropdown-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.4rem;
    color: var(--assured-text-soft);
    text-decoration: none;
    transition: background 0.12s ease, color 0.12s ease;
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .header__dropdown-link:hover,
  .header__dropdown-link:focus-visible {
    background: rgba(20, 184, 166, 0.14);
    color: var(--assured-text);
  }

  /* Keyboard users need a visible focus indicator (WCAG 2.4.7); the faint
     background tint alone fails for low-vision users. */
  .header__dropdown-link:focus-visible {
    outline: 2px solid var(--assured-accent-soft);
    outline-offset: -2px;
  }

  .header__dropdown-link.is-active {
    background: rgba(20, 184, 166, 0.18);
    color: var(--assured-accent-soft);
  }

  .header__dropdown-link--overview {
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    padding-bottom: 0.65rem;
    margin-bottom: 0.25rem;
  }

  .header__dropdown-link--sub {
    padding-left: 1.7rem;
    font-size: 0.8rem;
  }

  .header__dropdown-link--sub .header__dropdown-title {
    font-weight: 500;
    color: var(--assured-text-muted);
  }

  .header__dropdown-link--sub:hover .header__dropdown-title,
  .header__dropdown-link--sub.is-active .header__dropdown-title {
    color: inherit;
  }

  .header__dropdown-link--overview .header__dropdown-title {
    color: var(--assured-accent-soft);
  }

  .header__dropdown-link--soon {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    color: var(--assured-text-dim);
    cursor: not-allowed;
    opacity: 0.65;
  }

  .header__dropdown-title {
    font-weight: 600;
  }

  .header__dropdown-sub {
    font-size: 0.74rem;
    color: var(--assured-text-dim);
    font-weight: 400;
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem;
    color: var(--assured-text-muted);
    border-radius: 0.5rem;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .header__icon:hover {
    color: var(--assured-accent-soft);
    background: rgba(20, 184, 166, 0.08);
  }

  .header__menu-btn {
    display: inline-flex;
    padding: 0.45rem;
    color: var(--assured-text-muted);
    background: transparent;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 0.5rem;
    cursor: pointer;
  }

  @media (min-width: 1350px) {
    .header__menu-btn { display: none; }
  }

  .header__menu-btn:hover {
    color: var(--assured-text);
    border-color: rgba(20, 184, 166, 0.4);
  }

  /* 44px touch-target floor for the header's icon controls on touch devices
     and narrow screens (WCAG 2.5.5; the audit measured ~32px). */
  @media (max-width: 1349px), (pointer: coarse) {
    .header__icon,
    .header__menu-btn {
      min-width: 2.75rem;
      min-height: 2.75rem;
      align-items: center;
      justify-content: center;
    }
  }

  .header__mobile {
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem 1rem;
    background: rgba(15, 23, 42, 0.95);
    border-top: 1px solid rgba(148, 163, 184, 0.18);
  }

  .header__mobile.is-open {
    display: flex;
  }

  .header__mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.85rem;
    color: var(--assured-text-soft);
    text-decoration: none;
    border-radius: 0.5rem;
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(15, 23, 42, 0.5);
    font-weight: 500;
  }

  .header__mobile-link.is-active {
    color: var(--assured-accent-soft);
    border-color: rgba(20, 184, 166, 0.4);
  }

  .header__mobile-link--soon {
    color: var(--assured-text-dim);
    opacity: 0.7;
  }

  .header__mobile-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .header__mobile-sublist {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0.1rem 0 0.4rem 0.85rem;
    padding-left: 0.65rem;
    border-left: 2px solid rgba(20, 184, 166, 0.25);
  }

  .header__mobile-sublink {
    display: flex;
    align-items: center;
    /* 44px touch-target floor (WCAG 2.5.5); padding alone measured ~35px. */
    min-height: 2.75rem;
    padding: 0.45rem 0.75rem;
    color: var(--assured-text-muted);
    text-decoration: none;
    border-radius: 0.4rem;
    font-size: 0.85rem;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .header__mobile-sublink:hover {
    color: var(--assured-text);
    background: rgba(20, 184, 166, 0.08);
  }

  .header__mobile-sublink.is-active {
    color: var(--assured-accent-soft);
    background: rgba(20, 184, 166, 0.12);
  }

  .header__mobile-sublink--sub {
    margin-left: 1rem;
    font-size: 0.82rem;
  }
</style>

<script>
  import { onPageReady } from "@/lib/dom";

  // ClientRouter idempotency: bind on both initial load and after every view transition.
  // Marker attribute prevents double-binding when the script re-runs against the same
  // element (e.g., view transition replaces the body but leaves the persistent island).
  function bindMobileMenu() {
    const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]:not([data-menu-bound])");
    const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
    if (!toggle) return;
    toggle.setAttribute("data-menu-bound", "true");
    toggle.addEventListener("click", () => {
      menu?.classList.toggle("is-open");
      const isOpen = menu?.classList.contains("is-open");
      toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
      // Move focus to the first link so keyboard users land inside the menu
      // they just opened instead of having to tab past the rest of the header.
      if (isOpen) menu?.querySelector<HTMLAnchorElement>("a")?.focus();
    });
  }
  onPageReady(bindMobileMenu);

  // Escape closes the open mobile menu and returns focus to the toggle.
  // Registered once per SPA session (view transitions would stack duplicates);
  // elements are re-queried live because transitions swap the DOM.
  if (!(window as any).__mobileMenuEscBound) {
    (window as any).__mobileMenuEscBound = true;
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const openMenu = document.querySelector<HTMLElement>("[data-mobile-menu].is-open");
      if (!openMenu) return;
      openMenu.classList.remove("is-open");
      const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.focus();
    });
  }
</script>
