---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Show h1 + h2 in the in-page navigation. h2s are indented.
const filtered = headings.filter((h) => h.depth === 1 || h.depth === 2);
---

{filtered.length > 0 && (
  <nav id="table-of-contents" class="toc" aria-label="On this page">
    <h3 class="toc__title">On this page</h3>

    <ul class="toc__list">
      {filtered.map((heading) => (
        <li class={`toc__item toc__item--depth-${heading.depth}`}>
          <a
            href={`#${heading.slug}`}
            data-target={heading.slug}
            class="toc__link"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .toc__title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    /* #a8b3c4, not the slate-400 dim token: the TOC gutter is transparent over
       the page gradient, whose light end (#334155) leaves slate-400 at ~4.04:1. */
    color: #a8b3c4;
    margin: 0;
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .toc__item {
    margin: 0;
    padding: 0;
  }

  .toc__item--depth-2 .toc__link {
    padding-left: 1.5rem;
    font-size: 0.8rem;
    color: #a8b3c4;
  }

  .toc__link {
    display: block;
    padding: 0.35rem 0.6rem;
    font-size: 0.85rem;
    color: var(--assured-text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    border-radius: 0 0.35rem 0.35rem 0;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    line-height: 1.4;
  }

  .toc__link:hover {
    color: var(--assured-text);
    background: rgba(248, 250, 252, 0.04);
  }

  .toc__link.is-active {
    color: var(--assured-accent-soft);
    background: rgba(20, 184, 166, 0.08);
    border-left-color: var(--assured-accent);
    font-weight: 600;
  }
</style>

<script>
  import { anchorScrollOffset, onPageReady } from "@/lib/dom";

  /*
   * ClientRouter idempotency:
   *   - Scroll-spy state is page-local; each navigation must rebind to the new headings.
   *   - The scroll listener on window is registered ONCE via window.__tocScrollBound and
   *     reads live DOM each tick (so it picks up new headings after view transitions).
   *   - Link click handlers use a per-element data-toc-bound marker.
   */
  function bindToc() {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(".toc__link:not([data-toc-bound])")
    );
    links.forEach((link) => {
      link.setAttribute("data-toc-bound", "true");
      link.addEventListener("click", (e) => {
        const target = link.dataset.target;
        if (!target) return;
        const el = document.getElementById(target);
        if (!el) return;
        e.preventDefault();
        // scrollIntoView honors the target's scroll-margin-top, which comes
        // from the same --anchor-scroll-offset token the spy reads below.
        const smooth = window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
        el.scrollIntoView({ behavior: smooth, block: "start" });
        // replaceState, and with the router's own state object: a null-state
        // entry is one Astro's ClientRouter refuses to restore on Back.
        history.replaceState(history.state, "", `#${target}`);
      });
    });

    updateActive();
  }

  function updateActive() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc__link"));
    const headings = Array.from(document.querySelectorAll<HTMLElement>("h1[id], h2[id]"));
    if (!links.length || !headings.length) return;
    // Viewport-relative positions, not offsetTop: headings sit inside the
    // positioned .content-page, so offsetTop is not document-relative.
    // +1 tolerance: a click-scroll parks the heading exactly on the line.
    const spyLine = anchorScrollOffset() + 1;
    let active: HTMLElement | null = null;
    for (let i = headings.length - 1; i >= 0; i--) {
      if (headings[i].getBoundingClientRect().top <= spyLine) {
        active = headings[i];
        break;
      }
    }
    links.forEach((l) => {
      const matches = active && l.dataset.target === active.id;
      l.classList.toggle("is-active", !!matches);
    });
  }

  // One scroll listener for the SPA's whole lifetime; reads live DOM each tick.
  if (!(window as any).__tocScrollBound) {
    (window as any).__tocScrollBound = true;
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        updateActive();
        ticking = false;
      });
    });
  }

  onPageReady(bindToc);
</script>
