---
/**
 * SiteSearch, Pagefind-powered site-wide search.
 *
 * Renders a small search trigger button (intended for the header) plus a
 * native <dialog> that hosts Pagefind's default UI (behavior in
 * src/scripts/site-search.ts). The index lives at
 * /pagefind/, generated at build time by `pagefind --site dist` (chained
 * into pnpm build). In dev the index does not exist, so the modal shows
 * a graceful "build to use" message.
 *
 * Keyboard:
 *   - ⌘K (macOS) / Ctrl+K  open; the hint renders per platform
 *   - Esc          close (native dialog cancel)
 *   - ↓ / ↑        move through results (↑ from the first result returns to the input)
 *   - /            NOT bound here, CLEAR glossary owns / for its own search.
 */
---

<button
  type="button"
  class="site-search-trigger"
  data-search-open
  aria-label="Search the site (press Control + K)"
  title="Search (Ctrl K)"
>
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <span class="site-search-trigger__label">Search</span>
  {/* Ctrl K by default; the script switches it to ⌘K on macOS. */}
  <span class="site-search-trigger__kbd" data-search-kbd aria-hidden="true">Ctrl K</span>
</button>

<dialog class="site-search-modal" data-search-modal data-pagefind-base={import.meta.env.BASE_URL} aria-label="Search the site">
  <div class="site-search-modal__panel">
    <button type="button" class="site-search-modal__close" data-search-close aria-label="Close search">×</button>
    {/* Visually-hidden live region: announces the "search unavailable"
        fallback to screen readers, which otherwise only see the visual <p>. */}
    <div class="site-search-modal__status" data-search-status role="status"></div>
    <div id="site-search-ui" data-pagefind-ignore></div>
  </div>
</dialog>

<style>
  .site-search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.65rem;
    background: rgba(148, 163, 184, 0.08);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 0.5rem;
    color: var(--assured-text-muted);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.82rem;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .site-search-trigger:hover {
    background: rgba(148, 163, 184, 0.16);
    border-color: rgba(20, 184, 166, 0.4);
    color: var(--assured-text);
  }
  .site-search-trigger__label {
    display: none;
  }
  .site-search-trigger__kbd {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--assured-text-dim);
    padding: 0.05rem 0.35rem;
    background: var(--assured-panel);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 0.3rem;
  }
  @media (min-width: 768px) {
    .site-search-trigger__label { display: inline; }
    .site-search-trigger__kbd { display: inline; }
  }

  /* At laptop widths (1240-1449px) the header's six groups, the Quick
     reference button and GitHub leave room for the "Search" label but not
     the shortcut hint, so only the hint drops; the title keeps the
     shortcut discoverable. */
  @media (min-width: 1240px) and (max-width: 1449px) {
    .site-search-trigger__kbd { display: none; }
  }

  /* Icon-only below 768px measured ~31px square. The most-used control on
     the page needs the 44px touch-target floor (WCAG 2.5.5). */
  @media (max-width: 767px), (pointer: coarse) {
    .site-search-trigger {
      min-width: 2.75rem;
      min-height: 2.75rem;
      justify-content: center;
    }
  }

  /* The dialog box is the panel's frame: no padding or border of its own,
     so a click whose target is the dialog itself landed on the backdrop. */
  .site-search-modal {
    width: min(640px, calc(100% - 2rem));
    max-width: none;
    max-height: none;
    margin: 4rem auto auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    overflow: visible;
  }
  .site-search-modal::backdrop {
    background: rgba(2, 6, 23, 0.78);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .site-search-modal__panel {
    position: relative;
    width: 100%;
    max-height: calc(100vh - 6rem);
    /* dvh tracks iOS Safari's collapsing toolbars; 100vh above is the
       fallback and would put the panel's bottom edge behind the toolbar. */
    max-height: calc(100dvh - 6rem);
    overflow: auto;
    /* Reaching the results' end must not hand the scroll to the page
       behind the backdrop (iOS ignores body overflow:hidden for touch). */
    overscroll-behavior: contain;
    background: #0f172a;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 0.75rem;
    padding: 1.25rem;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.65);
    /* Default white scrollbar track slices down the dark modal; theme it. */
    scrollbar-color: rgba(148, 163, 184, 0.35) transparent;
  }
  .site-search-modal__panel::-webkit-scrollbar { width: 10px; }
  .site-search-modal__panel::-webkit-scrollbar-track { background: transparent; }
  .site-search-modal__panel::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.35);
    border-radius: 9999px;
  }
  .site-search-modal__close {
    position: absolute;
    top: 0.4rem;
    right: 0.6rem;
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 0;
    color: var(--assured-text-dim);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    border-radius: 0.35rem;
  }
  .site-search-modal__close:hover { color: var(--assured-text); background: rgba(148, 163, 184, 0.1); }

  /* The 44px touch-target floor (WCAG 2.5.5) the sibling controls get. */
  @media (pointer: coarse) {
    .site-search-modal__close {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .site-search-modal__fallback {
    margin: 0;
    padding: 0.5rem 2rem 0 0;
    color: var(--assured-text-dim);
    line-height: 1.5;
    font-size: 0.95rem;
  }

  /* Visually hidden but present in the accessibility tree. */
  .site-search-modal__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Pagefind UI dark-theme tokens */
  #site-search-ui {
    --pagefind-ui-primary: var(--assured-accent);
    --pagefind-ui-text: var(--assured-text-soft);
    --pagefind-ui-background: #0f172a;
    --pagefind-ui-border: rgba(148, 163, 184, 0.25);
    --pagefind-ui-tag: #1e293b;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-image-border-radius: 0.5rem;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: inherit;
  }
  #site-search-ui :global(.pagefind-ui__search-input) {
    background: rgba(15, 23, 42, 0.6);
    color: #f1f5f9;
  }
  #site-search-ui :global(.pagefind-ui__result-link) {
    color: var(--assured-accent-soft);
  }
  #site-search-ui :global(mark) {
    background: rgba(20, 184, 166, 0.25);
    color: #f0fdfa;
    padding: 0 0.15em;
    border-radius: 0.2em;
  }
</style>

<script>
  import "@/scripts/site-search.ts";
</script>
