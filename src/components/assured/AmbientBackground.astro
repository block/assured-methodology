---
/**
 * AmbientBackground. Shared full-bleed background layer for glossaries.
 *
 * Renders the themed gradient + grid. Pass a `motion` slot to add the
 * theme-specific motion ornament (BAD's particles, CAT's yarn balls,
 * CLEAR's beams). Each glossary keeps its motion CSS in its own MDX file.
 *
 * Usage:
 *   <AmbientBackground>
 *     <Fragment slot="motion">
 *       <div class="bad-bg__particles">...</div>
 *     </Fragment>
 *   </AmbientBackground>
 */
---

<div class="g-bg" aria-hidden="true">
  <div class="g-bg__grid"></div>
  <slot name="motion" />
</div>
