---
/**
 * AnimatedPhaseDiagram. The three-stage methodology flowchart with a
 * scroll-triggered reveal. Stage headers fade up first, then each phase
 * piece slides into place, then the connecting arrows draw in, then the
 * feedback loop arc fades in last.
 *
 * Uses an IntersectionObserver to trigger animation when the diagram enters
 * the viewport. Respects prefers-reduced-motion.
 */
---

<figure class="anim-diagram" data-anim-diagram>
  <svg viewBox="0 0 820 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="anim-diagram-title anim-diagram-desc">
    <title id="anim-diagram-title">ASSURED three-stage flow</title>
    <desc id="anim-diagram-desc">Stage one (Preparation and Context) feeds stage two (Investigation and Assessment), which feeds stage three (Resolution and Documentation). A feedback loop returns insight to the earlier stages.</desc>

    <defs>
      <!-- Both stops of every gradient clear WCAG AA 4.5:1 under the white
           16px labels; the lighter brand shades sit at 2.2-2.9:1. -->
      <linearGradient id="anim-phase1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#15803d"/>
        <stop offset="100%" stop-color="#166534"/>
      </linearGradient>
      <linearGradient id="anim-phase2" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#1d4ed8"/>
        <stop offset="100%" stop-color="#1e40af"/>
      </linearGradient>
      <linearGradient id="anim-phase3" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#b45309"/>
        <stop offset="100%" stop-color="#92400e"/>
      </linearGradient>
      <marker id="anim-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#cbd5e1"/>
      </marker>
    </defs>

    <!-- Phase header band -->
    <g class="anim-row" data-reveal="phase-headers">
      <g class="anim-item" style="--delay: 0ms;">
        <rect x="20"  y="20" width="240" height="70" rx="14" fill="url(#anim-phase1)"/>
        <text x="140" y="50" text-anchor="middle" class="anim-label">Preparation</text>
        <text x="140" y="72" text-anchor="middle" class="anim-label">&amp; Context</text>
      </g>
      <path class="anim-arrow-h" style="--delay: 280ms;" d="M 265 55 L 285 55" stroke="#cbd5e1" stroke-width="2" marker-end="url(#anim-arrow)"/>
      <g class="anim-item" style="--delay: 220ms;">
        <rect x="290" y="20" width="240" height="70" rx="14" fill="url(#anim-phase2)"/>
        <text x="410" y="50" text-anchor="middle" class="anim-label">Investigation</text>
        <text x="410" y="72" text-anchor="middle" class="anim-label">&amp; Assessment</text>
      </g>
      <path class="anim-arrow-h" style="--delay: 480ms;" d="M 535 55 L 555 55" stroke="#cbd5e1" stroke-width="2" marker-end="url(#anim-arrow)"/>
      <g class="anim-item" style="--delay: 440ms;">
        <rect x="560" y="20" width="240" height="70" rx="14" fill="url(#anim-phase3)"/>
        <text x="680" y="50" text-anchor="middle" class="anim-label">Resolution</text>
        <text x="680" y="72" text-anchor="middle" class="anim-label">&amp; Documentation</text>
      </g>
    </g>

    <!-- Component pieces. Cell fills are the AA-dark phase variants
         (--assured-phase-*-deep in assured.css, hardcoded here because SVG
         fill attributes can't read CSS custom properties), so the white cell
         text clears 4.5:1.
         Group 1 (Preparation): Alert=blue, Subject=green, Scope=purple.
         Group 2 (Investigation): Uncover=orange, Risk=red.
         Group 3 (Resolution): Escalation=indigo, Documentation=cyan. -->
    <g class="anim-components">
      <g class="anim-item" style="--delay: 620ms;">
        <rect x="20" y="130" width="110" height="55" rx="10" fill="#1d4ed8"/>
        <text x="75" y="163" text-anchor="middle" class="anim-cell">A · Alert</text>
      </g>
      <g class="anim-item" style="--delay: 720ms;">
        <rect x="140" y="130" width="120" height="55" rx="10" fill="#15803d"/>
        <text x="200" y="163" text-anchor="middle" class="anim-cell">S · Subject</text>
      </g>
      <g class="anim-item" style="--delay: 820ms;">
        <rect x="80" y="200" width="120" height="55" rx="10" fill="#7e22ce"/>
        <text x="140" y="232" text-anchor="middle" class="anim-cell">S · Scope</text>
      </g>

      <path class="anim-line" style="--delay: 900ms;" d="M 75 187 L 75 220 L 78 220" stroke="#94a3b8" stroke-width="2" fill="none"/>
      <path class="anim-line" style="--delay: 920ms;" d="M 200 187 L 200 220 L 197 220" stroke="#94a3b8" stroke-width="2" fill="none"/>
      <path class="anim-line" style="--delay: 980ms;" d="M 202 228 L 285 228" stroke="#94a3b8" stroke-width="2" marker-end="url(#anim-arrow)"/>

      <g class="anim-item" style="--delay: 1060ms;">
        <rect x="290" y="200" width="120" height="55" rx="10" fill="#c2410c"/>
        <text x="350" y="232" text-anchor="middle" class="anim-cell">U · Uncover</text>
      </g>
      <g class="anim-item" style="--delay: 1160ms;">
        <rect x="420" y="200" width="120" height="55" rx="10" fill="#b91c1c"/>
        <text x="480" y="232" text-anchor="middle" class="anim-cell">R · Risk</text>
      </g>

      <path class="anim-line" style="--delay: 1220ms;" d="M 412 228 L 418 228" stroke="#94a3b8" stroke-width="2" marker-end="url(#anim-arrow)"/>
      <path class="anim-line" style="--delay: 1260ms;" d="M 542 228 L 548 228" stroke="#94a3b8" stroke-width="2" marker-end="url(#anim-arrow)"/>

      <g class="anim-item" style="--delay: 1320ms;">
        <rect x="550" y="200" width="120" height="55" rx="10" fill="#4338ca"/>
        <text x="610" y="232" text-anchor="middle" class="anim-cell">E · Escalation</text>
      </g>
      <g class="anim-item" style="--delay: 1420ms;">
        <rect x="680" y="200" width="125" height="55" rx="10" fill="#0e7490"/>
        <text x="742" y="232" text-anchor="middle" class="anim-cell">D · Documentation</text>
      </g>

      <path class="anim-line" style="--delay: 1480ms;" d="M 670 228 L 678 228" stroke="#94a3b8" stroke-width="2" marker-end="url(#anim-arrow)"/>
    </g>

    <!-- Feedback loop -->
    <g class="anim-loop" data-feedback>
      <path class="anim-feedback-path" style="--delay: 1600ms;" d="M 480 270 Q 480 320 280 320 Q 140 320 140 270" stroke="#14b8a6" stroke-width="2" stroke-dasharray="6 6" fill="none" marker-end="url(#anim-arrow)"/>
      <text class="anim-feedback-text" style="--delay: 1900ms;" x="310" y="340" text-anchor="middle">↻ Feedback loop, refine scope, re-uncover, re-validate</text>
    </g>
  </svg>

  <!-- Stacked rendering for small screens. The fixed-viewBox SVG scales
       uniformly, which turns its labels into ~6px text at 375px wide. Below
       640px the SVG hides and this legible vertical flow shows instead;
       display:none keeps the hidden variant out of the accessibility tree,
       so screen readers only encounter one rendering. -->
  <div class="anim-stack">
    <div class="anim-stack__phase" style="--phase-a: #15803d; --phase-b: #166534;">
      <p class="anim-stack__label">Preparation &amp; Context</p>
      <ul class="anim-stack__cells">
        <li style="--cell: #1d4ed8;">A · Alert</li>
        <li style="--cell: #15803d;">S · Subject</li>
        <li style="--cell: #7e22ce;">S · Scope</li>
      </ul>
    </div>
    <div class="anim-stack__arrow" aria-hidden="true">↓</div>
    <div class="anim-stack__phase" style="--phase-a: #1d4ed8; --phase-b: #1e40af;">
      <p class="anim-stack__label">Investigation &amp; Assessment</p>
      <ul class="anim-stack__cells">
        <li style="--cell: #c2410c;">U · Uncover</li>
        <li style="--cell: #b91c1c;">R · Risk</li>
      </ul>
    </div>
    <div class="anim-stack__arrow" aria-hidden="true">↓</div>
    <div class="anim-stack__phase" style="--phase-a: #b45309; --phase-b: #92400e;">
      <p class="anim-stack__label">Resolution &amp; Documentation</p>
      <ul class="anim-stack__cells">
        <li style="--cell: #4338ca;">E · Escalation</li>
        <li style="--cell: #0e7490;">D · Documentation</li>
      </ul>
    </div>
    <p class="anim-stack__loop">↻ Feedback loop, refine scope, re-uncover, re-validate</p>
  </div>
</figure>

<style>
  .anim-diagram {
    margin: 2rem auto;
    padding: 1.75rem;
    border-radius: 1rem;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.2);
    backdrop-filter: blur(8px);
    max-width: 920px;
  }

  .anim-diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Mobile stacked variant (hidden on wide screens, swapped in below 640px) */
  .anim-stack {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
  }

  .anim-stack__phase {
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 0.75rem;
    background: rgba(15, 23, 42, 0.5);
    overflow: hidden;
  }

  .anim-stack__label {
    margin: 0;
    padding: 0.6rem 0.85rem;
    background: linear-gradient(135deg, var(--phase-a), var(--phase-b));
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .anim-stack__cells {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0.65rem 0.85rem;
  }

  .anim-stack__cells li {
    background: var(--cell);
    color: #fff;
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.45rem 0.7rem;
    border-radius: 0.5rem;
  }

  .anim-stack__arrow {
    text-align: center;
    color: #cbd5e1;
    font-size: 1.1rem;
    line-height: 1;
  }

  .anim-stack__loop {
    margin: 0.35rem 0 0;
    text-align: center;
    color: #5eead4;
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .anim-diagram {
      padding: 1rem;
    }
    .anim-diagram svg {
      display: none;
    }
    .anim-stack {
      display: flex;
    }
  }

  .anim-label {
    font-family: var(--font-sans, system-ui), sans-serif;
    font-size: 16px;
    font-weight: 700;
    fill: white;
  }

  .anim-cell {
    font-family: var(--font-sans, system-ui), sans-serif;
    font-size: 15px;
    font-weight: 700;
    fill: white;
  }

  .anim-feedback-text {
    font-family: var(--font-sans, system-ui), sans-serif;
    font-size: 13px;
    fill: #5eead4;
    font-weight: 500;
  }

  /* Pre-animation state */
  .anim-item {
    opacity: 0;
    transform: translateY(14px) scale(0.95);
    transform-origin: center;
    transition: opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: var(--delay, 0ms);
  }

  .anim-arrow-h,
  .anim-line {
    opacity: 0;
    transition: opacity 0.4s ease;
    transition-delay: var(--delay, 0ms);
  }

  .anim-feedback-path {
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    opacity: 1;
    transition: stroke-dashoffset 1s ease;
    transition-delay: var(--delay, 0ms);
  }

  .anim-feedback-text {
    opacity: 0;
    transition: opacity 0.5s ease;
    transition-delay: var(--delay, 0ms);
  }

  /* Once .is-revealed is applied, run animations */
  .anim-diagram.is-revealed .anim-item {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .anim-diagram.is-revealed .anim-arrow-h,
  .anim-diagram.is-revealed .anim-line {
    opacity: 1;
  }

  .anim-diagram.is-revealed .anim-feedback-path {
    stroke-dashoffset: 0;
  }

  .anim-diagram.is-revealed .anim-feedback-text {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .anim-item,
    .anim-arrow-h,
    .anim-line,
    .anim-feedback-text {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .anim-feedback-path {
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  /*
   * ClientRouter idempotency: a new IntersectionObserver per page-load is fine
   * (the old one is GC'd when the page swaps), but we need to actually re-run
   * after each view transition so the diagram reveals on the new page.
   * Per-element marker prevents re-observing the same diagram twice.
   */
  function bindAnimDiagrams() {
    const diagrams = document.querySelectorAll<HTMLElement>(
      "[data-anim-diagram]:not([data-anim-bound])"
    );
    if (!diagrams.length) return;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    diagrams.forEach((d) => {
      d.setAttribute("data-anim-bound", "true");
      observer.observe(d);
    });
  }
  bindAnimDiagrams();
  document.addEventListener("astro:page-load", bindAnimDiagrams);
</script>
