---
/**
 * AnimatedPhaseDiagram. The three-stage methodology flowchart with a
 * scroll-triggered reveal. Stage bands fade up first, then each phase
 * piece slides into place, then the connecting arrows draw in, then the
 * dashed feedback loop draws in last. A red escalation-tripwire bus above
 * the cells shows the early exit: a confirmed criterion leaves any Orient
 * or Investigate phase straight for the Escalation decision.
 *
 * Stage and phase names come from src/data/navigation.ts. The stage bands
 * are neutral (slate), so the only colors in the diagram are the seven
 * phase colors and the teal loop.
 *
 * Uses an IntersectionObserver to trigger animation when the diagram enters
 * the viewport. Respects prefers-reduced-motion.
 */
import { phases, type StageName } from "@/data/navigation";

const stages: StageName[] = ["Orient", "Investigate", "Resolve"];

/* AA-dark phase variants (--assured-phase-*-deep in assured.css), hardcoded
   because SVG fill attributes can't read CSS custom properties. White cell
   text clears 4.5:1 on each. */
const DEEP: Record<string, string> = {
  alert: "#1d4ed8",
  subject: "#15803d",
  scope: "#7e22ce",
  uncover: "#c2410c",
  risk: "#b91c1c",
  escalation: "#4338ca",
  documentation: "#0e7490",
};

/* Geometry (viewBox units). Each stage band is 240 wide; its phase cells
   sit under it in one row, so the arrows run left to right in phase order.
   Gaps between cells are at least 16 units, so an 8-unit arrowhead never
   overlaps a cell. */
const STAGE_X = [20, 290, 560];
const STAGE_W = 240;
/* CELL_Y leaves a band between the stage headers and the cells for the
   escalation-tripwire bus (TRIP_Y) and its label. */
const CELL_Y = 130;
const TRIP_Y = 110;
const VIEW_H = 300;
const CELL_H = 70;
const cellsFor = (stageIndex: number, count: number) => {
  const gap = count === 3 ? 21 : 20;
  const w = (STAGE_W - gap * (count - 1)) / count;
  return Array.from({ length: count }, (_, i) => ({
    x: STAGE_X[stageIndex] + i * (w + gap),
    w,
  }));
};

const cells = stages.flatMap((stage, si) => {
  const inStage = phases.filter((p) => p.stage === stage);
  const boxes = cellsFor(si, inStage.length);
  return inStage.map((p, i) => ({
    ...p,
    ...boxes[i],
    cx: boxes[i].x + boxes[i].w / 2,
    /* Long names wrap one word per line. */
    lines:
      p.name.length > 13 && p.name.includes(" ") ? p.name.split(" ") : [p.name],
  }));
});

/* Arrows between consecutive cells, 2 units off each edge. */
const arrows = cells.slice(0, -1).map((c, i) => {
  const next = cells[i + 1];
  return { x1: c.x + c.w + 2, x2: next.x - 2, delay: 900 + i * 90 };
});

const cellOf = (key: string) => {
  const cell = cells.find((c) => c.phase === key);
  if (!cell)
    throw new Error(`AnimatedPhaseDiagram: no cell for phase "${key}"`);
  return cell;
};
const risk = cellOf("risk");
const scope = cellOf("scope");
const loopBottom = CELL_Y + CELL_H + 52;
const loopMid = (risk.cx + scope.cx) / 2;
const loopPath = `M ${risk.cx} ${CELL_Y + CELL_H + 2} Q ${risk.cx} ${loopBottom} ${loopMid} ${loopBottom} Q ${scope.cx} ${loopBottom} ${scope.cx} ${CELL_Y + CELL_H + 4}`;
const LOOP_LABEL = "Feedback loop: refine scope, re-uncover, re-validate";

/* Escalation tripwire: a stub up from each Orient and Investigate cell to a
   bus, which drops into the Escalation decision cell. */
const escalation = cellOf("escalation");
const tripSources = cells.filter(
  (c) => c.stage === "Orient" || c.stage === "Investigate",
);
const tripStubs = tripSources.map((c) => c.cx);
const tripBusX1 = tripStubs[0];
const TRIP_LABEL =
  "Escalation tripwire: a confirmed criterion exits from any phase";

const stageMembers = (stage: StageName) =>
  phases.filter((p) => p.stage === stage);
const letters = (stage: StageName) =>
  stageMembers(stage)
    .map((p) => p.letter)
    .join(", ");
const names = (stage: StageName) =>
  stageMembers(stage)
    .map((p) => p.name)
    .join(", ");
const description =
  `Three stages in order: ${stages.map((st) => `${st} (${names(st)})`).join(", then ")}. ` +
  `A dashed feedback loop runs from Risk back to Scope: refine scope, re-uncover, re-validate. ` +
  `An escalation tripwire runs from every Orient and Investigate phase straight to the Escalation decision: a confirmed criterion exits from any phase.`;
---

<figure class="anim-diagram" data-anim-diagram>
  {/* No-JS fallback: the IntersectionObserver is the only thing that adds
      .is-revealed, and the pre-animation state is opacity 0, so a no-JS
      desktop reader would get an empty framed box. Force the final frame
      (the same end-state the reduced-motion block uses). These styles never
      apply once scripts run, so the JS reveal animation is unchanged. */}
  <noscript>
    <style is:inline>
      .anim-diagram .anim-item,
      .anim-diagram .anim-arrow-h,
      .anim-diagram .anim-line,
      .anim-diagram .anim-feedback-text {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      .anim-diagram .anim-feedback-reveal {
        stroke-dashoffset: 0 !important;
      }
    </style>
  </noscript>
  <svg viewBox={`0 0 820 ${VIEW_H}`} xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="anim-diagram-title anim-diagram-desc">
    <title id="anim-diagram-title">ASSURED: seven phases in three stages</title>
    <desc id="anim-diagram-desc">{description}</desc>

    <defs>
      {/* userSpaceOnUse keeps the head 8 units long whatever the stroke
          width, so it fits the gaps between cells. refX 10 puts the tip on
          the path's end point. */}
      <marker id="anim-arrow" viewBox="0 0 10 10" refX="10" refY="5" markerUnits="userSpaceOnUse" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#cbd5e1"/>
      </marker>
      <marker id="anim-arrow-loop" viewBox="0 0 10 10" refX="10" refY="5" markerUnits="userSpaceOnUse" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#14b8a6"/>
      </marker>
      <marker id="anim-arrow-trip" viewBox="0 0 10 10" refX="10" refY="5" markerUnits="userSpaceOnUse" markerWidth="9" markerHeight="9" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#f87171"/>
      </marker>
      {/* The loop is dashed. Animating its own stroke-dasharray would
          replace the dash pattern, so a solid stroke in this mask draws in
          instead and reveals the dashed path underneath. */}
      <mask id="anim-loop-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="820" height={VIEW_H}>
        <path class="anim-feedback-reveal" d={loopPath} stroke="white" stroke-width="16" fill="none" style="--delay: 1600ms;"/>
      </mask>
    </defs>

    <!-- Stage bands: neutral, so they do not compete with the phase colors -->
    <g class="anim-row" data-reveal="stage-headers">
      {stages.map((stage, i) => (
        <g class="anim-item" style={`--delay: ${i * 220}ms;`}>
          <rect x={STAGE_X[i]} y="20" width={STAGE_W} height="50" rx="12" class="anim-stage"/>
          <text x={STAGE_X[i] + STAGE_W / 2} y="51" text-anchor="middle" class="anim-label">{`${stage} (${letters(stage)})`}</text>
        </g>
      ))}
      <path class="anim-arrow-h" style="--delay: 280ms;" d={`M ${STAGE_X[0] + STAGE_W + 2} 45 L ${STAGE_X[1] - 2} 45`} stroke="#cbd5e1" stroke-width="2" marker-end="url(#anim-arrow)"/>
      <path class="anim-arrow-h" style="--delay: 480ms;" d={`M ${STAGE_X[1] + STAGE_W + 2} 45 L ${STAGE_X[2] - 2} 45`} stroke="#cbd5e1" stroke-width="2" marker-end="url(#anim-arrow)"/>
    </g>

    <!-- Phase cells, in order, under their stage -->
    <g class="anim-components">
      {cells.map((c, i) => (
        <g class="anim-item" style={`--delay: ${620 + i * 100}ms;`}>
          <rect x={c.x} y={CELL_Y} width={c.w} height={CELL_H} rx="10" fill={DEEP[c.phase]}/>
          <text x={c.cx} y={CELL_Y + 26} text-anchor="middle" class="anim-cell-letter" aria-hidden="true">{c.letter}</text>
          <text x={c.cx} y={c.lines.length > 1 ? CELL_Y + 45 : CELL_Y + 50} text-anchor="middle" class="anim-cell" aria-hidden="true">
            {c.lines.map((line, j) => <tspan x={c.cx} dy={j === 0 ? 0 : 14}>{line}</tspan>)}
          </text>
        </g>
      ))}
      {arrows.map((a) => (
        <path class="anim-line" style={`--delay: ${a.delay}ms;`} d={`M ${a.x1} ${CELL_Y + CELL_H / 2} L ${a.x2} ${CELL_Y + CELL_H / 2}`} stroke="#94a3b8" stroke-width="2" marker-end="url(#anim-arrow)"/>
      ))}
    </g>

    <!-- Escalation tripwire: early exit from any Orient/Investigate phase -->
    <g class="anim-tripwire" data-tripwire>
      {tripStubs.map((x, i) => (
        <path class="anim-line anim-trip-line" style={`--delay: ${1300 + i * 60}ms;`} d={`M ${x} ${CELL_Y - 2} L ${x} ${TRIP_Y}`}/>
      ))}
      <path class="anim-line anim-trip-line" style="--delay: 1600ms;" d={`M ${tripBusX1} ${TRIP_Y} L ${escalation.cx} ${TRIP_Y} L ${escalation.cx} ${CELL_Y - 2}`} marker-end="url(#anim-arrow-trip)"/>
      <text class="anim-feedback-text anim-trip-text" style="--delay: 1800ms;" x={(tripBusX1 + escalation.cx) / 2} y={TRIP_Y - 7} text-anchor="middle" aria-hidden="true">{TRIP_LABEL}</text>
    </g>

    <!-- Feedback loop: Risk back to Scope -->
    <g class="anim-loop" data-feedback>
      <path class="anim-feedback-path" d={loopPath} stroke="#14b8a6" stroke-width="2" stroke-dasharray="6 6" fill="none" marker-end="url(#anim-arrow-loop)" mask="url(#anim-loop-mask)"/>
      <text class="anim-feedback-text" style="--delay: 1900ms;" x={loopMid} y={loopBottom + 22} text-anchor="middle" aria-hidden="true">{`↻ ${LOOP_LABEL}`}</text>
    </g>
  </svg>

  <!-- Stacked rendering for small screens. The fixed-viewBox SVG scales
       uniformly, which turns its labels into ~6px text at 375px wide. Below
       640px the SVG hides and this legible vertical flow shows instead;
       display:none keeps the hidden variant out of the accessibility tree,
       so screen readers only encounter one rendering. The loop sits after
       Investigate, where it starts. -->
  <div class="anim-stack">
    {stages.map((stage, i) => (
      <>
        {i > 0 && <div class="anim-stack__arrow" aria-hidden="true">↓</div>}
        <div class="anim-stack__phase">
          <p class="anim-stack__label">{`${stage} (${letters(stage)})`}</p>
          <ul class="anim-stack__cells">
            {stageMembers(stage).map((p) => (
              <li style={`--cell: ${DEEP[p.phase]};`}>{`${p.letter} · ${p.name}`}</li>
            ))}
          </ul>
        </div>
        {stage === "Investigate" && (
          <>
            <p class="anim-stack__loop"><span aria-hidden="true">↻ </span>{`${LOOP_LABEL}. The loop runs from Risk back to Scope.`}</p>
            <p class="anim-stack__trip"><span aria-hidden="true">⇥ </span>{`${TRIP_LABEL}, straight to the Escalation decision.`}</p>
          </>
        )}
      </>
    ))}
  </div>
</figure>

<style>
  .anim-diagram {
    margin: 2rem auto;
    padding: 1.75rem;
    border-radius: 1rem;
    background: var(--assured-panel-solid);
    border: 1px solid rgba(148, 163, 184, 0.2);
    max-width: 920px;
  }

  .anim-diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Mobile stacked variant (hidden on wide screens, swapped in below 640px) */
  .anim-stack {
    display: none;
    flex-direction: column;
    gap: 0.5rem;
  }

  .anim-stack__phase {
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 0.75rem;
    background: rgba(15, 23, 42, 0.5);
    overflow: hidden;
  }

  .anim-stack__label {
    margin: 0;
    padding: 0.6rem 0.85rem;
    background: #1e293b;
    border-bottom: 1px solid rgba(148, 163, 184, 0.3);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .anim-stack__cells {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0.65rem 0.85rem;
  }

  .anim-stack__cells li {
    background: var(--cell);
    color: #fff;
    font-weight: 700;
    font-size: 0.82rem;
    padding: 0.45rem 0.7rem;
    border-radius: 0.5rem;
  }

  .anim-stack__arrow {
    text-align: center;
    color: var(--assured-text-muted);
    font-size: 1.1rem;
    line-height: 1;
  }

  .anim-stack__loop {
    margin: 0.35rem 0;
    padding: 0.4rem 0.6rem;
    border: 1px dashed #14b8a6;
    border-radius: 0.5rem;
    text-align: center;
    color: var(--assured-accent-soft);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .anim-stack__trip {
    margin: 0.35rem 0;
    padding: 0.4rem 0.6rem;
    border: 1px dashed #f87171;
    border-radius: 0.5rem;
    text-align: center;
    color: var(--assured-danger-soft);
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .anim-diagram {
      padding: 1rem;
    }
    .anim-diagram svg {
      display: none;
    }
    .anim-stack {
      display: flex;
    }
  }

  .anim-stage {
    fill: #1e293b;
    stroke: rgba(148, 163, 184, 0.45);
    stroke-width: 1;
  }

  .anim-cell-letter {
    font-family: var(--font-sans, system-ui), sans-serif;
    font-size: 18px;
    font-weight: 800;
    fill: white;
  }

  .anim-label {
    font-family: var(--font-sans, system-ui), sans-serif;
    font-size: 16px;
    font-weight: 700;
    fill: white;
  }

  .anim-cell {
    font-family: var(--font-sans, system-ui), sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    fill: white;
  }

  .anim-feedback-text {
    font-family: var(--font-sans, system-ui), sans-serif;
    font-size: 13px;
    fill: var(--assured-accent-soft);
    font-weight: 500;
  }

  .anim-trip-line {
    fill: none;
    stroke: #f87171;
    stroke-width: 2;
    stroke-dasharray: 3 4;
  }

  .anim-trip-text {
    font-size: 12px;
    fill: var(--assured-danger-soft);
  }

  /* Pre-animation state */
  .anim-item {
    opacity: 0;
    transform: translateY(14px) scale(0.95);
    transform-origin: center;
    transition: opacity 0.5s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition-delay: var(--delay, 0ms);
  }

  .anim-arrow-h,
  .anim-line {
    opacity: 0;
    transition: opacity 0.4s ease;
    transition-delay: var(--delay, 0ms);
  }

  /* The mask stroke, not the visible dashed path, carries the draw-in. */
  .anim-feedback-reveal {
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    transition: stroke-dashoffset 1s ease;
    transition-delay: var(--delay, 0ms);
  }

  .anim-feedback-text {
    opacity: 0;
    transition: opacity 0.5s ease;
    transition-delay: var(--delay, 0ms);
  }

  /* Once .is-revealed is applied, run animations */
  .anim-diagram.is-revealed .anim-item {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .anim-diagram.is-revealed .anim-arrow-h,
  .anim-diagram.is-revealed .anim-line {
    opacity: 1;
  }

  .anim-diagram.is-revealed .anim-feedback-reveal {
    stroke-dashoffset: 0;
  }

  .anim-diagram.is-revealed .anim-feedback-text {
    opacity: 1;
  }

  /* print.css prints the final frame of the cells and arrows; the loop's
     draw-in lives on the mask stroke, so finish it here too. */
  @media print {
    .anim-feedback-reveal {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .anim-item,
    .anim-arrow-h,
    .anim-line,
    .anim-feedback-text {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .anim-feedback-reveal {
      stroke-dashoffset: 0;
      transition: none;
    }
  }
</style>

<script>
  import { onPageReady } from "@/lib/dom";

  /*
   * ClientRouter idempotency: a new IntersectionObserver per page-load is fine
   * (the old one is GC'd when the page swaps), but we need to actually re-run
   * after each view transition so the diagram reveals on the new page.
   * Per-element marker prevents re-observing the same diagram twice.
   */
  function bindAnimDiagrams() {
    const diagrams = document.querySelectorAll<HTMLElement>(
      "[data-anim-diagram]:not([data-anim-bound])"
    );
    if (!diagrams.length) return;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-revealed");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );
    diagrams.forEach((d) => {
      d.setAttribute("data-anim-bound", "true");
      observer.observe(d);
    });
  }
  onPageReady(bindAnimDiagrams);
</script>
