---
/**
 * ChapterCard, used on the home page and intro to summarize one phase.
 *
 * Marks chapters as live or "coming soon" so the navigation matches reality.
 */

import { stableId } from "@/lib/stable-id";

interface Props {
  letter: string;
  phase:
    | "alert"
    | "subject"
    | "scope"
    | "uncover"
    | "risk"
    | "escalation"
    | "documentation";
  title: string;
  description: string;
  href?: string;
  status?: "live" | "soon";
  topics?: string[];
}

const {
  letter,
  phase,
  title,
  description,
  href,
  status = "live",
  topics = [],
} = Astro.props;

const isLinked = status === "live" && !!href;
const titleId = stableId("chapter-card", Astro.url.pathname);
// The card's link lives on the visible "Read chapter" CTA and stretches over
// the whole card via ::after, so every pixel stays clickable. Its accessible
// name chains the h3 title and the link's own text (aria-labelledby), which
// keeps announcements concise — no description or topic-chip readout — while
// containing the visible "Read chapter" label voice-control users speak
// (WCAG 2.5.3 Label in Name). The previous whole-card <a> named only by the
// title tripped label-content-name-mismatch, because the description and
// topics remained visible link text excluded from the name.
const ctaId = `${titleId}-cta`;
---

<div class={`chapter-card chapter-card--${phase} chapter-card--${status}`}>
  <div class="chapter-card__head">
    <span class={`assured-letter assured-letter--${phase}`} aria-hidden="true">{letter}</span>
    <div class="chapter-card__title-wrap">
      <h3 class="chapter-card__title" id={titleId}>{title}</h3>
      {status === "soon" && (
        <span class="assured-soon" aria-label="Coming soon">
          <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          Coming soon
        </span>
      )}
    </div>
  </div>

  <p class="chapter-card__desc">{description}</p>

  {topics.length > 0 && (
    <ul class="chapter-card__topics">
      {topics.map((t) => <li>{t}</li>)}
    </ul>
  )}

  {isLinked && (
    <a href={href} class="chapter-card__cta" id={ctaId} aria-labelledby={`${titleId} ${ctaId}`}>
      Read chapter
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"></path>
        <path d="M13 5l7 7-7 7"></path>
      </svg>
    </a>
  )}
</div>

<style>
  .chapter-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.5rem;
    border-radius: 0.85rem;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: var(--assured-text);
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .chapter-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--accent, transparent) 0%, transparent 60%);
    opacity: 0.08;
    z-index: -1;
    transition: opacity 0.25s ease;
  }

  .chapter-card--live:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 18px 40px -16px rgba(0, 0, 0, 0.5), 0 0 0 1px var(--accent);
    background: rgba(15, 23, 42, 0.7);
  }

  .chapter-card--live:hover::before { opacity: 0.18; }

  .chapter-card--soon {
    opacity: 0.85;
  }

  .chapter-card--alert         { --accent: var(--assured-phase-alert); }
  .chapter-card--subject       { --accent: var(--assured-phase-subject); }
  .chapter-card--scope         { --accent: var(--assured-phase-scope); }
  .chapter-card--uncover       { --accent: var(--assured-phase-uncover); }
  .chapter-card--risk          { --accent: var(--assured-phase-risk); }
  .chapter-card--escalation    { --accent: var(--assured-phase-escalation); }
  .chapter-card--documentation { --accent: var(--assured-phase-documentation); }

  .chapter-card__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .chapter-card__title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .chapter-card__title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--assured-text);
  }

  .chapter-card__desc {
    margin: 0;
    color: var(--assured-text-muted);
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .chapter-card__topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .chapter-card__topics li {
    padding-left: 1.1rem;
    position: relative;
    color: var(--assured-text-dim);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .chapter-card__topics li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: var(--accent);
    opacity: 0.7;
  }

  .chapter-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.4rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }

  /* Stretched link: the CTA anchor's ::after covers the card (the card is
     position:relative), preserving the old whole-card <a>'s click target
     while only the title + CTA form the link's accessible name. */
  .chapter-card__cta::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  /* Keyboard focus ring wraps the whole card, where the old whole-card
     link's UA ring sat. Browsers without :has() keep the CTA's own UA
     focus ring instead (neither rule applies). */
  .chapter-card:has(.chapter-card__cta:focus-visible) {
    outline: 2px solid var(--accent, var(--assured-accent-soft));
    outline-offset: 2px;
  }

  .chapter-card:has(.chapter-card__cta:focus-visible) .chapter-card__cta {
    outline: none;
  }

  .chapter-card--live:hover .chapter-card__cta svg {
    transform: translateX(2px);
  }

  .chapter-card__cta svg {
    transition: transform 0.2s ease;
  }
</style>
