---
/**
 * ChapterExample. Framing shell for the walkthrough that ties the concepts
 * of a whole chapter together: badge, title, and scenario line around a
 * slot. The step-through tabs come from the ExampleStepper nested inside,
 * not from this component.
 *
 * Designed to live at the end of every chapter as the capstone.
 *
 * Each example page introduces a case with its own h2 ("Case A · ..."), so
 * the title here is an h3 by default and nests under it in the outline.
 * Pass `level={2}` only where the component is not under a case heading.
 */

interface Props {
  title?: string;
  scenario?: string;
  /** Heading level for the title. Default 3. */
  level?: 2 | 3 | 4;
}

const {
  title = "Working example: from alert to handoff",
  scenario,
  level = 3,
} = Astro.props;
const Heading = `h${level}` as "h2" | "h3" | "h4";
---

<section class="chapter-example" data-chapter-example>
  <header class="chapter-example__head">
    <span class="chapter-example__badge">Working example</span>
    <Heading class="chapter-example__title">{title}</Heading>
    {scenario && <p class="chapter-example__scenario">{scenario}</p>}
  </header>

  <slot />
</section>

<style>
  .chapter-example {
    margin: 3rem 0 2rem;
    padding: 2rem;
    border-radius: 1.25rem;
    /* The shared worked-example hue (the stepper, Reveal and CaseStudy use
       it too), so a worked example reads the same in every chapter rather
       than borrowing Scope's purple. */
    background: linear-gradient(
      135deg,
      rgba(var(--assured-example-rgb), 0.08),
      rgba(15, 23, 42, 0.82)
    );
    border: 1px solid rgba(var(--assured-example-rgb), 0.3);
  }

  @media (max-width: 640px) {
    .chapter-example {
      padding: 1.25rem 1rem;
    }
  }

  .chapter-example__head {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .chapter-example__badge {
    display: inline-block;
    padding: 0.25rem 0.85rem;
    border-radius: 9999px;
    background: rgba(var(--assured-example-rgb), 0.2);
    color: var(--assured-example-soft);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }

  .chapter-example__title {
    margin: 0 auto 0.75rem;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    color: var(--assured-text);
    line-height: 1.2;
    max-width: 32ch;
  }

  .chapter-example__scenario {
    margin: 0 auto;
    color: var(--assured-text-soft);
    font-style: italic;
    line-height: 1.6;
    max-width: 60ch;
    font-size: 0.95rem;
  }
</style>
