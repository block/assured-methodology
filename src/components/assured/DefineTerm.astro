---
/**
 * DefineTerm. Inline glossary tooltip.
 *
 * Wraps a term in a quiet dotted underline (body-text color: teal stays
 * reserved for links). Hover, keyboard focus, or a click or tap reveals a
 * small panel with the definition; Esc dismisses it. The inline text is
 * always `display ?? term`. Slot children never render inline; they replace
 * the definition body.
 *
 * First occurrence per page: only the first in-flow use of a term on a
 * page stays a tooltip; later uses of the same term render as plain text
 * (done in the browser, in document order, before the triggers bind). Uses
 * inside collapsible or hidden-until-chosen content (Reveal and other
 * <details>, stepper steps, flip-card backs, quiz items, another tooltip)
 * always keep their tooltip and do not count as the first, since a reader
 * may meet them on their own. Pass `always` to keep a specific use. Without
 * JavaScript every use keeps its tooltip.
 *
 * Definition body, first match wins:
 *
 *   1. Slot children, for a one-off definition (markup allowed):
 *
 *        <DefineTerm term="high value">An account or system that, if
 *        compromised, gives the adversary outsized impact.</DefineTerm>
 *
 *   2. `definition` prop, a plain string:
 *
 *        <DefineTerm term="PFI" definition="A PCI SSC-qualified forensic company..." />
 *
 *   3. Auto-lookup (preferred): `term` resolved against src/data/glossary.ts
 *      via lookupTerm, which is case-, hyphen-, and plural-insensitive. The
 *      panel title uses the registry's canonical casing.
 *
 *        <DefineTerm term="Lateral Movement" />
 *        <DefineTerm term="Lateral Movement" display="lateral movement" />
 *
 *   `display` changes only the inline text, so the prose can say
 *   "lateral movement" while the registry key stays "Lateral Movement".
 */

import { lookupTerm } from "@/data/glossary";
import { stableId } from "@/lib/stable-id";

interface Props {
  /** The term name. Used as the lookup key and (by default) the displayed text. */
  term: string;
  /** Optional text to render in place of `term`. Useful when the prose uses a
   *  different case/inflection than the glossary entry (e.g. "alerts" vs "Alert"). */
  display?: string;
  /** Optional explicit definition. If absent, looked up from src/data/glossary.ts. */
  definition?: string;
  /** Keep this use as a tooltip even if the term already appeared above. */
  always?: boolean;
}

const { term, display, definition, always = false } = Astro.props;
const hasExplicitBody = Astro.slots.has("default");
const lookup = lookupTerm(term);
const resolvedDefinition =
  definition ?? (hasExplicitBody ? null : (lookup?.definition ?? null));
// An alias record (another vendor's name for a B.A.D. actor) titles the
// panel "Cozy Bear (APT29)"; a retired key that merely extends the
// canonical name shows the canonical name alone.
const canonical = lookup?.aliasOf;
const resolvedTitle = lookup
  ? canonical && !lookup.term.startsWith(canonical)
    ? `${lookup.term} (${canonical})`
    : (canonical ?? lookup.term)
  : term;
const methodTerm = lookup?.methodTerm === true;
const displayText = display ?? term;
const panelId = stableId("defterm", Astro.url.pathname);
const termKey = resolvedTitle.trim().toLowerCase();

// No aria-haspopup: the panel is a tooltip, not a menu/dialog, and haspopup
// makes screen readers announce a popup that never opens as one. The trigger
// is linked to the panel with aria-describedby instead, so the definition is
// read as the button's description.
//
// data-pagefind-ignore on the panel: the definition is glossary text, not
// this page's content. Indexing it made every page that uses a term match
// searches for that term's definition. The glossary pages index the terms.
//
// The trigger is a span with role="button", not a <button>: a button is an
// atomic inline box, so a multi-word term could never wrap at a line end and
// pushed whole phrases onto the next line. The script gives the span the
// button keyboard contract (Enter and Space activate).
//
// This comment lives in the frontmatter on purpose: the template must start
// directly with the wrapper <span>. Astro 7's compiler keeps the whitespace
// after a leading {/* */} expression as a text node, which renders as a stray
// space before every inline term ("( Okta", "threat- intelligence").
---
<span class="define-term" data-term-key={termKey} data-term-always={always ? "" : undefined}>
  <span class="define-term__trigger" role="button" tabindex="0" aria-expanded="false" aria-describedby={panelId}>{displayText}</span>
  <span class="define-term__panel" role="tooltip" id={panelId} data-pagefind-ignore>
    <strong class="define-term__title">{resolvedTitle}{methodTerm && <span class="define-term__tag">ASSURED term</span>}</strong>
    {hasExplicitBody ? <slot /> : resolvedDefinition ? <span>{resolvedDefinition}</span> : <span>(definition missing)</span>}
  </span>
</span>

<style>
  /* Inline, not inline-block, so a multi-word term wraps like the text
     around it; position: relative still anchors the panel. */
  .define-term {
    position: relative;
    display: inline;
  }

  /* Quiet by design: dense pages carry dozens of terms, and a teal trigger
     with a "?" icon read the same as a link. The term keeps the surrounding
     text color with a dotted slate underline; hover and focus firm the
     underline up. */
  .define-term__trigger {
    display: inline;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    text-align: inherit;
    cursor: help;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: rgba(148, 163, 184, 0.75);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .define-term__trigger:hover,
  .define-term__trigger:focus-visible,
  .define-term__trigger[aria-expanded="true"] {
    color: var(--assured-text);
    text-decoration-color: var(--assured-accent-soft);
  }

  /* Keyboard users need a visible focus indicator (WCAG 2.4.7); the color
     shift alone fails for low-vision users. */
  .define-term__trigger:focus-visible {
    outline: 2px solid rgba(94, 234, 212, 0.7);
    outline-offset: 2px;
    border-radius: 0.2rem;
  }

  /*
   * Tooltip horizontal positioning uses a JS-driven `--shift` variable so the
   * panel can slide left/right when it would otherwise extend past the viewport
   * (e.g. when the trigger is near the left or right edge of the screen).
   * The arrow shifts in the OPPOSITE direction so it still points at the trigger.
   *
   * Closed panels use display:none, not visibility:hidden. A visibility:hidden
   * box still contributes to the document's scrollable overflow, so dozens of
   * closed tooltips centered near the text edge widen document.scrollWidth and
   * let the whole page pan sideways on mobile. The reveal is a keyframes
   * animation, not a transition: transitions out of display:none need
   * @starting-style/allow-discrete, which some engines leave stuck at
   * opacity:0 (an invisible tooltip). Keyframes fire reliably on display flip.
   */
  .define-term__panel {
    position: absolute;
    bottom: calc(100% + 0.6rem);
    left: 50%;
    transform: translateX(calc(-50% + var(--define-term-shift, 0px))) translateY(4px);
    width: max-content;
    max-width: min(22rem, calc(100vw - 1rem));
    padding: 0.85rem 1rem;
    background: rgba(15, 23, 42, 0.98);
    border: 1px solid rgba(94, 234, 212, 0.4);
    border-radius: 0.6rem;
    color: var(--assured-text-soft);
    font-size: 0.85rem;
    line-height: 1.55;
    font-weight: 400;
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.55);
    display: none;
    z-index: 20;
    text-align: left;
    white-space: normal;
  }

  .define-term__panel::after {
    content: "";
    position: absolute;
    top: 100%;
    /* Arrow stays anchored to the trigger center, even after the panel shifts. */
    left: calc(50% - var(--define-term-shift, 0px));
    margin-left: -6px;
    border: 6px solid transparent;
    border-top-color: rgba(94, 234, 212, 0.4);
  }

  /* Invisible hover bridge across the 0.6rem gap between panel and trigger,
     so the pointer can travel onto the panel without it closing
     (WCAG 1.4.13 hoverable). */
  .define-term__panel::before {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 0.7rem;
  }

  .define-term__title {
    display: block;
    color: var(--assured-accent-soft);
    font-weight: 700;
    margin-bottom: 0.25rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Marks a term ASSURED coined or uses in its own sense. */
  .define-term__tag {
    margin-left: 0.5rem;
    padding: 0.05rem 0.4rem;
    border: 1px solid rgba(94, 234, 212, 0.4);
    border-radius: 9999px;
    color: var(--assured-text-soft);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* :hover on the wrapper (not just the trigger) keeps the panel open while
     the pointer is over the panel itself (WCAG 1.4.13 hoverable). */
  .define-term:hover .define-term__panel,
  .define-term__trigger:focus-visible + .define-term__panel,
  .define-term__trigger[aria-expanded="true"] + .define-term__panel {
    display: block;
    /* Must keep --define-term-shift here: the JS edge-avoidance sets it on
       reveal, and dropping it from the visible state snaps the panel back to
       centered, clipping at viewport edges and panning the page on mobile. */
    transform: translateX(calc(-50% + var(--define-term-shift, 0px))) translateY(0);
    animation: define-term-in 0.15s ease;
  }

  /* Esc dismisses hover/focus-revealed panels without moving pointer or focus
     (WCAG 1.4.13 dismissable). The script clears the class on mouseleave/blur
     so the next reveal works. Must come after the reveal rule: equal
     specificity, so source order decides. */
  .define-term.is-dismissed .define-term__panel {
    display: none;
  }

  @keyframes define-term-in {
    from {
      opacity: 0;
      transform: translateX(calc(-50% + var(--define-term-shift, 0px))) translateY(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .define-term__trigger {
      transition: none;
    }
    .define-term:hover .define-term__panel,
    .define-term__trigger:focus-visible + .define-term__panel,
    .define-term__trigger[aria-expanded="true"] + .define-term__panel {
      animation: none;
    }
  }
</style>

<script>
  import { onPageReady } from "@/lib/dom";

  /*
   * ClientRouter idempotency:
   *   - Trigger click handlers use per-element data-defterm-bound marker.
   *   - Document-level click + Escape handlers register once via window.__defineTermDocBound.
   *   - Closing logic re-queries triggers live so new triggers from view transitions
   *     are included.
   */
  /*
   * Reposition the tooltip away from viewport edges. Called on every reveal
   * event (hover, focus, click) so the panel always renders within the screen,
   * regardless of where the trigger is.
   */
  function adjustPanelShift(trigger: HTMLElement) {
    const wrapper = trigger.parentElement;
    if (!wrapper) return;
    const panel = wrapper.querySelector<HTMLElement>(".define-term__panel");
    if (!panel) return;

    // Reset before measuring so existing shifts don't compound.
    wrapper.style.setProperty("--define-term-shift", "0px");

    const triggerRect = trigger.getBoundingClientRect();
    const panelRect = panel.getBoundingClientRect();
    // Panel can be display:none here (e.g. the focus event of a touch tap,
    // where :focus-visible doesn't match). Width 0 means nothing to shift;
    // the click handler re-runs this once aria-expanded makes it visible.
    if (panelRect.width === 0) return;
    // clientWidth, not window.innerWidth: innerWidth includes the scrollbar,
    // so a right-edge panel would be shifted under it instead of into view.
    const viewportWidth = document.documentElement.clientWidth;
    const margin = 8;
    const triggerCenter = triggerRect.left + triggerRect.width / 2;
    const halfWidth = panelRect.width / 2;
    const wouldOverflowLeft = triggerCenter - halfWidth < margin;
    const wouldOverflowRight = triggerCenter + halfWidth > viewportWidth - margin;

    let shift = 0;
    if (wouldOverflowLeft) {
      shift = margin - (triggerCenter - halfWidth);
    } else if (wouldOverflowRight) {
      shift = viewportWidth - margin - (triggerCenter + halfWidth);
    }
    wrapper.style.setProperty("--define-term-shift", `${shift}px`);
  }

  // Uses inside these containers keep their tooltip and never count as a
  // term's first occurrence: the reader may open or reach them on their own.
  const SELF_CONTAINED = [
    "details",
    "[data-step]",
    ".flip-card__face--back",
    ".quiz-item",
    ".define-term__panel",
  ].join(", ");

  // First occurrence per page: later in-flow uses of a term become plain
  // text. querySelectorAll returns document order, and a term already
  // reduced is gone from the DOM, so re-running on the same page (the
  // initial run plus astro:page-load) changes nothing.
  function dedupeDefineTerms() {
    const seen = new Set<string>();
    document.querySelectorAll<HTMLElement>(".define-term[data-term-key]").forEach((wrapper) => {
      if (wrapper.parentElement?.closest(SELF_CONTAINED)) return;
      const key = wrapper.dataset.termKey ?? "";
      if (!seen.has(key)) {
        seen.add(key);
        return;
      }
      if (wrapper.hasAttribute("data-term-always")) return;
      const text = wrapper.querySelector(".define-term__trigger")?.textContent ?? "";
      wrapper.replaceWith(document.createTextNode(text));
    });
  }

  function bindDefineTerms() {
    dedupeDefineTerms();
    const triggers = document.querySelectorAll<HTMLElement>(
      ".define-term__trigger:not([data-defterm-bound])"
    );
    triggers.forEach((trigger) => {
      trigger.setAttribute("data-defterm-bound", "true");
      const wrapper = trigger.closest<HTMLElement>(".define-term");
      // The button keyboard contract for the role="button" span: Enter
      // activates on keydown, Space on keyup (and never scrolls the page).
      trigger.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          trigger.click();
        } else if (e.key === " ") {
          e.preventDefault();
        }
      });
      trigger.addEventListener("keyup", (e) => {
        if (e.key === " ") {
          e.preventDefault();
          trigger.click();
        }
      });
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        wrapper?.classList.remove("is-dismissed");
        const isOpen = trigger.getAttribute("aria-expanded") === "true";
        // Close all other open triggers on this page (live query so newly-mounted ones count).
        document
          .querySelectorAll<HTMLElement>(".define-term__trigger[aria-expanded='true']")
          .forEach((other) => {
            if (other !== trigger) other.setAttribute("aria-expanded", "false");
          });
        trigger.setAttribute("aria-expanded", isOpen ? "false" : "true");
        if (!isOpen) adjustPanelShift(trigger);
      });
      // Hover and keyboard focus also need viewport-aware positioning,
      // since the panel is reveal-on-hover via :hover/:focus-visible in CSS.
      trigger.addEventListener("mouseenter", () => adjustPanelShift(trigger));
      trigger.addEventListener("focus", () => adjustPanelShift(trigger));
      if (wrapper) {
        // Reset the Esc-dismissed state once the pointer/focus leaves, so the
        // next hover or tab-stop reveals the panel again. Focus leaving also
        // collapses a click-opened panel instead of leaving it stranded.
        wrapper.addEventListener("mouseleave", () => wrapper.classList.remove("is-dismissed"));
        wrapper.addEventListener("focusout", (e) => {
          if (!wrapper.contains(e.relatedTarget as Node)) {
            trigger.setAttribute("aria-expanded", "false");
            wrapper.classList.remove("is-dismissed");
          }
        });
      }
    });
  }

  function closeAllDefineTerms(dismissRevealed = false) {
    document
      .querySelectorAll<HTMLElement>(".define-term__trigger")
      .forEach((t) => t.setAttribute("aria-expanded", "false"));
    if (dismissRevealed) {
      // Esc must also hide panels held open purely by :hover/:focus-visible,
      // without requiring the pointer or focus to move (WCAG 1.4.13).
      document
        .querySelectorAll<HTMLElement>(".define-term:hover")
        .forEach((w) => w.classList.add("is-dismissed"));
      const active = document.activeElement;
      if (active && active.classList.contains("define-term__trigger")) {
        active.closest(".define-term")?.classList.add("is-dismissed");
      }
    }
  }

  onPageReady(bindDefineTerms);

  // Document-level handlers registered once for the SPA session.
  // Without this guard, every view transition stacks another listener and Esc
  // would fire N times.
  if (!(window as any).__defineTermDocBound) {
    (window as any).__defineTermDocBound = true;
    document.addEventListener("click", (e) => {
      if (!(e.target as Element).closest(".define-term")) {
        closeAllDefineTerms();
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeAllDefineTerms(true);
    });
  }
</script>
