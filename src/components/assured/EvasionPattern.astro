  @media print {
    .evasion::details-content {
      content-visibility: visible !important;
      display: block !important;
    }
  }
</style>

<script>
  /*
   * Closed <details> content does not render for printing. Open every
   * evasion panel on beforeprint and restore the reader's state afterwards.
   * Window-level listeners bind once per browser session (processed scripts
   * run once); the panels are queried at print time, so DOM swapped in by
   * the ClientRouter is picked up without any rebinding.
   */
  const PRINT_OPENED = "data-print-opened";
  window.addEventListener("beforeprint", () => {
    document
      .querySelectorAll<HTMLDetailsElement>("details.evasion:not([open])")
      .forEach((panel) => {
        panel.setAttribute(PRINT_OPENED, "true");
        panel.open = true;
      });
  });
  window.addEventListener("afterprint", () => {
    document
      .querySelectorAll<HTMLDetailsElement>(`details.evasion[${PRINT_OPENED}]`)
      .forEach((panel) => {
        panel.removeAttribute(PRINT_OPENED);
        panel.open = false;
      });
  });
</script>
