---
/**
 * EvasionPattern. A clickable card that expands to reveal a short looping
 * SVG animation demonstrating an adversary evasion technique.
 *
 * Built on native <details>/<summary> so it works with no JavaScript and
 * remains accessible. CSS animations loop while the panel is open, and
 * `prefers-reduced-motion` shows a static end-state instead.
 *
 * Data-driven: a card needs only `pattern` (an id), `title`,
 * `description` and `caption`. Eight ids have a bespoke animation:
 * "lolbins" | "hollowing" | "timing" | "fatigue" | "identity-abuse" |
 * "rmm" | "edr-tampering" | "sensor-blinding". Any other id renders a
 * generic static visual (the card's icon over a quiet panel), so a new
 * pattern can ship before anyone draws for it. A page can also supply its
 * own SVG through the named slot: <svg slot="animation" .../>, which takes
 * precedence over both.
 *
 * `icon` is optional: each bespoke pattern has a default line icon, and
 * any other id gets the generic shield. Pass a key of `icons` below to
 * override it; any other string (legacy emoji at older call sites) renders
 * as text. Prefer the default or a named key.
 */

/** Ids with a bespoke animation in the template below. The type keeps the
 *  name Pattern: scripts/check-contrast.mjs reads this union. */
type Pattern =
  | "lolbins"
  | "hollowing"
  | "timing"
  | "fatigue"
  | "identity-abuse"
  | "rmm"
  | "edr-tampering"
  | "sensor-blinding";

interface Props {
  /** Pattern id. A bespoke id gets its animation; any other id gets the
   *  generic visual. Also used as the card's CSS modifier class. */
  pattern: Pattern | (string & {});
  icon?: string;
  title: string;
  description: string;
  caption: string;
}

const props = Astro.props;

// Lucide-style 24px stroke icons (inner markup only).
const icons: Record<string, string> = {
  wrench:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  ghost:
    '<path d="M9 10h.01"/><path d="M15 10h.01"/><path d="M12 2a8 8 0 0 0-8 8v12l3-3 2.5 2.5L12 19l2.5 2.5L17 19l3 3V10a8 8 0 0 0-8-8z"/>',
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  waves:
    '<path d="M2 6c.6.5 1.2 1 2.5 1C7 7 7 5 9.5 5c2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 12c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/><path d="M2 18c.6.5 1.2 1 2.5 1 2.5 0 2.5-2 5-2 2.6 0 2.4 2 5 2 2.5 0 2.5-2 5-2 1.3 0 1.9.5 2.5 1"/>',
  key: '<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>',
  monitor:
    '<rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/>',
  "shield-off":
    '<path d="m2 2 20 20"/><path d="M5 5a1 1 0 0 0-1 1v7c0 5 3.5 7.5 7.67 8.94a1 1 0 0 0 .67.01c2.35-.82 4.48-1.97 5.9-3.71"/><path d="M9.309 3.652A12.252 12.252 0 0 0 11.24 2.28a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1v7a9.784 9.784 0 0 1-.08 1.264"/>',
  "shield-alert":
    '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v4"/><path d="M12 16h.01"/>',
  "eye-off":
    '<path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/>',
};

const defaultIcon: Record<Pattern, string> = {
  lolbins: "wrench",
  hollowing: "ghost",
  timing: "moon",
  fatigue: "waves",
  "identity-abuse": "key",
  rmm: "monitor",
  "edr-tampering": "shield-off",
  "sensor-blinding": "eye-off",
};

const isBespoke = (id: string): id is Pattern => Object.hasOwn(defaultIcon, id);
const bespoke = isBespoke(props.pattern) ? props.pattern : null;
const hasCustomAnimation = Astro.slots.has("animation");
const iconKey = props.icon ?? (bespoke ? defaultIcon[bespoke] : "shield-alert");
const iconSvg = icons[iconKey];
// The generic visual reuses the card's icon (a named one, else the shield).
const fallbackSvg = iconSvg ?? icons["shield-alert"];
---

<details class={`evasion evasion--${props.pattern}`}>
  <summary class="evasion__summary">
    {/* Spans, not div/p: <summary> permits only phrasing (and heading)
        content; the CSS display values recreate the block layout. */}
    <span class="evasion__head">
      <span class="evasion__icon" aria-hidden="true">
        {iconSvg ? (
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={iconSvg}
          />
        ) : (
          props.icon
        )}
      </span>
      {/* A styled span, not a heading: <summary> exposes role=button, which
          strips heading semantics for AT and clutters the outline. */}
      <span class="evasion__title">{props.title}</span>
      <span class="evasion__toggle" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
        <span class="evasion__toggle-text evasion__toggle-text--closed">See how it works</span>
        <span class="evasion__toggle-text evasion__toggle-text--open">Hide</span>
      </span>
    </span>
    <span class="evasion__desc">{props.description}</span>
  </summary>

  <div class="evasion__demo">
    {hasCustomAnimation && <slot name="animation" />}

    {/* Generic visual for an id with no bespoke animation: static, so it
        needs no reduced-motion or print special case. */}
    {!hasCustomAnimation && !bespoke && (
      <svg viewBox="0 0 420 150" class="demo demo--generic" role="img" aria-label={props.title}>
        <rect x="10" y="10" width="400" height="130" rx="14" class="demo-generic__panel" />
        <g transform="translate(174 39) scale(3)" class="demo-generic__icon" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={fallbackSvg} />
      </svg>
    )}

    {!hasCustomAnimation && props.pattern === "lolbins" && (
      <svg viewBox="0 0 420 150" class="demo demo--lolbins" role="img" aria-label="Living off the land animation">
        <defs>
          <marker id="lol-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="#94a3b8"/>
          </marker>
        </defs>

        <g class="binary" style="--delay: 0s;">
          <rect x="10" y="60" width="100" height="44" rx="8" fill="rgba(59, 130, 246, 0.18)" stroke="#3b82f6" stroke-width="1.5"/>
          <text x="60" y="86" text-anchor="middle" class="demo-label">cmd.exe</text>
          <g class="check">
            <circle cx="100" cy="60" r="10" fill="#22c55e"/>
            <path d="M 95 60 L 99 64 L 105 56" stroke="white" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
        </g>

        <path class="lol-arrow-anim" style="--delay: 0.7s;" d="M 115 82 L 145 82" stroke="#94a3b8" stroke-width="2" fill="none" marker-end="url(#lol-arrow)"/>

        <g class="binary" style="--delay: 1s;">
          <rect x="150" y="60" width="120" height="44" rx="8" fill="rgba(59, 130, 246, 0.18)" stroke="#3b82f6" stroke-width="1.5"/>
          <text x="210" y="86" text-anchor="middle" class="demo-label">powershell.exe</text>
          <g class="check">
            <circle cx="260" cy="60" r="10" fill="#22c55e"/>
            <path d="M 255 60 L 259 64 L 265 56" stroke="white" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
        </g>

        <path class="lol-arrow-anim" style="--delay: 1.7s;" d="M 275 82 L 305 82" stroke="#94a3b8" stroke-width="2" fill="none" marker-end="url(#lol-arrow)"/>

        <g class="binary" style="--delay: 2s;">
          <rect x="310" y="60" width="100" height="44" rx="8" fill="rgba(59, 130, 246, 0.18)" stroke="#3b82f6" stroke-width="1.5"/>
          <text x="360" y="86" text-anchor="middle" class="demo-label">certutil.exe</text>
          <g class="check">
            <circle cx="400" cy="60" r="10" fill="#22c55e"/>
            <path d="M 395 60 L 399 64 L 405 56" stroke="white" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
        </g>

        <g class="payload" style="--delay: 2.8s;">
          <circle cx="370" cy="125" r="11" fill="#ef4444"/>
          <text x="370" y="130" text-anchor="middle" class="demo-payload-mark">!</text>
          <path d="M 360 105 L 380 105" stroke="#ef4444" stroke-width="2" stroke-linecap="round"/>
        </g>
      </svg>
    )}

    {!hasCustomAnimation && props.pattern === "hollowing" && (
      <svg viewBox="0 0 420 180" class="demo demo--hollowing" role="img" aria-label="Process hollowing animation">
        <g class="container">
          <rect x="60" y="30" width="300" height="120" rx="14" fill="rgba(15, 23, 42, 0.7)" stroke="#22c55e" stroke-width="2"/>
          <text x="210" y="22" text-anchor="middle" class="demo-label">svchost.exe</text>
          <g class="sig-badge">
            <rect x="290" y="6" width="78" height="20" rx="10" fill="rgba(34, 197, 94, 0.2)" stroke="#22c55e" stroke-width="1"/>
            <text x="329" y="20" text-anchor="middle" class="demo-tag">✓ Microsoft</text>
          </g>
        </g>

        <g class="legit-code">
          <rect x="80"  y="50" width="180" height="6" rx="3" fill="#86efac"/>
          <rect x="80"  y="62" width="240" height="6" rx="3" fill="#86efac"/>
          <rect x="80"  y="74" width="200" height="6" rx="3" fill="#86efac"/>
          <rect x="80"  y="86" width="260" height="6" rx="3" fill="#86efac"/>
          <rect x="80"  y="98" width="160" height="6" rx="3" fill="#86efac"/>
          <rect x="80" y="110" width="220" height="6" rx="3" fill="#86efac"/>
          <rect x="80" y="122" width="180" height="6" rx="3" fill="#86efac"/>
        </g>

        <g class="mal-code">
          <rect x="80"  y="50" width="200" height="6" rx="3" fill="#fca5a5"/>
          <rect x="80"  y="62" width="170" height="6" rx="3" fill="#fca5a5"/>
          <rect x="80"  y="74" width="240" height="6" rx="3" fill="#fca5a5"/>
          <rect x="80"  y="86" width="190" height="6" rx="3" fill="#fca5a5"/>
          <rect x="80"  y="98" width="250" height="6" rx="3" fill="#fca5a5"/>
          <rect x="80" y="110" width="180" height="6" rx="3" fill="#fca5a5"/>
          <rect x="80" y="122" width="220" height="6" rx="3" fill="#fca5a5"/>
        </g>

      </svg>
    )}

    {!hasCustomAnimation && props.pattern === "timing" && (
      <svg viewBox="0 0 420 160" class="demo demo--timing" role="img" aria-label="Time-based evasion animation">
        <!-- Timeline base -->
        <line x1="20" y1="80" x2="400" y2="80" stroke="rgba(148, 163, 184, 0.45)" stroke-width="2"/>

        <!-- Hour ticks every 4 hours -->
        <g class="ticks">
          <g><line x1="20"  y1="76" x2="20"  y2="84" stroke="#94a3b8" stroke-width="1.5"/><text x="20"  y="100" text-anchor="middle" class="demo-tick">00</text></g>
          <g><line x1="83"  y1="76" x2="83"  y2="84" stroke="#94a3b8" stroke-width="1.5"/><text x="83"  y="100" text-anchor="middle" class="demo-tick">04</text></g>
          <g><line x1="147" y1="76" x2="147" y2="84" stroke="#94a3b8" stroke-width="1.5"/><text x="147" y="100" text-anchor="middle" class="demo-tick">08</text></g>
          <g><line x1="210" y1="76" x2="210" y2="84" stroke="#94a3b8" stroke-width="1.5"/><text x="210" y="100" text-anchor="middle" class="demo-tick">12</text></g>
          <g><line x1="273" y1="76" x2="273" y2="84" stroke="#94a3b8" stroke-width="1.5"/><text x="273" y="100" text-anchor="middle" class="demo-tick">16</text></g>
          <g><line x1="337" y1="76" x2="337" y2="84" stroke="#94a3b8" stroke-width="1.5"/><text x="337" y="100" text-anchor="middle" class="demo-tick">20</text></g>
          <g><line x1="400" y1="76" x2="400" y2="84" stroke="#94a3b8" stroke-width="1.5"/><text x="400" y="100" text-anchor="middle" class="demo-tick">24</text></g>
        </g>

        <!-- Business hours band (09:00-17:00, x = 162-289) -->
        <rect x="162" y="60" width="127" height="40" rx="6" fill="rgba(20, 184, 166, 0.18)" stroke="rgba(20, 184, 166, 0.5)" stroke-width="1"/>
        <text x="225" y="50" text-anchor="middle" class="demo-tag" fill="#5eead4">analysts watching</text>

        <!-- Watching eyes during business hours. Single-codepoint emoji only:
             VS16/ZWJ sequences render inconsistently in SVG <text>. -->
        <text x="190" y="84" text-anchor="middle" class="eye-icon">👀</text>
        <text x="225" y="84" text-anchor="middle" class="eye-icon">👀</text>
        <text x="260" y="84" text-anchor="middle" class="eye-icon">👀</text>

        <!-- Off-hours danger zone (02:00-04:00, x = 51-83) -->
        <rect class="danger-zone" x="51" y="60" width="32" height="40" rx="6" fill="rgba(239, 68, 68, 0.0)" stroke="rgba(239, 68, 68, 0.0)" stroke-width="1"/>

        <!-- Attacker icon that appears during off-hours -->
        <g class="attacker">
          <text x="67" y="84" text-anchor="middle" class="attacker-icon">🦹</text>
        </g>

      </svg>
    )}

    {!hasCustomAnimation && props.pattern === "fatigue" && (
      <svg viewBox="0 0 420 200" class="demo demo--fatigue" role="img" aria-label="Alert fatigue animation">
        <!-- Stream of alert dots falling -->
        <g class="alert-stream">
          <circle class="dot dot--noise" cx="40"  cy="0" r="6" style="--delay: 0s;"   fill="#94a3b8"/>
          <circle class="dot dot--noise" cx="80"  cy="0" r="6" style="--delay: 0.3s;" fill="#94a3b8"/>
          <circle class="dot dot--noise" cx="120" cy="0" r="6" style="--delay: 0.6s;" fill="#fbbf24"/>
          <circle class="dot dot--noise" cx="160" cy="0" r="6" style="--delay: 0.9s;" fill="#94a3b8"/>
          <circle class="dot dot--noise" cx="200" cy="0" r="6" style="--delay: 1.2s;" fill="#94a3b8"/>
          <circle class="dot dot--real"  cx="240" cy="0" r="7" style="--delay: 1.5s;" fill="#ef4444"/>
          <circle class="dot dot--noise" cx="280" cy="0" r="6" style="--delay: 1.8s;" fill="#fbbf24"/>
          <circle class="dot dot--noise" cx="320" cy="0" r="6" style="--delay: 2.1s;" fill="#94a3b8"/>
          <circle class="dot dot--noise" cx="360" cy="0" r="6" style="--delay: 2.4s;" fill="#94a3b8"/>
          <circle class="dot dot--noise" cx="40"  cy="0" r="6" style="--delay: 2.7s;" fill="#94a3b8"/>
          <circle class="dot dot--noise" cx="120" cy="0" r="6" style="--delay: 3.0s;" fill="#fbbf24"/>
          <circle class="dot dot--noise" cx="200" cy="0" r="6" style="--delay: 3.3s;" fill="#94a3b8"/>
          <circle class="dot dot--noise" cx="280" cy="0" r="6" style="--delay: 3.6s;" fill="#94a3b8"/>
          <circle class="dot dot--noise" cx="360" cy="0" r="6" style="--delay: 3.9s;" fill="#fbbf24"/>
        </g>

        <!-- Analyst "gate" at the bottom -->
        <line x1="20" y1="155" x2="400" y2="155" stroke="rgba(148, 163, 184, 0.4)" stroke-width="2"/>
        <g class="analyst">
          {/* Single-codepoint emoji: ZWJ sequences render inconsistently in SVG text. */}
          <text x="210" y="180" text-anchor="middle" class="analyst-eye">😵</text>
        </g>

      </svg>
    )}

    {!hasCustomAnimation && props.pattern === "identity-abuse" && (
      <svg viewBox="0 0 420 170" class="demo demo--identity" role="img" aria-label="Animation: two sign-ins to the same account both pass MFA. The second comes from a hosting provider's network, and it is the intrusion.">
        <rect x="10" y="62" width="110" height="46" rx="8" fill="rgba(20, 184, 166, 0.16)" stroke="#14b8a6" stroke-width="1.5"/>
        <text x="65" y="89" text-anchor="middle" class="demo-label">jdoe@corp</text>

        <path class="id-first" d="M 120 78 L 198 42" stroke="#94a3b8" stroke-width="2" fill="none"/>
        <g class="id-first">
          <rect x="200" y="18" width="210" height="46" rx="8" fill="rgba(15, 23, 42, 0.7)" stroke="#22c55e" stroke-width="1.5"/>
          <text x="214" y="38" class="demo-label">Corporate laptop</text>
          <text x="214" y="55" class="demo-tag">home ISP · MFA ✓</text>
        </g>

        <path class="id-second" d="M 120 92 L 198 128" stroke="#94a3b8" stroke-width="2" fill="none"/>
        <g class="id-second">
          <rect class="id-second__box" x="200" y="106" width="210" height="46" rx="8" fill="rgba(15, 23, 42, 0.7)" stroke="#22c55e" stroke-width="1.5"/>
          <text x="214" y="126" class="demo-label">Unknown host</text>
          <text x="214" y="143" class="demo-tag">hosting ASN · MFA ✓</text>
        </g>

        <g class="id-flag">
          <circle cx="398" cy="106" r="10" fill="#ef4444"/>
          <text x="398" y="111" text-anchor="middle" class="demo-payload-mark">!</text>
        </g>
      </svg>
    )}

    {!hasCustomAnimation && props.pattern === "rmm" && (
      <svg viewBox="0 0 420 160" class="demo demo--rmm" role="img" aria-label="Animation: a signed remote-management tool on a workstation connects out to its vendor's relay over allowed egress. Everything about it looks legitimate except that nobody approved this install.">
        <rect x="10" y="40" width="130" height="60" rx="8" fill="rgba(99, 102, 241, 0.16)" stroke="#6366f1" stroke-width="1.5"/>
        <text x="75" y="66" text-anchor="middle" class="demo-label">AnyDesk.exe</text>
        <text x="75" y="86" text-anchor="middle" class="demo-tag">✓ signed vendor</text>

        <path class="rmm-wire" d="M 142 70 L 278 70" stroke="#94a3b8" stroke-width="2" stroke-dasharray="6 6" fill="none"/>

        <rect x="280" y="40" width="130" height="60" rx="30" fill="rgba(15, 23, 42, 0.7)" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="345" y="66" text-anchor="middle" class="demo-label">vendor relay</text>
        <text x="345" y="86" text-anchor="middle" class="demo-tag">allowed egress</text>

        <g class="rmm-flag">
          <rect x="85" y="118" width="250" height="28" rx="14" fill="rgba(239, 68, 68, 0.18)" stroke="#ef4444" stroke-width="1.2"/>
          <text x="210" y="136" text-anchor="middle" class="demo-tag demo-tag--alert">no change ticket · unknown tenant</text>
        </g>
      </svg>
    )}

    {!hasCustomAnimation && props.pattern === "edr-tampering" && (
      <svg viewBox="0 0 420 160" class="demo demo--edr" role="img" aria-label="Animation: an endpoint agent sends steady heartbeats to its console, then stops. The console still lists the host, last seen minutes ago. The silence is the alert.">
        <rect x="10" y="45" width="124" height="70" rx="8" fill="rgba(249, 115, 22, 0.14)" stroke="#f97316" stroke-width="1.5"/>
        <text x="72" y="72" text-anchor="middle" class="demo-label">laptop-09</text>
        <text x="72" y="96" text-anchor="middle" class="demo-tag edr-on">agent: running</text>
        <text x="72" y="96" text-anchor="middle" class="demo-tag demo-tag--alert edr-off">agent: stopped</text>

        <line x1="134" y1="80" x2="286" y2="80" stroke="rgba(148, 163, 184, 0.35)" stroke-width="2"/>
        <circle class="edr-beat" cx="140" cy="80" r="5" fill="#22c55e" style="--delay: 0s;"/>
        <circle class="edr-beat" cx="140" cy="80" r="5" fill="#22c55e" style="--delay: 0.55s;"/>
        <circle class="edr-beat" cx="140" cy="80" r="5" fill="#22c55e" style="--delay: 1.1s;"/>
        <circle class="edr-beat" cx="140" cy="80" r="5" fill="#22c55e" style="--delay: 1.65s;"/>

        <rect x="286" y="45" width="124" height="70" rx="8" fill="rgba(15, 23, 42, 0.7)" stroke="#94a3b8" stroke-width="1.5"/>
        <text x="348" y="72" text-anchor="middle" class="demo-label">EDR console</text>
        <text x="348" y="96" text-anchor="middle" class="demo-tag edr-on">last seen: now</text>
        <text x="348" y="96" text-anchor="middle" class="demo-tag demo-tag--alert edr-off">last seen: 14 min</text>
      </svg>
    )}

    {!hasCustomAnimation && props.pattern === "sensor-blinding" && (
      <svg viewBox="0 0 420 170" class="demo demo--blind" role="img" aria-label="Animation: a server's hourly log volume runs steady, then an audit-policy change drops it to nothing. No detection rule fires on the gap. The missing data is the signal.">
        <line x1="20" y1="130" x2="400" y2="130" stroke="rgba(148, 163, 184, 0.45)" stroke-width="2"/>
        <rect class="blind-bar" x="30"  y="74" width="18" height="56" rx="2" fill="#94a3b8" style="--delay: 0s;"/>
