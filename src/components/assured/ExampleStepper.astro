---
/**
 * ExampleStepper. A tabbed step-through used inside a ChapterExample.
 * The reader clicks numbered tabs (or arrow buttons) to advance through
 * stages of the example. The component is plain vanilla JS so it works
 * without any framework dependency.
 *
 * Usage:
 *   <ExampleStepper steps={["Alert fires", "Detection mechanism", ...]}>
 *     <div data-step>...content for step 1...</div>
 *     <div data-step>...content for step 2...</div>
 *     ...
 *   </ExampleStepper>
 */

interface Props {
  steps: string[];
}

const { steps } = Astro.props;
---

<div class="stepper" data-stepper>
  <nav class="stepper__tabs" role="tablist" aria-label="Walkthrough steps">
    {steps.map((label, i) => (
      <button
        type="button"
        role="tab"
        class="stepper__tab"
        data-step-index={i}
        aria-selected={i === 0 ? "true" : "false"}
      >
        <span class="stepper__tab-num">{String(i + 1).padStart(2, "0")}</span>
        <span class="stepper__tab-label">{label}</span>
      </button>
    ))}
  </nav>

  <div class="stepper__panels" data-stepper-panels>
    <slot />
  </div>

  <div class="stepper__controls">
    <button type="button" class="stepper__btn stepper__btn--prev" data-stepper-prev disabled>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5"></path><path d="M11 19l-7-7 7-7"></path>
      </svg>
      Previous
    </button>
    <span class="stepper__progress" data-stepper-progress>Step 1 of {steps.length}</span>
    <button type="button" class="stepper__btn stepper__btn--next" data-stepper-next>
      Next
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"></path><path d="M13 19l7-7-7-7"></path>
      </svg>
    </button>
  </div>
</div>

<style>
  .stepper {
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 1rem;
    overflow: hidden;
  }

  .stepper__tabs {
    display: flex;
    overflow-x: auto;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    padding: 0.5rem;
    gap: 0.35rem;
    background: rgba(15, 23, 42, 0.6);
  }

  .stepper__tab {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.9rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.45rem;
    color: #94a3b8;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .stepper__tab:hover {
    color: #e2e8f0;
    background: rgba(248, 250, 252, 0.04);
  }

  .stepper__tab[aria-selected="true"] {
    color: #d8b4fe;
    background: rgba(168, 85, 247, 0.14);
    border-color: rgba(168, 85, 247, 0.35);
  }

  .stepper__tab-num {
    font-weight: 800;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    opacity: 0.8;
  }

  .stepper__panels {
    padding: 1.75rem;
  }

  /*
   * The [data-step] panels are authored in MDX (not as component children of this .astro
   * file), so Astro's automatic style scoping does NOT add this component's hash to them.
   * The visibility rules must be :global() so they match unscoped attribute selectors.
   * Don't "fix" this back to scoped CSS without also moving the panels into slot rendering.
   */
  .stepper__panels :global([data-step]) {
    display: none;
  }

  .stepper__panels :global([data-step].is-active) {
    display: block;
    animation: panel-fade-in 0.25s ease;
  }

  @keyframes panel-fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .stepper__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(15, 23, 42, 0.4);
  }

  .stepper__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    background: rgba(168, 85, 247, 0.14);
    border: 1px solid rgba(168, 85, 247, 0.4);
    border-radius: 0.45rem;
    color: #d8b4fe;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    transition: filter 0.15s ease, transform 0.15s ease;
  }

  .stepper__btn:hover:not(:disabled) {
    filter: brightness(1.15);
    transform: translateY(-1px);
  }

  .stepper__btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .stepper__progress {
    color: #94a3b8;
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .stepper__tabs { padding: 0.4rem; }
    .stepper__tab { font-size: 0.75rem; padding: 0.45rem 0.7rem; }
    .stepper__tab-label { display: none; }
    .stepper__panels { padding: 1.25rem; }
  }
</style>

<script>
  // ClientRouter idempotency: re-runs after each view transition (data-astro-rerun).
  // Each [data-stepper] is marked once-bound so re-runs are safe on pages we already
  // visited; new pages get fresh DOM and fresh bindings.
  function bindSteppers() {
    const steppers = document.querySelectorAll<HTMLElement>("[data-stepper]:not([data-stepper-bound])");
    steppers.forEach((root) => {
      root.setAttribute("data-stepper-bound", "true");
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".stepper__tab"));
      const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-step]"));
      const prev = root.querySelector<HTMLButtonElement>("[data-stepper-prev]");
      const next = root.querySelector<HTMLButtonElement>("[data-stepper-next]");
      const progress = root.querySelector<HTMLElement>("[data-stepper-progress]");
      const total = panels.length;
      let current = 0;

      function go(to: number) {
        current = Math.max(0, Math.min(total - 1, to));
        tabs.forEach((t, i) => {
          t.setAttribute("aria-selected", i === current ? "true" : "false");
        });
        panels.forEach((p, i) => {
          p.classList.toggle("is-active", i === current);
        });
        if (prev) prev.disabled = current === 0;
        if (next) next.disabled = current === total - 1;
        if (progress) progress.textContent = `Step ${current + 1} of ${total}`;
      }

      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => go(i));
      });
      prev?.addEventListener("click", () => go(current - 1));
      next?.addEventListener("click", () => go(current + 1));

      // Initial state
      go(0);
    });
  }

  bindSteppers();
  document.addEventListener("astro:page-load", bindSteppers);
</script>
