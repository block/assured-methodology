---
/**
 * FlipCard. Front face shows a hook (title + icon). Click or tap to flip
 * to the back, which reveals the detail.
 *
 * Built with a CSS 3D transform. Front and back share the same height
 * (controlled by the front side) so the layout does not jump on flip.
 *
 * Usage in MDX:
 *   <FlipCard icon="🧩" title="A method for the first 30 minutes" hint="Tap to learn more">
 *     NIST, SANS PICERL, and ATT&CK describe...
 *   </FlipCard>
 */

interface Props {
  icon?: string;
  title: string;
  hint?: string;
  accent?: "teal" | "blue" | "green" | "purple" | "orange" | "red" | "indigo";
}

const { icon, title, hint = "Tap to reveal", accent = "teal" } = Astro.props;
---

{/*
  IMPORTANT: the flip controls are leaf-level <button>s (the title on the front,
  "Tap to flip back" on the back), NOT a wrapper button around the faces.
  The back-face slot can render arbitrary MDX content including other components
  that emit their own <button> (e.g. DefineTerm). A <button> inside a <button>
  is invalid HTML, and a role="button" wrapper is just as broken for assistive
  tech: ARIA prohibits interactive descendants inside a button, and screen
  readers flatten the whole back face into the button's accessible name.
  The face that is rotated away also gets inert + aria-hidden (managed by the
  script) so its content leaves the tab order and the accessibility tree.
*/}
<div class={`flip-card flip-card--${accent}`} data-flip-card>
  <div class="flip-card__inner">
    <div class="flip-card__face flip-card__face--front">
      {icon && <div class="flip-card__icon" aria-hidden="true">{icon}</div>}
      <h3 class="flip-card__title">
        <button type="button" class="flip-card__title-btn" data-flip-toggle aria-expanded="false">{title}</button>
      </h3>
      <span class="flip-card__hint" aria-hidden="true">
        {hint}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 0 1 9-9 9.74 9.74 0 0 1 6.74 2.74L21 8"></path>
          <path d="M21 3v5h-5"></path>
        </svg>
      </span>
    </div>
    <div class="flip-card__face flip-card__face--back" inert aria-hidden="true">
      <div class="flip-card__back-body">
        <slot />
      </div>
      <button type="button" class="flip-card__hint flip-card__hint--back" data-flip-back>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 2v6h6"></path>
          <path d="M3 13a9 9 0 1 0 3-7.7L3 8"></path>
        </svg>
        Tap to flip back
      </button>
    </div>
  </div>
</div>

<style>
  /*
   * Layout uses CSS grid to stack front + back faces in the same grid cell.
   * This makes the card's intrinsic height the MAX of both faces, so neither
   * is cut off, and avoids the position:absolute layout bugs that come from
   * mixing 3D transforms with absolute positioning inside a <button>.
   *
   * The 3D flip itself still works via `transform: rotateY(180deg)` on the
   * inner, with backface-visibility on each face.
   */
  .flip-card {
    perspective: 1200px;
    min-height: 14rem;
    display: flex;
  }

  .flip-card__inner {
    display: grid;
    width: 100%;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    border-radius: 1rem;
    font-family: inherit;
    text-align: left;
    /* Defeat the user-agent <button> overflow that breaks 3D context in some browsers. */
    overflow: visible;
  }

  .flip-card__inner.is-flipped {
    transform: rotateY(180deg);
  }

  .flip-card__face {
    /* Both faces occupy the same grid cell, so the inner sizes to the taller of the two. */
    grid-column: 1;
    grid-row: 1;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    padding: 1.5rem;
    border-radius: 1rem;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    min-height: 14rem;
  }

  .flip-card__face--front {
    border-color: var(--accent-soft, rgba(20, 184, 166, 0.3));
  }

  .flip-card__face--back {
    transform: rotateY(180deg);
    background: linear-gradient(135deg, var(--accent-bg, rgba(20, 184, 166, 0.12)), rgba(15, 23, 42, 0.7));
    border-color: var(--accent, #5eead4);
    color: #e2e8f0;
  }

  .flip-card--teal   { --accent: #5eead4; --accent-soft: rgba(20, 184, 166, 0.35); --accent-bg: rgba(20, 184, 166, 0.14); }
  .flip-card--blue   { --accent: #93c5fd; --accent-soft: rgba(59, 130, 246, 0.35); --accent-bg: rgba(59, 130, 246, 0.14); }
  .flip-card--green  { --accent: #86efac; --accent-soft: rgba(34, 197, 94, 0.35); --accent-bg: rgba(34, 197, 94, 0.14); }
  .flip-card--purple { --accent: #d8b4fe; --accent-soft: rgba(168, 85, 247, 0.35); --accent-bg: rgba(168, 85, 247, 0.14); }
  .flip-card--orange { --accent: #fdba74; --accent-soft: rgba(249, 115, 22, 0.35); --accent-bg: rgba(249, 115, 22, 0.14); }
  .flip-card--red    { --accent: #fca5a5; --accent-soft: rgba(239, 68, 68, 0.35); --accent-bg: rgba(239, 68, 68, 0.14); }
  .flip-card--indigo { --accent: #a5b4fc; --accent-soft: rgba(99, 102, 241, 0.35); --accent-bg: rgba(99, 102, 241, 0.14); }

  .flip-card:hover .flip-card__face--front {
    border-color: var(--accent);
    box-shadow: 0 14px 32px -16px rgba(0, 0, 0, 0.5);
  }

  .flip-card__icon {
    font-size: 1.85rem;
    line-height: 1.2;
    margin-bottom: 0.85rem;
  }

  .flip-card__title {
    margin: 0 0 0.65rem 0;
    color: #f8fafc;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .flip-card__title-btn {
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .flip-card__title-btn:focus-visible,
  .flip-card__hint--back:focus-visible {
    outline: 2px solid var(--accent, #5eead4);
    outline-offset: 4px;
    border-radius: 0.25rem;
  }

  .flip-card__hint {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
  }

  .flip-card__hint--back {
    color: #cbd5e1;
    font-weight: 500;
    background: none;
    border: 0;
    padding: 0;
    font-family: inherit;
    cursor: pointer;
  }

  .flip-card__back-body {
    color: #cbd5e1;
    line-height: 1.65;
    font-size: 0.95rem;
    margin-bottom: 0.85rem;
  }

  .flip-card__back-body :first-child { margin-top: 0; }
  .flip-card__back-body :last-child { margin-bottom: 0; }

  @media (prefers-reduced-motion: reduce) {
    .flip-card__inner {
      transition: none;
    }
  }
</style>

<script>
  // ClientRouter idempotency: rebind on every page-load; per-card marker prevents double-bind.
  // Keyboard/AT interaction goes through the two real <button>s (title on the
  // front, "flip back" on the back). The whole-card click stays as a pointer
  // convenience. The rotated-away face gets inert + aria-hidden so its content
  // (including nested DefineTerm buttons) leaves the tab order and the
  // accessibility tree.
  function bindFlipCards() {
    const cards = document.querySelectorAll<HTMLElement>("[data-flip-card]:not([data-flip-bound])");
    cards.forEach((card) => {
      card.setAttribute("data-flip-bound", "true");
      const inner = card.querySelector<HTMLElement>(".flip-card__inner");
      const front = card.querySelector<HTMLElement>(".flip-card__face--front");
      const back = card.querySelector<HTMLElement>(".flip-card__face--back");
      const titleBtn = card.querySelector<HTMLButtonElement>("[data-flip-toggle]");
      const backBtn = card.querySelector<HTMLButtonElement>("[data-flip-back]");
      if (!inner || !front || !back || !titleBtn || !backBtn) return;

      function setFlipped(flipped: boolean, moveFocus: boolean) {
        inner!.classList.toggle("is-flipped", flipped);
        titleBtn!.setAttribute("aria-expanded", flipped ? "true" : "false");
        front!.toggleAttribute("inert", flipped);
        front!.setAttribute("aria-hidden", flipped ? "true" : "false");
        back!.toggleAttribute("inert", !flipped);
        back!.setAttribute("aria-hidden", flipped ? "false" : "true");
        // The activated control is now on the inert face; focus its
        // counterpart so keyboard users aren't dropped to <body>.
        if (moveFocus) (flipped ? backBtn! : titleBtn!).focus();
      }

      titleBtn.addEventListener("click", () => setFlipped(true, true));
      backBtn.addEventListener("click", () => setFlipped(false, true));

      inner.addEventListener("click", (e) => {
        // If the click originated on (or inside) a nested interactive control
        // (the flip buttons handle themselves; DefineTerm handles its tooltip),
        // don't also flip the card.
        const target = e.target as Element;
        if (target.closest("button, a, input, select, textarea, [role='button']")) return;
        setFlipped(!inner.classList.contains("is-flipped"), false);
      });
    });
  }
  bindFlipCards();
  document.addEventListener("astro:page-load", bindFlipCards);
</script>
