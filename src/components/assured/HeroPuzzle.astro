---
/**
 * HeroPuzzle. Seven jigsaw pieces, one per letter of ASSURED, that
 * animate from scattered positions into a locked-together row.
 *
 * Each piece has a slot on its left side and a tab on its right that
 * mates with the next piece's slot. After the assembly animation finishes,
 * a faint glow runs across the seam to signal "locked."
 *
 * Respects prefers-reduced-motion.
 */

const phases = [
  { letter: "A", phase: "alert" },
  { letter: "S", phase: "subject" },
  { letter: "S", phase: "scope" },
  { letter: "U", phase: "uncover" },
  { letter: "R", phase: "risk" },
  { letter: "E", phase: "escalation" },
  { letter: "D", phase: "documentation" },
];

/*
 * Path for a piece. Piece body is 80 wide x 80 tall. Tab bulges 14px to
 * the right (so the bounding box is 94 wide). Slot recedes 14px on the
 * left. Tab and slot use matching geometry so consecutive pieces fit.
 */
const pathFor = (i: number, total: number) => {
  const hasSlot = i > 0;
  const hasTab = i < total - 1;
  return [
    "M 0 0",
    "L 80 0",
    hasTab
      ? "L 80 26 C 80 12, 96 12, 96 40 C 96 68, 80 68, 80 54 L 80 80"
      : "L 80 80",
    "L 0 80",
    hasSlot ? "L 0 54 C 16 68, 16 12, 0 26 Z" : "L 0 0 Z",
  ].join(" ");
};

// Scattered starting offsets for each piece (in viewBox units).
const scatter = [
  { dx: -120, dy: -50, rot: -14 },
  { dx: -70, dy: 40, rot: 10 },
  { dx: -30, dy: -45, rot: -6 },
  { dx: 0, dy: 50, rot: 12 },
  { dx: 40, dy: -45, rot: -8 },
  { dx: 80, dy: 45, rot: 14 },
  { dx: 130, dy: -40, rot: -12 },
];
---

{/* The accessible name lives on the role="img" SVG via aria-labelledby
    (aria-label on a role-less div is ignored per ARIA). */}
<div class="hero-puzzle" data-hero-puzzle>
  <svg
    class="hero-puzzle__svg"
    viewBox="-20 -30 600 140"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="hero-puzzle-title hero-puzzle-desc"
  >
    <title id="hero-puzzle-title">ASSURED methodology, seven pieces locking into place</title>
    <desc id="hero-puzzle-desc">Seven puzzle pieces labeled A, S, S, U, R, E, D fly in from scattered positions and lock together edge-to-edge.</desc>

    <defs>
      <!-- The 30px/800 white letters are WCAG large text, so every gradient
           stop must clear 3:1 with white. The original light stops (blue-400
           #60a5fa and friends) sat at 1.7-2.5:1; these start one shade darker
           and keep the same dark ends. -->
      <linearGradient id="g-alert" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#2563eb"/>
        <stop offset="100%" stop-color="#1d4ed8"/>
      </linearGradient>
      <linearGradient id="g-subject" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#16a34a"/>
        <stop offset="100%" stop-color="#15803d"/>
      </linearGradient>
      <linearGradient id="g-scope" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#9333ea"/>
        <stop offset="100%" stop-color="#7e22ce"/>
      </linearGradient>
      <linearGradient id="g-uncover" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ea580c"/>
        <stop offset="100%" stop-color="#c2410c"/>
      </linearGradient>
      <linearGradient id="g-risk" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#dc2626"/>
        <stop offset="100%" stop-color="#b91c1c"/>
      </linearGradient>
      <linearGradient id="g-escalation" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#4f46e5"/>
        <stop offset="100%" stop-color="#4338ca"/>
      </linearGradient>
      <linearGradient id="g-documentation" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#0891b2"/>
        <stop offset="100%" stop-color="#0e7490"/>
      </linearGradient>

      <filter id="piece-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur in="SourceAlpha" stdDeviation="2"/>
        <feOffset dx="0" dy="3" result="off"/>
        <feFlood flood-color="#000" flood-opacity="0.4"/>
        <feComposite in2="off" operator="in"/>
        <feMerge>
          <feMergeNode/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>

      <!-- Lock-glow ribbon that runs across the assembled puzzle once -->
      <linearGradient id="lock-glow" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%"  stop-color="rgba(94, 234, 212, 0)"/>
        <stop offset="45%" stop-color="rgba(94, 234, 212, 0)"/>
        <stop offset="50%" stop-color="rgba(94, 234, 212, 0.7)"/>
        <stop offset="55%" stop-color="rgba(94, 234, 212, 0)"/>
        <stop offset="100%" stop-color="rgba(94, 234, 212, 0)"/>
      </linearGradient>
    </defs>

    <!-- Underlay: white-glow ribbon that traverses the row once after assembly -->
    <rect class="hero-puzzle__lock-ribbon" x="-20" y="-10" width="600" height="100" fill="url(#lock-glow)" opacity="0"/>

    {phases.map((p, i) => (
      <g
        class="hero-puzzle__piece"
        style={`
          --delay: ${i * 90 + 200}ms;
          --tx: ${i * 80}px;
          --sx: ${scatter[i].dx}px;
          --sy: ${scatter[i].dy}px;
          --rot: ${scatter[i].rot}deg;
        `}
        filter="url(#piece-shadow)"
      >
        <path d={pathFor(i, phases.length)} fill={`url(#g-${p.phase})`}/>
        <text x="40" y="52" text-anchor="middle" class="hero-puzzle__letter">{p.letter}</text>
      </g>
    ))}
  </svg>
</div>

<style>
  .hero-puzzle {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .hero-puzzle__svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .hero-puzzle__piece {
    opacity: 0;
    transform: translateX(calc(var(--tx, 0) + var(--sx, 0))) translateY(var(--sy, 0)) rotate(var(--rot, 0));
    animation: fly-in 1.05s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    animation-delay: var(--delay, 0ms);
    transform-box: fill-box;
  }

  .hero-puzzle__piece path {
    transition: filter 0.25s ease, transform 0.25s ease;
    transform-origin: center;
    transform-box: fill-box;
  }

  .hero-puzzle__piece:hover path {
    filter: brightness(1.18) drop-shadow(0 0 12px currentColor);
    transform: translateY(-3px);
  }

  .hero-puzzle__letter {
    font-family: var(--font-sans, system-ui), sans-serif;
    font-size: 30px;
    font-weight: 800;
    fill: white;
    pointer-events: none;
  }

  /* Lock-glow ribbon: triggers once after the last piece settles. */
  .hero-puzzle__lock-ribbon {
    animation: lock-glow 1.4s ease-out 1.5s 1 forwards;
    pointer-events: none;
  }

  @keyframes fly-in {
    0% {
      opacity: 0;
      transform: translateX(calc(var(--tx, 0) + var(--sx, 0))) translateY(var(--sy, 0)) rotate(var(--rot, 0));
    }
    65% {
      opacity: 1;
      transform: translateX(var(--tx, 0)) translateY(-3px) rotate(0deg) scale(1.02);
    }
    100% {
      opacity: 1;
      transform: translateX(var(--tx, 0)) translateY(0) rotate(0deg) scale(1);
    }
  }

  @keyframes lock-glow {
    0%   { opacity: 0; transform: translateX(-100%); }
    20%  { opacity: 0.85; }
    100% { opacity: 0; transform: translateX(100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-puzzle__piece {
      opacity: 1;
      transform: translateX(var(--tx, 0));
      animation: none;
    }
    .hero-puzzle__lock-ribbon {
      animation: none;
      opacity: 0;
    }
  }
</style>

