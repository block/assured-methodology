---
/**
 * KeyTakeaway, a "summary, remember this" block at the end of a section.
 */

interface Props {
  title?: string;
}

const { title = "Key Takeaway" } = Astro.props;
---

<aside class="assured-callout assured-callout--takeaway">
  <div class="assured-callout__icon" aria-hidden="true">✅</div>
  <div class="assured-callout__body">
    <p class="assured-callout__title">{title}</p>
    <slot />
  </div>
</aside>
