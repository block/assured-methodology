---
/**
 * KeyTakeaway, a "summary, remember this" block at the end of a section.
 * A Callout takeaway with a default title.
 */

import Callout from "@/components/assured/Callout.astro";

interface Props {
  title?: string;
}

const { title = "Key Takeaway" } = Astro.props;
---

<Callout variant="takeaway" title={title}>
  <slot />
</Callout>
