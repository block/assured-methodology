---
/**
 * PhaseDiagram, three-phase flowchart of the ASSURED methodology.
 *
 * Replaces the previous inline SVG that lived in intro.mdx. Cleaner SVG
 * with semantic structure, proper labels, and a feedback-loop arrow.
 */
---

<figure class="phase-diagram">
  <svg viewBox="0 0 820 360" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="phase-diagram-title phase-diagram-desc">
    <title id="phase-diagram-title">ASSURED three-phase flow</title>
    <desc id="phase-diagram-desc">Phase one (Preparation and Context) feeds phase two (Investigation and Assessment), which feeds phase three (Resolution and Documentation). A feedback loop returns insight to the earlier phases.</desc>

    <defs>
      <linearGradient id="phase1" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#22c55e"/>
        <stop offset="100%" stop-color="#15803d"/>
      </linearGradient>
      <linearGradient id="phase2" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#3b82f6"/>
        <stop offset="100%" stop-color="#1d4ed8"/>
      </linearGradient>
      <linearGradient id="phase3" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#f59e0b"/>
        <stop offset="100%" stop-color="#b45309"/>
      </linearGradient>
      <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0,0 L10,5 L0,10 z" fill="#cbd5e1"/>
      </marker>
    </defs>

    <!-- Phase headers -->
    <g class="phase-diagram__row phase-diagram__row--phases">
      <g class="phase-diagram__phase-box">
        <rect x="20"  y="20" width="240" height="70" rx="14" fill="url(#phase1)"/>
        <text x="140" y="50" text-anchor="middle" class="phase-diagram__label">Preparation</text>
        <text x="140" y="72" text-anchor="middle" class="phase-diagram__label">&amp; Context</text>
      </g>
      <path d="M 265 55 L 285 55" stroke="#cbd5e1" stroke-width="2" marker-end="url(#arrow)"/>
      <g class="phase-diagram__phase-box">
        <rect x="290" y="20" width="240" height="70" rx="14" fill="url(#phase2)"/>
        <text x="410" y="50" text-anchor="middle" class="phase-diagram__label">Investigation</text>
        <text x="410" y="72" text-anchor="middle" class="phase-diagram__label">&amp; Assessment</text>
      </g>
      <path d="M 535 55 L 555 55" stroke="#cbd5e1" stroke-width="2" marker-end="url(#arrow)"/>
      <g class="phase-diagram__phase-box">
        <rect x="560" y="20" width="240" height="70" rx="14" fill="url(#phase3)"/>
        <text x="680" y="50" text-anchor="middle" class="phase-diagram__label">Resolution</text>
        <text x="680" y="72" text-anchor="middle" class="phase-diagram__label">&amp; Documentation</text>
      </g>
    </g>

    <!-- Component pieces -->
    <g class="phase-diagram__components">
      <!-- Alert + Subject + Scope -->
      <g>
        <rect x="20" y="130" width="110" height="55" rx="10" fill="#22c55e"/>
        <text x="75" y="163" text-anchor="middle" class="phase-diagram__cell">A · Alert</text>

        <rect x="140" y="130" width="120" height="55" rx="10" fill="#22c55e"/>
        <text x="200" y="163" text-anchor="middle" class="phase-diagram__cell">S · Subject</text>

        <rect x="80" y="200" width="120" height="55" rx="10" fill="#22c55e"/>
        <text x="140" y="232" text-anchor="middle" class="phase-diagram__cell">S · Scope</text>
      </g>

      <path d="M 75 187 L 75 220 L 78 220" stroke="#94a3b8" stroke-width="2" fill="none"/>
      <path d="M 200 187 L 200 220 L 197 220" stroke="#94a3b8" stroke-width="2" fill="none"/>
      <path d="M 202 228 L 285 228" stroke="#94a3b8" stroke-width="2" marker-end="url(#arrow)"/>

      <!-- Uncover + Risk -->
      <g>
        <rect x="290" y="200" width="120" height="55" rx="10" fill="#3b82f6"/>
        <text x="350" y="232" text-anchor="middle" class="phase-diagram__cell">U · Uncover</text>

        <rect x="420" y="200" width="120" height="55" rx="10" fill="#3b82f6"/>
        <text x="480" y="232" text-anchor="middle" class="phase-diagram__cell">R · Risk</text>
      </g>

      <path d="M 412 228 L 418 228" stroke="#94a3b8" stroke-width="2" marker-end="url(#arrow)"/>
      <path d="M 542 228 L 548 228" stroke="#94a3b8" stroke-width="2" marker-end="url(#arrow)"/>

      <!-- Escalation + Documentation -->
      <g>
        <rect x="550" y="200" width="120" height="55" rx="10" fill="#f59e0b"/>
        <text x="610" y="232" text-anchor="middle" class="phase-diagram__cell">E · Escalation</text>

        <rect x="680" y="200" width="125" height="55" rx="10" fill="#f59e0b"/>
        <text x="742" y="232" text-anchor="middle" class="phase-diagram__cell">D · Documentation</text>
      </g>

      <path d="M 670 228 L 678 228" stroke="#94a3b8" stroke-width="2" marker-end="url(#arrow)"/>
    </g>

    <!-- Feedback loop -->
    <g>
      <path d="M 480 270 Q 480 320 280 320 Q 140 320 140 270" stroke="#14b8a6" stroke-width="2" stroke-dasharray="6 6" fill="none" marker-end="url(#arrow)"/>
      <text x="310" y="340" text-anchor="middle" class="phase-diagram__feedback">↻ Feedback loop, refine scope, re-uncover, re-validate</text>
    </g>
  </svg>
</figure>

<style>
  .phase-diagram {
    margin: 2rem auto;
    padding: 1.75rem;
    border-radius: 1rem;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.2);
    backdrop-filter: blur(8px);
    max-width: 920px;
  }

  .phase-diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .phase-diagram__label {
    font-family: var(--font-sans, system-ui), sans-serif;
    font-size: 16px;
    font-weight: 700;
    fill: white;
  }

  .phase-diagram__cell {
    font-family: var(--font-sans, system-ui), sans-serif;
    font-size: 15px;
    font-weight: 700;
    fill: white;
  }

  .phase-diagram__feedback {
    font-family: var(--font-sans, system-ui), sans-serif;
    font-size: 13px;
    fill: #5eead4;
    font-weight: 500;
  }
</style>
