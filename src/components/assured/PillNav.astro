---
/**
 * PillNav. Horizontal pill row for peer-page navigation. The current page
 * is derived from Astro.url.pathname and highlighted.
 *
 * Pills come from src/data/navigation.ts, so labels live in one place:
 *
 * - `chapter="alert"` lists the chapter's pillars and companions, then the
 *   chapter tail in reading order (Working example, Transition, Quiz;
 *   Documentation ends Example, Quiz, Closure).
 * - `section="/docs/field-reference/#reading-telemetry"` lists that nav
 *   entry's children.
 * - `items` overrides both. An item without a label takes its navigation
 *   shortTitle (or title).
 *
 * Sticky on scroll so it stays accessible without forcing the reader back
 * to the top (from tablet width up; on phones the header plus a sticky
 * pill row would take a fifth of the screen, so the row scrolls away).
 * When the pills overflow, the row scrolls horizontally and a fade plus
 * chevron marks each edge that has more pills beyond it (the same
 * affordance as ExampleStepper's tab row); overlay scrollbars on macOS
 * hide a thin scrollbar until the reader scrolls, so the scrollbar alone
 * is not enough. The current pill is scrolled into view on load.
 */
import {
  chapterPages,
  chapterTailPages,
  findNavItem,
  type NavItem,
  navLabel,
  type PhaseKey,
  phaseInfo,
} from "@/data/navigation";

interface Item {
  label?: string;
  href: string;
  phase?: string;
}

interface Props {
  label?: string;
  items?: Item[];
  sticky?: boolean;
  /** Derive the pills (and the chapter tail) from this chapter's navigation. */
  chapter?: PhaseKey;
  /** Derive the pills from this navigation entry's children. */
  section?: string;
  /** Phase accent for section pills. */
  phase?: PhaseKey;
}

const { sticky = true, chapter, section, phase } = Astro.props;

const pagePath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const fromNav = (
  item: NavItem,
  accent?: string,
): Required<Pick<Item, "label" | "href">> & Item => ({
  label: item.shortTitle ?? item.title,
  href: item.href,
  phase: accent,
});

const sectionItem = section ? findNavItem(section) : undefined;
if (section && !sectionItem) {
  throw new Error(`PillNav: no navigation entry for section "${section}"`);
}

const items: { label: string; href: string; phase?: string }[] = Astro.props
  .items
  ? Astro.props.items.map((item) => {
      const label = item.label ?? navLabel(item.href);
      if (!label) throw new Error(`PillNav: no label for "${item.href}"`);
      return { label, href: item.href, phase: item.phase ?? chapter ?? phase };
    })
  : sectionItem
    ? (sectionItem.children ?? []).map((c) => fromNav(c, phase))
    : chapter
      ? chapterPages(chapter).map((c) => fromNav(c, chapter))
      : [];

/* The chapter tail is only appended for chapter pills: section rows (Field
 * reference, for example) are not part of a chapter. */
const chapterTail =
  chapter && !sectionItem
    ? chapterTailPages(chapter).map((c) => fromNav(c, chapter))
    : [];

const label =
  Astro.props.label ??
  (sectionItem
    ? sectionItem.title
    : chapter
      ? `${phaseInfo(chapter).name} chapter`
      : "Jump to");
---

<nav class={`pillnav ${sticky ? "pillnav--sticky" : ""}`} aria-label={label} data-pagefind-ignore>
  <span class="pillnav__label" aria-hidden="true">{label}</span>
  <div class="pillnav__scroll" data-pillnav-scroll>
  <ul class="pillnav__items" data-pillnav-items>
    {items.map((item) => {
      const isCurrent = pagePath === item.href;
      return (
        <li>
          <a
            href={item.href}
            class={`pillnav__item ${isCurrent ? "is-current" : ""} ${item.phase ? `pillnav__item--${item.phase}` : ""}`}
            aria-current={isCurrent ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      );
    })}
    {chapterTail.length > 0 && (
      <>
        <li aria-hidden="true" class="pillnav__divider">·</li>
        {chapterTail.map((item) => {
          const isCurrent = pagePath === item.href;
          return (
            <li>
              <a
                href={item.href}
                class={`pillnav__item pillnav__item--tail ${isCurrent ? "is-current" : ""} ${item.phase ? `pillnav__item--${item.phase}` : ""}`}
                aria-current={isCurrent ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </>
    )}
  </ul>
  </div>
</nav>

<style>
  .pillnav {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0 0 2rem 0;
    padding: 0.6rem 0.85rem;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 9999px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
  }

  .pillnav--sticky {
    position: sticky;
    top: calc(var(--header-height) + 16px);
    z-index: 10;
    box-shadow: 0 10px 24px -16px rgba(0, 0, 0, 0.6);
  }

  /* Phones: header plus a pinned pill row ran ~142px of a ~700px screen.
     Let the row scroll away with the page. */
  @media (max-width: 767.98px) {
    .pillnav--sticky {
      position: static;
      box-shadow: none;
    }
  }

  .pillnav__label {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--assured-text-dim);
    padding-left: 0.55rem;
  }

  /* Positioned wrapper for the edge fades; the list inside scrolls. */
  .pillnav__scroll {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  /* Scroll affordance: a fade plus chevron on whichever edge has more pills
     beyond it (data-overflow-start/-end, set by the script below).
     pointer-events: none keeps the pills under it clickable. */
  .pillnav__scroll::before,
  .pillnav__scroll::after {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2.5rem;
    display: flex;
    align-items: center;
    color: var(--assured-text-soft);
    font-size: 1.15rem;
    font-weight: 700;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s ease;
    z-index: 1;
  }

  .pillnav__scroll::before {
    content: "‹";
    left: 0;
    justify-content: flex-start;
    padding-left: 0.2rem;
    background: linear-gradient(to right, rgb(15, 23, 42) 35%, rgba(15, 23, 42, 0));
  }

  .pillnav__scroll::after {
    content: "›";
    right: 0;
    justify-content: flex-end;
    padding-right: 0.2rem;
    background: linear-gradient(to left, rgb(15, 23, 42) 35%, rgba(15, 23, 42, 0));
  }

  .pillnav__scroll[data-overflow-start]::before,
  .pillnav__scroll[data-overflow-end]::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .pillnav__scroll::before,
    .pillnav__scroll::after {
      transition: none;
    }
  }

  @media print {
    .pillnav__scroll::before,
    .pillnav__scroll::after {
      display: none;
    }
  }

  .pillnav__items {
    /* positioned so each pill's offsetLeft is measured inside the scroller */
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    min-width: 0;
    overflow-x: auto;
    /* Thin themed scrollbar instead of a hidden one: mouse users need a
       visible affordance that more pills sit off-screen (keyboard users get
       focus auto-scroll; touch users scroll natively). Nothing renders when
       the row fits. */
    scrollbar-width: thin;
    scrollbar-color: rgba(148, 163, 184, 0.35) transparent;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillnav__items > li {
    display: inline-flex;
    flex-shrink: 0;
  }

  .pillnav__items::-webkit-scrollbar { height: 6px; }
  .pillnav__items::-webkit-scrollbar-track { background: transparent; }
  .pillnav__items::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.35);
    border-radius: 9999px;
  }

  /* WCAG 2.5.5: 44px touch-target floor on touch devices. */
  @media (pointer: coarse) {
    .pillnav__item { min-height: 2.75rem; }
  }

  .pillnav__item {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--assured-text-muted);
    text-decoration: none;
    border-radius: 9999px;
    border: 1px solid transparent;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  /* The auto-appended chapter tail (Example / Transition / Quiz). Visually quieter than
   * the primary pillar links so the eye lands on the pillars first. */
  .pillnav__divider {
    flex-shrink: 0;
    color: rgba(148, 163, 184, 0.45);
    padding: 0 0.2rem;
    font-size: 0.85rem;
    user-select: none;
  }
  .pillnav__item--tail {
    color: var(--assured-text-dim);
    font-weight: 500;
    font-size: 0.78rem;
  }
  .pillnav__item--tail:hover {
    color: var(--assured-text-soft);
  }
  .pillnav__item--tail.is-current {
    color: var(--assured-accent-soft);
    background: rgba(20, 184, 166, 0.12);
  }

  .pillnav__item:hover {
    color: var(--assured-text);
    background: rgba(248, 250, 252, 0.06);
  }

  .pillnav__item.is-current {
    color: var(--assured-accent-soft);
    background: color-mix(in srgb, var(--assured-accent) 14%, transparent);
    border-color: color-mix(in srgb, var(--assured-accent) 50%, transparent);
  }

  /* Per-phase active accent, derived from the assured.css phase canon */
  .pillnav__item.is-current {
    background: color-mix(in srgb, var(--phase, var(--assured-accent)) 16%, transparent);
    border-color: color-mix(in srgb, var(--phase, var(--assured-accent)) 50%, transparent);
  }
  .pillnav__item.is-current.pillnav__item--alert        { --phase: var(--assured-phase-alert); color: var(--assured-phase-alert-soft); }
  .pillnav__item.is-current.pillnav__item--subject      { --phase: var(--assured-phase-subject); color: var(--assured-phase-subject-soft); }
  .pillnav__item.is-current.pillnav__item--scope        { --phase: var(--assured-phase-scope); color: var(--assured-phase-scope-soft); }
  .pillnav__item.is-current.pillnav__item--uncover      { --phase: var(--assured-phase-uncover); color: var(--assured-phase-uncover-soft); }
  .pillnav__item.is-current.pillnav__item--risk         { --phase: var(--assured-phase-risk); color: var(--assured-phase-risk-soft); }
  .pillnav__item.is-current.pillnav__item--escalation   { --phase: var(--assured-phase-escalation); color: var(--assured-phase-escalation-soft); }
  .pillnav__item.is-current.pillnav__item--documentation{ --phase: var(--assured-phase-documentation); color: var(--assured-phase-documentation-soft); }

  @media (max-width: 640px) {
    .pillnav {
      padding: 0.5rem 0.6rem;
      gap: 0.5rem;
      border-radius: 0.75rem;
    }
    .pillnav__label {
      display: none;
    }
  }
</style>

<script>
  import { onPageReady } from "@/lib/dom";

  function bindPillNavs() {
    document
      .querySelectorAll<HTMLElement>("[data-pillnav-scroll]:not([data-pillnav-bound])")
      .forEach((wrap) => {
        wrap.setAttribute("data-pillnav-bound", "true");
        const list = wrap.querySelector<HTMLElement>("[data-pillnav-items]");
        if (!list) return;

        const updateOverflow = () => {
          const max = list.scrollWidth - list.clientWidth;
          wrap.toggleAttribute("data-overflow-start", list.scrollLeft > 2);
          wrap.toggleAttribute("data-overflow-end", max - list.scrollLeft > 2);
        };

        // Bring the current pill into view, clear of the fade edges.
        // Scrolls the row only, never the page.
        const current = list.querySelector<HTMLElement>(".pillnav__item.is-current");
        if (current) {
          const pad = 44;
          const left = current.offsetLeft;
          const right = left + current.offsetWidth;
          if (right + pad > list.clientWidth) {
            list.scrollLeft = Math.max(0, right + pad - list.clientWidth);
          } else if (left - pad < list.scrollLeft) {
            list.scrollLeft = Math.max(0, left - pad);
          }
        }

        updateOverflow();
        list.addEventListener("scroll", updateOverflow, { passive: true });
        if (typeof ResizeObserver === "function") {
          new ResizeObserver(updateOverflow).observe(list);
        } else {
          globalThis.addEventListener("resize", updateOverflow, { passive: true });
        }
      });
  }

  onPageReady(bindPillNavs);
</script>
