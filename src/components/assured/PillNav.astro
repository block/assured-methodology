---
/**
 * PillNav. Horizontal pill row for peer-page navigation, e.g., the 6
 * Parsing sub-pages, each linking to its siblings. The current page is
 * derived from Astro.url.pathname and highlighted.
 *
 * Sticky on scroll so it stays accessible without forcing the reader back
 * to the top. Mobile: horizontal scroll if too wide.
 */

type Phase =
  | "alert"
  | "subject"
  | "scope"
  | "uncover"
  | "risk"
  | "escalation"
  | "documentation";

interface Item {
  label: string;
  href: string;
  phase?: string;
}

interface Props {
  label?: string;
  items: Item[];
  sticky?: boolean;
  /** When set, appends Example / Quiz / Transition links for the named chapter. */
  chapter?: Phase;
}

const { label = "Jump to", items, sticky = true, chapter } = Astro.props;

const pagePath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

/* Auto-appended links so every chapter sub-page surfaces its companion
 * Example / Quiz / Transition pages. The chapter sub-page authors don't
 * need to repeat these in every items={[...]} array. Documentation is the
 * last phase, so its closing page is Closure rather than Transition.
 */
const chapterTail: Item[] = chapter
  ? [
      {
        label: "Working example",
        href: `/docs/${chapter}/example/`,
        phase: chapter,
      },
      { label: "Chapter quiz", href: `/docs/${chapter}/quiz/`, phase: chapter },
      chapter === "documentation"
        ? {
            label: "Closure",
            href: "/docs/documentation/closure/",
            phase: chapter,
          }
        : {
            label: "Transition",
            href: `/docs/${chapter}/transition/`,
            phase: chapter,
          },
    ]
  : [];
---

<nav class={`pillnav ${sticky ? "pillnav--sticky" : ""}`} aria-label={label}>
  <span class="pillnav__label" aria-hidden="true">{label}</span>
  <ul class="pillnav__items">
    {items.map((item) => {
      const isCurrent = pagePath === item.href;
      return (
        <li>
          <a
            href={item.href}
            class={`pillnav__item ${isCurrent ? "is-current" : ""} ${item.phase ? `pillnav__item--${item.phase}` : ""}`}
            aria-current={isCurrent ? "page" : undefined}
          >
            {item.label}
          </a>
        </li>
      );
    })}
    {chapterTail.length > 0 && (
      <>
        <li aria-hidden="true" class="pillnav__divider">·</li>
        {chapterTail.map((item) => {
          const isCurrent = pagePath === item.href;
          return (
            <li>
              <a
                href={item.href}
                class={`pillnav__item pillnav__item--tail ${isCurrent ? "is-current" : ""} ${item.phase ? `pillnav__item--${item.phase}` : ""}`}
                aria-current={isCurrent ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </>
    )}
  </ul>
</nav>

<style>
  .pillnav {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0 0 2rem 0;
    padding: 0.6rem 0.85rem;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 9999px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
  }

  .pillnav--sticky {
    position: sticky;
    top: calc(var(--header-height) + 16px);
    z-index: 10;
    box-shadow: 0 10px 24px -16px rgba(0, 0, 0, 0.6);
  }

  .pillnav__label {
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--assured-text-dim);
    padding-left: 0.55rem;
  }

  .pillnav__items {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillnav__items > li {
    display: inline-flex;
    flex-shrink: 0;
  }

  .pillnav__items::-webkit-scrollbar { display: none; }

  .pillnav__item {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--assured-text-muted);
    text-decoration: none;
    border-radius: 9999px;
    border: 1px solid transparent;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  /* The auto-appended Example / Quiz / Transition tail. Visually quieter than
   * the primary pillar links so the eye lands on the pillars first. */
  .pillnav__divider {
    flex-shrink: 0;
    color: rgba(148, 163, 184, 0.45);
    padding: 0 0.2rem;
    font-size: 0.85rem;
    user-select: none;
  }
  .pillnav__item--tail {
    color: var(--assured-text-dim);
    font-weight: 500;
    font-size: 0.78rem;
  }
  .pillnav__item--tail:hover {
    color: var(--assured-text-soft);
  }
  .pillnav__item--tail.is-current {
    color: var(--assured-accent-soft);
    background: rgba(20, 184, 166, 0.12);
  }

  .pillnav__item:hover {
    color: var(--assured-text);
    background: rgba(248, 250, 252, 0.06);
  }

  .pillnav__item.is-current {
    color: var(--assured-accent-soft);
    background: color-mix(in srgb, var(--assured-accent) 14%, transparent);
    border-color: color-mix(in srgb, var(--assured-accent) 50%, transparent);
  }

  /* Per-phase active accent, derived from the assured.css phase canon */
  .pillnav__item.is-current {
    background: color-mix(in srgb, var(--phase, var(--assured-accent)) 16%, transparent);
    border-color: color-mix(in srgb, var(--phase, var(--assured-accent)) 50%, transparent);
  }
  .pillnav__item.is-current.pillnav__item--alert        { --phase: var(--assured-phase-alert); color: var(--assured-phase-alert-soft); }
  .pillnav__item.is-current.pillnav__item--subject      { --phase: var(--assured-phase-subject); color: var(--assured-phase-subject-soft); }
  .pillnav__item.is-current.pillnav__item--scope        { --phase: var(--assured-phase-scope); color: var(--assured-phase-scope-soft); }
  .pillnav__item.is-current.pillnav__item--uncover      { --phase: var(--assured-phase-uncover); color: var(--assured-phase-uncover-soft); }
  .pillnav__item.is-current.pillnav__item--risk         { --phase: var(--assured-phase-risk); color: var(--assured-phase-risk-soft); }
  .pillnav__item.is-current.pillnav__item--escalation   { --phase: var(--assured-phase-escalation); color: var(--assured-phase-escalation-soft); }
  .pillnav__item.is-current.pillnav__item--documentation{ --phase: var(--assured-phase-documentation); color: var(--assured-phase-documentation-soft); }

  @media (max-width: 640px) {
    .pillnav {
      padding: 0.5rem 0.6rem;
      gap: 0.5rem;
      border-radius: 0.75rem;
    }
    .pillnav__label {
      display: none;
    }
  }
</style>
