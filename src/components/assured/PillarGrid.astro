---
/**
 * PillarGrid. The "pillars" card grid on a chapter index page: one linked
 * card per pillar page, numbered, in the chapter's phase color.
 *
 * Replaces the hand-written <div class="pillars-grid"> blocks and their
 * per-page .pillar--<phase> and .pillar__num rules, so every chapter index
 * renders the same card from the phase tokens in src/styles/assured.css
 * (--assured-phase-<phase>, -soft). The number and CTA use the -soft
 * partner, which clears 4.5:1 on the panel for every phase.
 *
 * Usage in MDX:
 *   <PillarGrid
 *     phase="risk"
 *     items={[
 *       { href: "/docs/risk/impact-likelihood/", title: "Impact and likelihood", body: "..." },
 *       { href: "/docs/risk/framework/", title: "The priority matrix", body: "..." },
 *     ]}
 *   />
 *
 * `num` defaults to the item's position ("01", "02", ...); `cta` defaults to
 * "Read". `icon` is an optional decorative glyph, hidden from assistive tech:
 * one of the named outline icons below (rendered as an inline SVG in the
 * phase's -soft color), or any other string, rendered as text. Icon markup
 * comes only from the fixed map here, never from the caller.
 */

type Phase =
  | "alert"
  | "subject"
  | "scope"
  | "uncover"
  | "risk"
  | "escalation"
  | "documentation";

interface PillarItem {
  href: string;
  title: string;
  body: string;
  num?: string;
  icon?: string;
  cta?: string;
}

interface Props {
  phase: Phase;
  items: PillarItem[];
  /** Heading level of each card title. Default 3 (under the page's h2). */
  headingLevel?: 3 | 4;
}

// Lucide-style 24x24 outline paths, keyed by name.
const ICONS: Record<string, string> = {
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
  "circle-check":
    '<path d="M21.8 10A10 10 0 1 1 17 3.34"/><path d="m9 11 3 3L22 4"/>',
  wrench:
    '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  scale:
    '<path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/>',
  clock: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
  compass:
    '<circle cx="12" cy="12" r="10"/><path d="m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z"/>',
  building:
    '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/>',
};

const { phase, items, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h3" | "h4";
const columns = items.length % 3 === 0 ? 3 : 2;
const pad = (n: number) => String(n).padStart(2, "0");
---

<div
  class={`pillar-grid pillar-grid--cols-${columns}`}
  style={`--pg-accent: var(--assured-phase-${phase}); --pg-accent-soft: var(--assured-phase-${phase}-soft);`}
>
  {items.map((item, i) => (
    <a href={item.href} class="pillar-grid__card">
      <span class="pillar-grid__num" aria-hidden="true">{item.num ?? pad(i + 1)}</span>
      {item.icon && (
        <span class="pillar-grid__icon" aria-hidden="true">
          {ICONS[item.icon] ? (
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              focusable="false"
              set:html={ICONS[item.icon]}
            />
          ) : (
            item.icon
          )}
        </span>
      )}
      <Heading class="pillar-grid__title">{item.title}</Heading>
      <p class="pillar-grid__body">{item.body}</p>
      <span class="pillar-grid__cta">{item.cta ?? "Read"} <span aria-hidden="true">→</span></span>
    </a>
  ))}
</div>

<style>
  .pillar-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  @media (min-width: 768px) {
    .pillar-grid--cols-2 { grid-template-columns: repeat(2, 1fr); }
    .pillar-grid--cols-3 { grid-template-columns: repeat(3, 1fr); }
  }

  .pillar-grid__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem;
    background: var(--assured-panel);
    border: 1px solid color-mix(in srgb, var(--pg-accent) 30%, transparent);
    border-top: 3px solid var(--pg-accent);
    border-radius: 0.85rem;
    color: var(--assured-text);
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .pillar-grid__card:hover {
    border-color: var(--pg-accent);
  }

  .pillar-grid__card:focus-visible {
    outline: 2px solid var(--pg-accent-soft);
    outline-offset: 3px;
  }

  .pillar-grid__num {
    position: absolute;
    top: 1.25rem;
    right: 1.5rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: var(--pg-accent-soft);
  }

  .pillar-grid__icon {
    display: inline-flex;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--pg-accent-soft);
  }

  .pillar-grid__icon svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .pillar-grid__title {
    margin: 0;
    padding-right: 2rem;
    color: var(--assured-text);
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .pillar-grid__body {
    margin: 0;
    color: var(--assured-text-muted);
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .pillar-grid__cta {
    margin-top: auto;
    color: var(--pg-accent-soft);
    font-weight: 600;
    font-size: 0.9rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar-grid__card { transition: none; }
  }
</style>
