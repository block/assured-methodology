---
/**
 * PuzzleProgress, the seven-phase progress strip.
 *
 * One linked tile per A.S.S.U.R.E.D. letter, 7-across (4-across on small
 * screens), with the `current` phase highlighted. Phases whose chapter quiz
 * has been completed (recorded by Quiz.astro in localStorage under
 * "assured-quiz-progress") get a client-side completion tick. Despite the
 * name, the tiles are rounded rectangles; the interlocking jigsaw art lives
 * in HeroPuzzle.astro.
 */

interface Props {
  current?:
    | "alert"
    | "subject"
    | "scope"
    | "uncover"
    | "risk"
    | "escalation"
    | "documentation"
    | null;
  compact?: boolean;
}

const { current = null, compact = false } = Astro.props;

const phases = [
  { key: "alert", letter: "A", label: "Alert" },
  { key: "subject", letter: "S", label: "Subject" },
  { key: "scope", letter: "S", label: "Scope" },
  { key: "uncover", letter: "U", label: "Uncover" },
  { key: "risk", letter: "R", label: "Risk" },
  { key: "escalation", letter: "E", label: "Escalation" },
  { key: "documentation", letter: "D", label: "Documentation" },
] as const;
---

<nav aria-label="ASSURED methodology progress">
  <ul class={`puzzle ${compact ? "puzzle--compact" : ""}`}>
    {phases.map((p) => {
      const isCurrent = current === p.key;
      return (
        <li>
          <a
            href={`/docs/${p.key}/`}
            class={`puzzle__piece puzzle__piece--${p.key} ${isCurrent ? "is-current" : ""}`}
            aria-label={`${p.label} phase${isCurrent ? " (current)" : ""}`}
            aria-current={isCurrent ? "page" : undefined}
            data-puzzle-phase={p.key}
          >
            <span class="puzzle__letter">{p.letter}</span>
            <span class="puzzle__label">{p.label}</span>
            <span class="puzzle__check" data-puzzle-check aria-hidden="true" hidden>✓</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .puzzle {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.4rem;
    width: 100%;
    max-width: 56rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .puzzle > li {
    display: flex;
    min-width: 0;
  }

  .puzzle > li > .puzzle__piece {
    flex: 1;
  }

  @media (max-width: 640px) {
    .puzzle {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .puzzle__piece {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem 0.5rem;
    border-radius: 0.75rem;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.25);
    text-decoration: none;
    color: var(--assured-text);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    overflow: hidden;
    isolation: isolate;
    aspect-ratio: 1;
  }

  .puzzle--compact .puzzle__piece {
    padding: 0.5rem 0.35rem;
    border-radius: 0.5rem;
    aspect-ratio: auto;
  }

  .puzzle__piece::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--accent, transparent) 0%, transparent 70%);
    opacity: 0.18;
    z-index: -1;
    transition: opacity 0.2s ease;
  }

  .puzzle__piece:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.5);
    background: rgba(15, 23, 42, 0.7);
  }

  .puzzle__piece:hover::before { opacity: 0.4; }

  .puzzle__piece.is-done {
    border-color: rgba(20, 184, 166, 0.45);
  }

  .puzzle__check {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 9999px;
    background: rgba(20, 184, 166, 0.25);
    color: var(--assured-accent-soft);
    font-size: 0.65rem;
    font-weight: 800;
    line-height: 1;
  }

  .puzzle__check[hidden] {
    display: none;
  }

  .puzzle--compact .puzzle__check {
    top: 0.15rem;
    right: 0.15rem;
    width: 0.85rem;
    height: 0.85rem;
    font-size: 0.55rem;
  }

  .puzzle__piece.is-current {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 10px 30px -10px var(--accent);
  }

  .puzzle__piece.is-current::before { opacity: 0.5; }

  .puzzle__letter {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
  }

  .puzzle--compact .puzzle__letter {
    font-size: 1.25rem;
  }

  .puzzle__label {
    font-size: 0.75rem;
    margin-top: 0.4rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--assured-text-soft);
    text-align: center;
  }

  .puzzle--compact .puzzle__label {
    display: none;
  }

  /* Per-phase accent colors */
  .puzzle__piece--alert         { --accent: var(--assured-phase-alert); }
  .puzzle__piece--subject       { --accent: var(--assured-phase-subject); }
  .puzzle__piece--scope         { --accent: var(--assured-phase-scope); }
  .puzzle__piece--uncover       { --accent: var(--assured-phase-uncover); }
  .puzzle__piece--risk          { --accent: var(--assured-phase-risk); }
  .puzzle__piece--escalation    { --accent: var(--assured-phase-escalation); }
  .puzzle__piece--documentation { --accent: var(--assured-phase-documentation); }
</style>

<script>
  import { onPageReady } from "@/lib/dom";
  import { QUIZ_PROGRESS_EVENT, readQuizProgress } from "@/lib/progress";

  // Completion ticks. Quiz.astro records finished chapter quizzes via
  // @/lib/progress; this marks the matching tiles. Runs per page-load and
  // on every progress write, so the compact strip on a quiz's own page
  // (via ContinueCard) ticks the moment the quiz completes.
  function markCompletedPhases() {
    const progress = readQuizProgress();
    const tiles = document.querySelectorAll<HTMLAnchorElement>("[data-puzzle-phase]");
    tiles.forEach((tile) => {
      const phase = tile.getAttribute("data-puzzle-phase") ?? "";
      const done = Object.prototype.hasOwnProperty.call(progress, phase);
      tile.classList.toggle("is-done", done);
      const check = tile.querySelector<HTMLElement>("[data-puzzle-check]");
      if (check) check.hidden = !done;
      // Keep aria in sync without stacking suffixes across repeat runs.
      if (!tile.dataset.baseLabel) tile.dataset.baseLabel = tile.getAttribute("aria-label") ?? "";
      tile.setAttribute(
        "aria-label",
        done ? `${tile.dataset.baseLabel}, quiz completed` : tile.dataset.baseLabel,
      );
    });
  }
  onPageReady(markCompletedPhases);
  // Module scope, not inside a bind: processed scripts run once per browser
  // session, so this registers exactly one listener across navigations.
  window.addEventListener(QUIZ_PROGRESS_EVENT, markCompletedPhases);
</script>
