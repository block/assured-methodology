---
/**
 * PuzzleProgress, the seven-piece puzzle metaphor.
 *
 * Each letter of A.S.S.U.R.E.D. is a puzzle piece. Pieces "snap into place"
 * as you progress. The `current` prop highlights the active phase, and
 * `completed` is a count or list controlling which pieces appear assembled.
 *
 * This is the central visual identity of the methodology, assembling just
 * enough of the puzzle to know what an alert is.
 */

interface Props {
  current?: "alert" | "subject" | "scope" | "uncover" | "risk" | "escalation" | "documentation" | null;
  status?: Record<string, "live" | "soon">;
  compact?: boolean;
}

const { current = null, status = {}, compact = false } = Astro.props;

const phases = [
  { key: "alert",         letter: "A", label: "Alert" },
  { key: "subject",       letter: "S", label: "Subject" },
  { key: "scope",         letter: "S", label: "Scope" },
  { key: "uncover",       letter: "U", label: "Uncover" },
  { key: "risk",          letter: "R", label: "Risk" },
  { key: "escalation",    letter: "E", label: "Escalation" },
  { key: "documentation", letter: "D", label: "Documentation" },
] as const;
---

<div class={`puzzle ${compact ? "puzzle--compact" : ""}`} role="img" aria-label="ASSURED methodology puzzle progress">
  {phases.map((p) => {
    const state = status[p.key] ?? "live";
    const isCurrent = current === p.key;
    return (
      <a
        href={state === "live" ? `/docs/${p.key}` : "#"}
        class={`puzzle__piece puzzle__piece--${p.key} ${isCurrent ? "is-current" : ""} ${state === "soon" ? "is-soon" : ""}`}
        aria-label={`${p.label} phase${state === "soon" ? " (coming soon)" : ""}${isCurrent ? " (current)" : ""}`}
        data-state={state}
      >
        <span class="puzzle__letter">{p.letter}</span>
        <span class="puzzle__label">{p.label}</span>
        {state === "soon" && <span class="puzzle__soon" aria-hidden="true">soon</span>}
      </a>
    );
  })}
</div>

<style>
  .puzzle {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.4rem;
    width: 100%;
    max-width: 56rem;
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .puzzle {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .puzzle__piece {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem 0.5rem;
    border-radius: 0.75rem;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.25);
    text-decoration: none;
    color: #f8fafc;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    overflow: hidden;
    isolation: isolate;
    aspect-ratio: 1;
  }

  .puzzle--compact .puzzle__piece {
    padding: 0.5rem 0.35rem;
    border-radius: 0.5rem;
    aspect-ratio: auto;
  }

  .puzzle__piece::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--accent, transparent) 0%, transparent 70%);
    opacity: 0.18;
    z-index: -1;
    transition: opacity 0.2s ease;
  }

  .puzzle__piece:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.5);
    background: rgba(15, 23, 42, 0.7);
  }

  .puzzle__piece:hover::before { opacity: 0.4; }

  .puzzle__piece.is-current {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 10px 30px -10px var(--accent);
  }

  .puzzle__piece.is-current::before { opacity: 0.5; }

  .puzzle__piece.is-soon {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .puzzle__piece.is-soon:hover {
    transform: none;
    box-shadow: none;
  }

  .puzzle__letter {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
  }

  .puzzle--compact .puzzle__letter {
    font-size: 1.25rem;
  }

  .puzzle__label {
    font-size: 0.75rem;
    margin-top: 0.4rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #e2e8f0;
    text-align: center;
  }

  .puzzle--compact .puzzle__label {
    display: none;
  }

  .puzzle__soon {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #fbbf24;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.35);
    padding: 0.1rem 0.35rem;
    border-radius: 9999px;
    font-weight: 700;
  }

  /* Per-phase accent colors */
  .puzzle__piece--alert         { --accent: #3b82f6; }
  .puzzle__piece--subject       { --accent: #22c55e; }
  .puzzle__piece--scope         { --accent: #a855f7; }
  .puzzle__piece--uncover       { --accent: #f97316; }
  .puzzle__piece--risk          { --accent: #ef4444; }
  .puzzle__piece--escalation    { --accent: #6366f1; }
  .puzzle__piece--documentation { --accent: #06b6d4; }
</style>
