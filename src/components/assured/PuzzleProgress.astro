---
/**
 * PuzzleProgress, the seven-phase progress strip.
 *
 * One linked tile per A.S.S.U.R.E.D. letter, 7-across (4-across on small
 * screens), with the `current` phase highlighted. Despite the name, the
 * tiles are rounded rectangles; the interlocking jigsaw art lives in
 * HeroPuzzle.astro.
 */

interface Props {
  current?:
    | "alert"
    | "subject"
    | "scope"
    | "uncover"
    | "risk"
    | "escalation"
    | "documentation"
    | null;
  compact?: boolean;
}

const { current = null, compact = false } = Astro.props;

const phases = [
  { key: "alert", letter: "A", label: "Alert" },
  { key: "subject", letter: "S", label: "Subject" },
  { key: "scope", letter: "S", label: "Scope" },
  { key: "uncover", letter: "U", label: "Uncover" },
  { key: "risk", letter: "R", label: "Risk" },
  { key: "escalation", letter: "E", label: "Escalation" },
  { key: "documentation", letter: "D", label: "Documentation" },
] as const;
---

<nav aria-label="ASSURED methodology progress">
  <ul class={`puzzle ${compact ? "puzzle--compact" : ""}`}>
    {phases.map((p) => {
      const isCurrent = current === p.key;
      return (
        <li>
          <a
            href={`/docs/${p.key}`}
            class={`puzzle__piece puzzle__piece--${p.key} ${isCurrent ? "is-current" : ""}`}
            aria-label={`${p.label} phase${isCurrent ? " (current)" : ""}`}
            aria-current={isCurrent ? "page" : undefined}
          >
            <span class="puzzle__letter">{p.letter}</span>
            <span class="puzzle__label">{p.label}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .puzzle {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.4rem;
    width: 100%;
    max-width: 56rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .puzzle > li {
    display: flex;
    min-width: 0;
  }

  .puzzle > li > .puzzle__piece {
    flex: 1;
  }

  @media (max-width: 640px) {
    .puzzle {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .puzzle__piece {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem 0.5rem;
    border-radius: 0.75rem;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.25);
    text-decoration: none;
    color: #f8fafc;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    overflow: hidden;
    isolation: isolate;
    aspect-ratio: 1;
  }

  .puzzle--compact .puzzle__piece {
    padding: 0.5rem 0.35rem;
    border-radius: 0.5rem;
    aspect-ratio: auto;
  }

  .puzzle__piece::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--accent, transparent) 0%, transparent 70%);
    opacity: 0.18;
    z-index: -1;
    transition: opacity 0.2s ease;
  }

  .puzzle__piece:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.5);
    background: rgba(15, 23, 42, 0.7);
  }

  .puzzle__piece:hover::before { opacity: 0.4; }

  .puzzle__piece.is-current {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent), 0 10px 30px -10px var(--accent);
  }

  .puzzle__piece.is-current::before { opacity: 0.5; }

  .puzzle__letter {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
  }

  .puzzle--compact .puzzle__letter {
    font-size: 1.25rem;
  }

  .puzzle__label {
    font-size: 0.75rem;
    margin-top: 0.4rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #e2e8f0;
    text-align: center;
  }

  .puzzle--compact .puzzle__label {
    display: none;
  }

  /* Per-phase accent colors */
  .puzzle__piece--alert         { --accent: #3b82f6; }
  .puzzle__piece--subject       { --accent: #22c55e; }
  .puzzle__piece--scope         { --accent: #a855f7; }
  .puzzle__piece--uncover       { --accent: #f97316; }
  .puzzle__piece--risk          { --accent: #ef4444; }
  .puzzle__piece--escalation    { --accent: #6366f1; }
  .puzzle__piece--documentation { --accent: #06b6d4; }
</style>
