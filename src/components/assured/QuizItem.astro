---
/**
 * QuizItem. A single multiple-choice question rendered inside a <Quiz>.
 * Selecting an option marks correctness, shows the explanation, and
 * disables further changes for that question.
 *
 * Owns all per-item state. Notifies the parent Quiz via a bubbling
 * `quiz-item:answered` CustomEvent (detail: { correct, confidence }) and
 * resets when the item receives a `quiz-item:reset` event.
 *
 * Before answering, the reader may say how sure they are (High, Medium or
 * Low). It is optional and never blocks an answer; the parent Quiz uses it
 * for a calibration summary ("High: 5 of 6 correct"). Set
 * `askConfidence={false}` to drop the row.
 *
 * `source` names the section that teaches the point ({ href, label }). It
 * renders after the explanation as "Review: <link>", and the parent Quiz
 * lists it beside any item missed on the first try.
 *
 * Options render in authored order: answer keys were balanced across
 * positions by hand, so never shuffle them here.
 *
 * Each option may carry a `why`: one or two sentences on why that choice
 * is right or tempting-but-wrong. The selected option's `why` shows above
 * the shared `explanation`. Without JavaScript every `why` prints, labeled
 * with its option letter.
 */

import { stableId } from "@/lib/stable-id";

interface Option {
  value: string;
  label: string;
  /** Per-option feedback, shown when this option is selected. */
  why?: string;
}

interface Props {
  prompt: string;
  options: Option[];
  answer: string;
  explanation: string;
  hint?: string;
  /** The section that teaches this point, linked after the explanation. */
  source?: { href: string; label: string };
  /** Show the optional "How sure are you?" row. Default true. */
  askConfidence?: boolean;
}

const {
  prompt,
  options,
  answer,
  explanation,
  hint,
  source,
  askConfidence = true,
} = Astro.props;
const idBase = stableId("q", Astro.url.pathname);
const promptId = `${idBase}-prompt`;
const letterFor = (i: number) => String.fromCharCode(65 + i);
---

<div
  class="quiz-item"
  data-quiz-item
  data-answer={answer}
  data-source-href={source?.href}
  data-source-label={source?.label}
>
  {/* No-JS fallback (same pattern as ExampleStepper): the bind script is the
      only thing that unhides the feedback, so without it the explanation
      would be unreachable. Show it, plainly labeled, after the options.
      JS-enabled rendering is untouched: noscript content and styles never
      apply once scripts run. */}
  <noscript>
    <style is:inline>
      /* @layer base: global.css hides [hidden] with an !important rule
         inside @layer base, and layered !important beats unlayered
         !important, so an unlayered override here silently loses. Same
         layer, higher specificity wins. */
      @layer base {
        .quiz-item__feedback[hidden] { display: block !important; }
        .quiz-item__why[hidden] { display: block !important; }
      }
      .quiz-item__confidence { display: none !important; }
      .quiz-item__feedback [data-verdict] { display: none !important; }
      .quiz-item__feedback-label {
        display: inline-block;
        padding: 0.2rem 0.6rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 0.6rem;
        background: rgba(148, 163, 184, 0.18);
        color: #bfc9d6;
      }
    </style>
  </noscript>
  <p class="quiz-item__prompt" id={promptId}>{prompt}</p>

  {hint && (
    <details class="quiz-item__hint">
      <summary>Need a nudge?</summary>
      <p>{hint}</p>
    </details>
  )}

  {askConfidence && (
    <fieldset class="quiz-item__confidence" data-confidence>
      <legend class="quiz-item__confidence-legend">How sure are you? <span class="quiz-item__confidence-optional">(optional, before you answer)</span></legend>
      {["High", "Medium", "Low"].map((level) => (
        <label class="quiz-item__confidence-choice">
          <input type="radio" name={`${idBase}-confidence`} value={level.toLowerCase()} />
          <span>{level}</span>
        </label>
      ))}
    </fieldset>
  )}

  {/* role="group", not "radiogroup": the children are one-shot <button>s, not
      radios with checked state. A radiogroup announcing zero radios is an
      axe/Lighthouse failure; a labelled group of buttons is the honest pattern. */}
  <div class="quiz-item__options" role="group" aria-labelledby={promptId}>
    {options.map((o, i) => (
      <button
        type="button"
        class="quiz-item__option"
        data-value={o.value}
        data-letter={letterFor(i)}
        id={`${idBase}-${i}`}
      >
        <span class="quiz-item__option-letter">{letterFor(i)}</span>
        <span class="quiz-item__option-label">{o.label}</span>
        <span class="quiz-item__option-icon" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  {/* tabindex="-1": the script moves focus here after an answer so screen
      readers read the verdict + explanation; aria-live is the fallback for
      SRs that don't announce on focus. The verdict is real text set by the
      script, not CSS ::before content (which many SRs never voice). */}
  <div class="quiz-item__feedback" data-feedback hidden tabindex="-1" aria-live="polite">
    <div class="quiz-item__feedback-head">
      <span class="quiz-item__feedback-verdict" data-verdict></span>
      {/* Static label for the no-JS rendering; the styles live in the
          noscript block above so nothing leaks into the JS experience. */}
      <noscript><span class="quiz-item__feedback-label">Explanation</span></noscript>
    </div>
    {options.map((o, i) =>
      o.why ? (
        <p class="quiz-item__why" data-why-for={o.value} hidden>
          <span class="quiz-item__why-letter">{letterFor(i)}.</span> {o.why}
        </p>
      ) : null
    )}
    <p class="quiz-item__feedback-text">{explanation}</p>
    {source && (
      <p class="quiz-item__source">
        Review: <a href={source.href}>{source.label}</a>
      </p>
    )}
  </div>
</div>

<style>
  .quiz-item {
    padding: 1.5rem 1.75rem;
    background: var(--assured-panel);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 0.85rem;
  }

  .quiz-item__prompt {
    margin: 0 0 1.1rem 0;
    color: var(--assured-text);
    font-size: 1.05rem;
    line-height: 1.5;
    font-weight: 600;
    /* Prompts quote raw command lines (base64 and friends); wrap them
       rather than letting one token stretch the page sideways. */
    overflow-wrap: anywhere;
  }

  .quiz-item__hint {
    margin-bottom: 0.85rem;
    font-size: 0.85rem;
  }

  .quiz-item__hint summary {
    color: var(--assured-accent-soft);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
  }

  .quiz-item__hint summary::-webkit-details-marker { display: none; }

  .quiz-item__hint p {
    margin: 0.5rem 0 0 0;
    color: var(--assured-text-muted);
    line-height: 1.55;
    padding: 0.6rem 0.85rem;
    background: rgba(20, 184, 166, 0.08);
    border-left: 2px solid rgba(20, 184, 166, 0.5);
    border-radius: 0.3rem;
  }

  .quiz-item__options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .quiz-item__option {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.15rem;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 0.6rem;
    cursor: pointer;
    text-align: left;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    color: var(--assured-text-soft);
    font-family: inherit;
    font-size: 0.95rem;
    width: 100%;
  }

  .quiz-item__option:hover:not([aria-disabled="true"]) {
    transform: translateY(-1px);
    border-color: rgba(94, 234, 212, 0.5);
    background: rgba(15, 23, 42, 0.75);
  }

  .quiz-item__option[aria-disabled="true"] {
    cursor: default;
  }

  .quiz-item__option-letter {
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.4rem;
    background: rgba(148, 163, 184, 0.2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--assured-text-muted);
  }

  .quiz-item__option-label {
    flex: 1;
    line-height: 1.4;
  }

  .quiz-item__option-icon {
    width: 1.25rem;
    height: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Status colors come from the semantic success/danger tokens, never the
     Subject and Risk phase hues. White letters sit on the -deep shades
     (5.02:1 and 6.47:1; the base 500s gave 2.28:1 and 3.76:1), and the
     glyphs use the -soft tints. scripts/check-contrast.mjs measures both
     letter pairs. */
  .quiz-item__option.is-correct {
    border-color: var(--assured-success);
    background: rgba(34, 197, 94, 0.12);
  }
  .quiz-item__option.is-correct .quiz-item__option-letter {
    background: var(--assured-success-deep);
    color: white;
  }
  .quiz-item__option.is-correct .quiz-item__option-icon::after {
    content: "✓";
    color: var(--assured-success-soft);
    font-weight: 800;
    font-size: 1rem;
  }

  .quiz-item__option.is-wrong {
    border-color: var(--assured-danger);
    background: rgba(239, 68, 68, 0.10);
  }
  .quiz-item__option.is-wrong .quiz-item__option-letter {
    background: var(--assured-danger-deep);
    color: white;
  }
  .quiz-item__option.is-wrong .quiz-item__option-icon::after {
    content: "✕";
    color: var(--assured-danger-soft);
    font-weight: 800;
    font-size: 1rem;
  }

  .quiz-item__option.is-revealed-correct {
    border-color: rgba(34, 197, 94, 0.4);
    background: rgba(34, 197, 94, 0.06);
  }
  .quiz-item__option.is-revealed-correct .quiz-item__option-icon::after {
    content: "←";
    color: var(--assured-accent-soft);
    font-weight: 700;
  }

  .quiz-item__feedback {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 0.6rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.25);
  }

  .quiz-item__feedback.is-correct {
    border-color: rgba(34, 197, 94, 0.4);
    background: rgba(34, 197, 94, 0.06);
  }

  .quiz-item__feedback.is-wrong {
    border-color: rgba(239, 68, 68, 0.4);
    background: rgba(239, 68, 68, 0.06);
  }

  .quiz-item__feedback-verdict {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .quiz-item__feedback.is-correct .quiz-item__feedback-verdict {
    background: rgba(34, 197, 94, 0.18);
    color: var(--assured-success-soft);
  }

  .quiz-item__feedback.is-wrong .quiz-item__feedback-verdict {
    background: rgba(239, 68, 68, 0.18);
    color: var(--assured-danger-soft);
  }

  /* The verdict is a pill when it reads "Correct"; the wrong-answer verdict
     names the right option, so let that one wrap as a sentence. */
  .quiz-item__feedback.is-wrong .quiz-item__feedback-verdict {
    border-radius: 0.5rem;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.85rem;
  }

  .quiz-item__why {
    margin: 0 0 0.6rem 0;
    padding: 0 0 0.6rem 0;
    border-bottom: 1px solid rgba(148, 163, 184, 0.18);
    color: var(--assured-text-soft);
    line-height: 1.6;
    font-size: 0.93rem;
  }

  .quiz-item__why-letter {
    font-weight: 700;
    color: var(--assured-text);
  }

  .quiz-item__feedback-text {
    margin: 0;
    color: var(--assured-text-soft);
    line-height: 1.6;
    font-size: 0.93rem;
  }

  .quiz-item__source {
    margin: 0.6rem 0 0;
    color: var(--assured-text-soft);
    font-size: 0.88rem;
  }

  .quiz-item__source a {
    color: var(--assured-accent-soft);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .quiz-item__confidence {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.9rem;
    margin: 0 0 0.85rem;
    padding: 0;
    border: 0;
    font-size: 0.85rem;
    color: var(--assured-text-soft);
  }

  .quiz-item__confidence-legend {
    float: left;
    margin-right: 0.4rem;
    padding: 0;
    font-weight: 600;
    color: var(--assured-text-soft);
  }

  .quiz-item__confidence-optional {
    font-weight: 400;
    color: var(--assured-text-muted);
  }

  .quiz-item__confidence-choice {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    cursor: pointer;
  }

  .quiz-item__confidence-choice input {
    accent-color: var(--assured-accent);
  }

  .quiz-item__confidence:disabled {
    opacity: 0.75;
  }

  .quiz-item__confidence:disabled .quiz-item__confidence-choice {
    cursor: default;
  }

  /* Collapse this component's share of the nested padding chain on small
     screens (see the matching breakpoint in Quiz.astro). */
  @media (max-width: 640px) {
    .quiz-item {
      padding: 1.1rem 0.8rem;
    }
    .quiz-item__option {
      padding: 0.7rem 0.7rem;
      gap: 0.6rem;
    }
    .quiz-item__feedback {
      padding: 0.85rem 0.9rem;
    }
  }
</style>

<script>
  import { onPageReady } from "@/lib/dom";

  // ClientRouter idempotency: per-item data-quizitem-bound marker.
  function bindQuizItems() {
    const items = document.querySelectorAll<HTMLElement>(
      "[data-quiz-item]:not([data-quizitem-bound])"
    );
    items.forEach((item) => {
      item.setAttribute("data-quizitem-bound", "true");
      const correctValue = item.dataset.answer;
      const options = Array.from(item.querySelectorAll<HTMLButtonElement>(".quiz-item__option"));
      const feedback = item.querySelector<HTMLElement>("[data-feedback]");
      const whys = Array.from(item.querySelectorAll<HTMLElement>("[data-why-for]"));
      const correctOption = options.find((o) => o.dataset.value === correctValue);
      const confidenceSet = item.querySelector<HTMLFieldSetElement>("[data-confidence]");

      options.forEach((option) => {
        option.addEventListener("click", () => {
          if (item.dataset.answered === "true") return;
          item.dataset.answered = "true";

          const value = option.dataset.value;
          const isCorrect = value === correctValue;

          // Lock the options with aria-disabled, not the disabled property:
          // native disabled yanks focus off the just-clicked button and drops
          // keyboard users back to <body>.
          options.forEach((o) => {
            o.setAttribute("aria-disabled", "true");
            if (o.dataset.value === correctValue && o !== option) {
              o.classList.add("is-revealed-correct");
            }
          });

          option.classList.add(isCorrect ? "is-correct" : "is-wrong");

          // Freeze the confidence row: it records how sure the reader was
          // before seeing the verdict.
          const confidence =
            confidenceSet?.querySelector<HTMLInputElement>("input:checked")?.value ?? null;
          if (confidenceSet) confidenceSet.disabled = true;

          if (feedback) {
            const verdict = feedback.querySelector<HTMLElement>("[data-verdict]");
            // The correct option is otherwise marked only by color and an
            // aria-hidden glyph, so the spoken verdict names it.
            if (verdict) {
              const label = correctOption
                ?.querySelector(".quiz-item__option-label")
                ?.textContent?.trim();
              verdict.textContent = isCorrect
                ? "Correct"
                : correctOption && label
                  ? `Not quite. The answer is ${correctOption.dataset.letter}: ${label}`
                  : "Not quite";
            }
            whys.forEach((w) => {
              w.hidden = w.dataset.whyFor !== value;
            });
            feedback.hidden = false;
            feedback.classList.add(isCorrect ? "is-correct" : "is-wrong");
            feedback.focus();
          }

          item.dispatchEvent(
            new CustomEvent("quiz-item:answered", {
              bubbles: true,
              detail: { correct: isCorrect, confidence },
            })
          );
        });
      });

      item.addEventListener("quiz-item:reset", () => {
        delete item.dataset.answered;
        options.forEach((o) => {
          o.removeAttribute("aria-disabled");
          o.classList.remove("is-correct", "is-wrong", "is-revealed-correct");
        });
        whys.forEach((w) => {
          w.hidden = true;
        });
        if (confidenceSet) {
          confidenceSet.disabled = false;
          confidenceSet.querySelectorAll<HTMLInputElement>("input").forEach((r) => {
            r.checked = false;
          });
        }
        if (feedback) {
          feedback.hidden = true;
          feedback.classList.remove("is-correct", "is-wrong");
        }
      });
    });
  }
  onPageReady(bindQuizItems);
</script>
