---
/**
 * QuizItem. A single multiple-choice question rendered inside a <Quiz>.
 * Selecting an option marks correctness, shows the explanation, and
 * disables further changes for that question.
 *
 * Owns all per-item state. Notifies the parent Quiz via a bubbling
 * `quiz-item:answered` CustomEvent (detail: { correct }) and resets when
 * the item receives a `quiz-item:reset` event.
 */

interface Option {
  value: string;
  label: string;
}

interface Props {
  prompt: string;
  options: Option[];
  answer: string;
  explanation: string;
  hint?: string;
}

const { prompt, options, answer, explanation, hint } = Astro.props;
const idBase = `q-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="quiz-item" data-quiz-item data-answer={answer}>
  <p class="quiz-item__prompt">{prompt}</p>

  {hint && (
    <details class="quiz-item__hint">
      <summary>Need a nudge?</summary>
      <p>{hint}</p>
    </details>
  )}

  {/* role="group", not "radiogroup": the children are one-shot <button>s, not
      radios with checked state. A radiogroup announcing zero radios is an
      axe/Lighthouse failure; a labelled group of buttons is the honest pattern. */}
  <div class="quiz-item__options" role="group" aria-label={prompt}>
    {options.map((o, i) => (
      <button
        type="button"
        class="quiz-item__option"
        data-value={o.value}
        id={`${idBase}-${i}`}
      >
        <span class="quiz-item__option-letter">{String.fromCharCode(65 + i)}</span>
        <span class="quiz-item__option-label">{o.label}</span>
        <span class="quiz-item__option-icon" aria-hidden="true"></span>
      </button>
    ))}
  </div>

  {/* tabindex="-1": the script moves focus here after an answer so screen
      readers read the verdict + explanation; aria-live is the fallback for
      SRs that don't announce on focus. The verdict is real text set by the
      script, not CSS ::before content (which many SRs never voice). */}
  <div class="quiz-item__feedback" data-feedback hidden tabindex="-1" aria-live="polite">
    <div class="quiz-item__feedback-head">
      <span class="quiz-item__feedback-verdict" data-verdict></span>
    </div>
    <p class="quiz-item__feedback-text">{explanation}</p>
  </div>
</div>

<style>
  .quiz-item {
    padding: 1.5rem 1.75rem;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 0.85rem;
  }

  .quiz-item__prompt {
    margin: 0 0 1.1rem 0;
    color: var(--assured-text);
    font-size: 1.05rem;
    line-height: 1.5;
    font-weight: 600;
    /* Prompts quote raw command lines (base64 and friends); wrap them
       rather than letting one token stretch the page sideways. */
    overflow-wrap: anywhere;
  }

  .quiz-item__hint {
    margin-bottom: 0.85rem;
    font-size: 0.85rem;
  }

  .quiz-item__hint summary {
    color: var(--assured-accent-soft);
    cursor: pointer;
    font-weight: 600;
    user-select: none;
  }

  .quiz-item__hint summary::-webkit-details-marker { display: none; }

  .quiz-item__hint p {
    margin: 0.5rem 0 0 0;
    color: var(--assured-text-muted);
    line-height: 1.55;
    padding: 0.6rem 0.85rem;
    background: rgba(20, 184, 166, 0.08);
    border-left: 2px solid rgba(20, 184, 166, 0.5);
    border-radius: 0.3rem;
  }

  .quiz-item__options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .quiz-item__option {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.15rem;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 0.6rem;
    cursor: pointer;
    text-align: left;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    color: var(--assured-text-soft);
    font-family: inherit;
    font-size: 0.95rem;
    width: 100%;
  }

  .quiz-item__option:hover:not([aria-disabled="true"]) {
    transform: translateY(-1px);
    border-color: rgba(94, 234, 212, 0.5);
    background: rgba(15, 23, 42, 0.75);
  }

  .quiz-item__option[aria-disabled="true"] {
    cursor: default;
  }

  .quiz-item__option-letter {
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.4rem;
    background: rgba(148, 163, 184, 0.2);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--assured-text-muted);
  }

  .quiz-item__option-label {
    flex: 1;
    line-height: 1.4;
  }

  .quiz-item__option-icon {
    width: 1.25rem;
    height: 1.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .quiz-item__option.is-correct {
    border-color: #22c55e;
    background: rgba(34, 197, 94, 0.12);
  }
  .quiz-item__option.is-correct .quiz-item__option-letter {
    background: #22c55e;
    color: white;
  }
  .quiz-item__option.is-correct .quiz-item__option-icon::after {
    content: "✓";
    color: #22c55e;
    font-weight: 800;
    font-size: 1rem;
  }

  .quiz-item__option.is-wrong {
    border-color: #ef4444;
    background: rgba(239, 68, 68, 0.10);
  }
  .quiz-item__option.is-wrong .quiz-item__option-letter {
    background: #ef4444;
    color: white;
  }
  .quiz-item__option.is-wrong .quiz-item__option-icon::after {
    content: "✕";
    color: #ef4444;
    font-weight: 800;
    font-size: 1rem;
  }

  .quiz-item__option.is-revealed-correct {
    border-color: rgba(34, 197, 94, 0.4);
    background: rgba(34, 197, 94, 0.06);
  }
  .quiz-item__option.is-revealed-correct .quiz-item__option-icon::after {
    content: "←";
    color: var(--assured-accent-soft);
    font-weight: 700;
  }

  .quiz-item__feedback {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 0.6rem;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(148, 163, 184, 0.25);
  }

  .quiz-item__feedback.is-correct {
    border-color: rgba(34, 197, 94, 0.4);
    background: rgba(34, 197, 94, 0.06);
  }

  .quiz-item__feedback.is-wrong {
    border-color: rgba(239, 68, 68, 0.4);
    background: rgba(239, 68, 68, 0.06);
  }

  .quiz-item__feedback-verdict {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .quiz-item__feedback.is-correct .quiz-item__feedback-verdict {
    background: rgba(34, 197, 94, 0.18);
    color: #86efac;
  }

  .quiz-item__feedback.is-wrong .quiz-item__feedback-verdict {
    background: rgba(239, 68, 68, 0.18);
    color: #fca5a5;
  }

  .quiz-item__feedback-text {
    margin: 0;
    color: var(--assured-text-soft);
    line-height: 1.6;
    font-size: 0.93rem;
  }

  /* Collapse this component's share of the nested padding chain on small
     screens (see the matching breakpoint in Quiz.astro). */
  @media (max-width: 640px) {
    .quiz-item {
      padding: 1.1rem 0.8rem;
    }
    .quiz-item__option {
      padding: 0.7rem 0.7rem;
      gap: 0.6rem;
    }
    .quiz-item__feedback {
      padding: 0.85rem 0.9rem;
    }
  }
</style>

<script>
  import { onPageReady } from "@/lib/dom";

  // ClientRouter idempotency: per-item data-quizitem-bound marker.
  function bindQuizItems() {
    const items = document.querySelectorAll<HTMLElement>(
      "[data-quiz-item]:not([data-quizitem-bound])"
    );
    items.forEach((item) => {
      item.setAttribute("data-quizitem-bound", "true");
      const correctValue = item.dataset.answer;
      const options = Array.from(item.querySelectorAll<HTMLButtonElement>(".quiz-item__option"));
      const feedback = item.querySelector<HTMLElement>("[data-feedback]");

      options.forEach((option) => {
        option.addEventListener("click", () => {
          if (item.dataset.answered === "true") return;
          item.dataset.answered = "true";

          const value = option.dataset.value;
          const isCorrect = value === correctValue;

          // Lock the options with aria-disabled, not the disabled property:
          // native disabled yanks focus off the just-clicked button and drops
          // keyboard users back to <body>.
          options.forEach((o) => {
            o.setAttribute("aria-disabled", "true");
            if (o.dataset.value === correctValue && o !== option) {
              o.classList.add("is-revealed-correct");
            }
          });

          option.classList.add(isCorrect ? "is-correct" : "is-wrong");

          if (feedback) {
            const verdict = feedback.querySelector<HTMLElement>("[data-verdict]");
            if (verdict) verdict.textContent = isCorrect ? "Correct" : "Not quite";
            feedback.hidden = false;
            feedback.classList.add(isCorrect ? "is-correct" : "is-wrong");
            feedback.focus();
          }

          item.dispatchEvent(
            new CustomEvent("quiz-item:answered", {
              bubbles: true,
              detail: { correct: isCorrect },
            })
          );
        });
      });

      item.addEventListener("quiz-item:reset", () => {
        delete item.dataset.answered;
        options.forEach((o) => {
          o.removeAttribute("aria-disabled");
          o.classList.remove("is-correct", "is-wrong", "is-revealed-correct");
        });
        if (feedback) {
          feedback.hidden = true;
          feedback.classList.remove("is-correct", "is-wrong");
        }
      });
    });
  }
  onPageReady(bindQuizItems);
</script>
