---
/**
 * Reveal. Click-to-expand panel.
 *
 * Built on native <details>/<summary> for accessibility and works without
 * JavaScript. Styled to look like a deliberate UI affordance rather than a
 * bare disclosure widget.
 *
 * Usage in MDX:
 *   <Reveal summary="Show the worked example">
 *     ...content...
 *   </Reveal>
 */

interface Props {
  summary: string;
  variant?: "default" | "example" | "deep-dive";
  open?: boolean;
}

const { summary, variant = "default", open = false } = Astro.props;
---

<details class={`reveal reveal--${variant}`} open={open}>
  <summary class="reveal__summary">
    <span class="reveal__icon" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </span>
    <span class="reveal__label">{summary}</span>
  </summary>
  <div class="reveal__body">
    <slot />
  </div>
</details>

<style>
  .reveal {
    margin: 1.25rem 0;
    border-radius: 0.75rem;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.25);
    overflow: hidden;
    backdrop-filter: blur(8px);
    transition: border-color 0.2s ease;
  }

  .reveal[open] {
    border-color: rgba(94, 234, 212, 0.4);
  }

  .reveal__summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.25rem;
    cursor: pointer;
    list-style: none;
    color: var(--assured-text);
    font-weight: 600;
    font-size: 0.95rem;
    transition: background 0.15s ease;
    user-select: none;
  }

  .reveal__summary::-webkit-details-marker { display: none; }
  .reveal__summary::marker { content: ""; }

  .reveal__summary:hover {
    background: rgba(248, 250, 252, 0.04);
  }

  .reveal__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--assured-accent-soft);
    transition: transform 0.2s ease;
  }

  .reveal[open] .reveal__icon {
    transform: rotate(90deg);
  }

  .reveal__body {
    padding: 0 1.25rem 1.25rem;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
    padding-top: 1.1rem;
    color: var(--assured-text-muted);
    line-height: 1.65;
  }

  .reveal__body :first-child { margin-top: 0; }
  .reveal__body :last-child { margin-bottom: 0; }

  /* Variants */
  .reveal--example {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.08), rgba(15, 23, 42, 0.55));
    border-color: rgba(168, 85, 247, 0.3);
  }

  .reveal--example[open] {
    border-color: rgba(168, 85, 247, 0.55);
  }

  .reveal--example .reveal__icon {
    color: #c4b5fd;
  }

  .reveal--deep-dive {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(15, 23, 42, 0.55));
    border-color: rgba(59, 130, 246, 0.3);
  }

  .reveal--deep-dive[open] {
    border-color: rgba(59, 130, 246, 0.55);
  }

  .reveal--deep-dive .reveal__icon {
    color: #93c5fd;
  }
</style>
