---
/**
 * Stat, large value + label. For hero/quick-facts grids.
 */

interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="assured-stat">
  <div class="assured-stat__value">{value}</div>
  <div class="assured-stat__label">{label}</div>
</div>
