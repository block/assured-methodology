---
/**
 * StrengthsLimitations, replaces the previous table format with an
 * accessible, mobile-friendly grid of pros and cons.
 *
 * Accepts strengths and limitations as string arrays.
 */

interface Props {
  strengths: string[];
  limitations: string[];
}

const { strengths, limitations } = Astro.props;
---

<div class="assured-pros-cons">
  <div class="assured-pros-cons__col assured-pros-cons__col--pro">
    <h4 class="assured-pros-cons__heading">Strengths</h4>
    <ul>
      {strengths.map((item) => <li>{item}</li>)}
    </ul>
  </div>
  <div class="assured-pros-cons__col assured-pros-cons__col--con">
    <h4 class="assured-pros-cons__heading">Limitations</h4>
    <ul>
      {limitations.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</div>
