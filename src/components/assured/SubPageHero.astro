---
/**
 * SubPageHero. Context box that sits below the layout's h1 page title.
 *
 * Renders the chapter's letter chip, a pillar/section badge, and a lede
 * paragraph, inside a <header> (it introduces the page; it is not
 * tangential content, so not an <aside>). The page title itself is
 * rendered by ContentPageLayout as h1, and the way back to the chapter is
 * the layout's breadcrumb trail, so the hero carries no link of its own
 * unless chapterHref points somewhere the breadcrumbs do not (a related
 * chapter page).
 */

import LetterChip from "@/components/assured/LetterChip.astro";
import {
  findNavItem,
  groupPosition,
  isInTrail,
  type PhaseKey,
  phaseInfo,
  pillarPosition,
} from "@/data/navigation";

interface Props {
  phase: PhaseKey;
  /** Defaults to the phase letter. */
  parentLetter?: string;
  /** Badge override. Pillar pages need nothing: "Pillar N of M" is derived
   *  from src/data/navigation.ts, and so is "NN of MM" for a page in a
   *  plain navigation group (the Reading telemetry pages). Chapter
   *  companions default to "Companion". Non-numeric labels (e.g.
   *  "Example") render as-is; a numeric "NN of MM" is ignored when the
   *  navigation can supply the position. */
  pillarIndex?: string;
  /** Legacy total for a numeric pillarIndex on a page navigation does not
   *  list as a pillar. */
  pillarTotal?: string;
  /** Related link target. Defaults to the chapter index, which the
   *  breadcrumbs already carry, so by default no link renders. */
  chapterHref?: string;
  chapterLabel?: string;
  lede?: string;
}

const { phase, pillarIndex, pillarTotal, lede } = Astro.props;
const info = phaseInfo(phase);
const parentLetter = Astro.props.parentLetter ?? info.letter;
const chapterHref = Astro.props.chapterHref ?? info.href;
const chapterLabel = Astro.props.chapterLabel ?? info.name;

const pagePath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const position = pillarPosition(pagePath);
const group = position ? undefined : groupPosition(pagePath);
const navEntry = findNavItem(pagePath);
const pad = (n: number) => String(n).padStart(2, "0");

const label = pillarIndex?.trim();
const numericLabel = !!label && /^\d+(\s+of\s+\d+)?$/.test(label);
const badge = position
  ? `Pillar ${pad(position.index)} of ${pad(position.total)}`
  : label && !numericLabel
    ? label
    : group
      ? `${pad(group.index)} of ${pad(group.total)}`
      : label && /^\d+$/.test(label)
        ? `Pillar ${label} of ${pillarTotal ?? ""}`
        : (label ?? (navEntry?.kind === "companion" ? "Companion" : ""));

// Only link out when the target is not already in the breadcrumb trail.
const relatedHref = isInTrail(pagePath, chapterHref) ? null : chapterHref;
---

<header class={`subpage-hero subpage-hero--${phase}`}>
  <div class="subpage-hero__top">
    <LetterChip letter={parentLetter} phase={phase} size="sm" />
    {relatedHref && (
      <a href={relatedHref} class="subpage-hero__crumb">
        <span class="subpage-hero__crumb-text">
          {chapterLabel}
          <span class="subpage-hero__crumb-arrow" aria-hidden="true">›</span>
        </span>
      </a>
    )}
    {badge && <span class="subpage-hero__pillar">{badge}</span>}
  </div>

  {lede && <p class="subpage-hero__lede">{lede}</p>}
</header>

<style>
  .subpage-hero {
    margin: -0.75rem 0 1.75rem;
    padding: 1.1rem 1.5rem 1.25rem;
    border-radius: 0.85rem;
    background: var(--assured-panel-solid);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-left: 4px solid var(--accent, var(--assured-accent));
    position: relative;
    overflow: hidden;
  }

  .subpage-hero::before {
    content: "";
    position: absolute;
    top: -30%;
    right: -10%;
    width: 50%;
    height: 160%;
    background: radial-gradient(circle, var(--accent-glow, rgba(20, 184, 166, 0.12)), transparent 60%);
    pointer-events: none;
  }

  /* --accent colors the border/decoration; --accent-text is the 300-level
     soft token reserved for text, so the 0.7rem pillar chip holds >= 4.5:1
     (WCAG 2.2 SC 1.4.3) at both gradient extremes (#334155 / #0f172a). Base
     500s measured 3.23-4.00:1 for escalation/scope/risk. */
  .subpage-hero--alert         { --accent: var(--assured-phase-alert); --accent-text: var(--assured-phase-alert-soft); }
  .subpage-hero--subject       { --accent: var(--assured-phase-subject); --accent-text: var(--assured-phase-subject-soft); }
  .subpage-hero--scope         { --accent: var(--assured-phase-scope); --accent-text: var(--assured-phase-scope-soft); }
  .subpage-hero--uncover       { --accent: var(--assured-phase-uncover); --accent-text: var(--assured-phase-uncover-soft); }
  .subpage-hero--risk          { --accent: var(--assured-phase-risk); --accent-text: var(--assured-phase-risk-soft); }
  .subpage-hero--escalation    { --accent: var(--assured-phase-escalation); --accent-text: var(--assured-phase-escalation-soft); }
  .subpage-hero--documentation { --accent: var(--assured-phase-documentation); --accent-text: var(--assured-phase-documentation-soft); }

  .subpage-hero { --accent-glow: color-mix(in srgb, var(--accent, var(--assured-accent)) 14%, transparent); }

  .subpage-hero__top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 0.75rem;
    position: relative;
  }

  .subpage-hero__crumb {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .subpage-hero__crumb:hover { opacity: 0.85; }

  .subpage-hero__crumb-text {
    color: var(--assured-text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .subpage-hero__crumb-arrow {
    color: var(--accent);
    font-size: 1rem;
    font-weight: 700;
  }

  .subpage-hero__pillar {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid var(--accent);
    color: var(--accent-text, var(--accent));
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .subpage-hero__pillar { margin-left: 0; }
  }

  .subpage-hero__lede {
    margin: 0;
    color: var(--assured-text-muted);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 60ch;
    position: relative;
  }
</style>
