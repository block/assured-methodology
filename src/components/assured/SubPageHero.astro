---
/**
 * SubPageHero. Context box that sits below the layout's h1 page title.
 *
 * Renders the breadcrumb back to the chapter, a pillar/section badge, and
 * a lede paragraph. The page title itself is rendered by ContentPageLayout
 * as h1. SubPageHero adds context, not a duplicate title.
 */

import LetterChip from "@/components/assured/LetterChip.astro";

type Phase =
  | "alert"
  | "subject"
  | "scope"
  | "uncover"
  | "risk"
  | "escalation"
  | "documentation";

interface Props {
  phase: Phase;
  parentLetter: string;
  /** Current pillar position. Number-like strings render as
   *  "Pillar N of M"; non-numeric labels (e.g. "Example") render as-is. */
  pillarIndex?: string;
  /** Total pillars in this chapter (e.g. "04"). */
  pillarTotal?: string;
  chapterHref: string;
  chapterLabel: string;
  lede?: string;
}

const {
  phase,
  parentLetter,
  pillarIndex,
  pillarTotal,
  chapterHref,
  chapterLabel,
  lede,
} = Astro.props;

const resolvedIndex = pillarIndex ?? "";
const resolvedTotal = pillarTotal ?? "";
---

<aside class={`subpage-hero subpage-hero--${phase}`}>
  <div class="subpage-hero__top">
    <a href={chapterHref} class="subpage-hero__crumb">
      <LetterChip letter={parentLetter} phase={phase} size="sm" />
      <span class="subpage-hero__crumb-text">
        {chapterLabel}
        <span class="subpage-hero__crumb-arrow" aria-hidden="true">›</span>
      </span>
    </a>
    <span class="subpage-hero__pillar">
      {/^\d+$/.test(resolvedIndex.trim())
        ? `Pillar ${resolvedIndex} of ${resolvedTotal}`
        : resolvedIndex}
    </span>
  </div>

  {lede && <p class="subpage-hero__lede">{lede}</p>}
</aside>

<style>
  .subpage-hero {
    margin: -0.75rem 0 1.75rem;
    padding: 1.1rem 1.5rem 1.25rem;
    border-radius: 0.85rem;
    background: rgba(15, 23, 42, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-left: 4px solid var(--accent, #14b8a6);
    backdrop-filter: blur(8px);
    position: relative;
    overflow: hidden;
  }

  .subpage-hero::before {
    content: "";
    position: absolute;
    top: -30%;
    right: -10%;
    width: 50%;
    height: 160%;
    background: radial-gradient(circle, var(--accent-glow, rgba(20, 184, 166, 0.12)), transparent 60%);
    pointer-events: none;
  }

  .subpage-hero--alert         { --accent: #3b82f6; --accent-glow: rgba(59, 130, 246, 0.14); }
  .subpage-hero--subject       { --accent: #22c55e; --accent-glow: rgba(34, 197, 94, 0.14); }
  .subpage-hero--scope         { --accent: #a855f7; --accent-glow: rgba(168, 85, 247, 0.14); }
  .subpage-hero--uncover       { --accent: #f97316; --accent-glow: rgba(249, 115, 22, 0.14); }
  .subpage-hero--risk          { --accent: #ef4444; --accent-glow: rgba(239, 68, 68, 0.14); }
  .subpage-hero--escalation    { --accent: #6366f1; --accent-glow: rgba(99, 102, 241, 0.14); }
  .subpage-hero--documentation { --accent: #14b8a6; --accent-glow: rgba(20, 184, 166, 0.14); }

  .subpage-hero__top {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 0.75rem;
    position: relative;
  }

  .subpage-hero__crumb {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .subpage-hero__crumb:hover { opacity: 0.85; }

  .subpage-hero__crumb-text {
    color: #cbd5e1;
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .subpage-hero__crumb-arrow {
    color: var(--accent);
    font-size: 1rem;
    font-weight: 700;
  }

  .subpage-hero__pillar {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-left: auto;
  }

  @media (max-width: 640px) {
    .subpage-hero__pillar { margin-left: 0; }
  }

  .subpage-hero__lede {
    margin: 0;
    color: #cbd5e1;
    font-size: 1rem;
    line-height: 1.65;
    max-width: 60ch;
    position: relative;
  }
</style>
