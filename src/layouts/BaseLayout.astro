---
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import HeadSEO from "@/components/HeadSEO.astro";
// Variable fonts (OFL-licensed, self-hosted via Fontsource). One file per
// family covers weights 100-900; unicode-range subsetting means browsers
// only fetch the latin subset for this site.
import "@fontsource-variable/inter";
import "@fontsource-variable/inter/wght-italic.css";
import "@fontsource-variable/jetbrains-mono";
// Preload the one render-critical font file (Inter latin, upright) so the
// fetch starts with the HTML instead of after the CSS that declares the
// @font-face. ?url resolves to the hashed /_astro/ URL of the same file the
// Fontsource CSS references, so the preload and @font-face always agree.
import interLatinWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "@/styles/global.css";
import "@/styles/glossary.css";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogImage?: URL | undefined;
  noindex?: boolean | undefined;
  /** ISO date for article:modified_time (docs pages). */
  modifiedTime?: string | undefined;
}

const { title, description, ogImage, noindex, modifiedTime } = Astro.props;
---

<html lang="en">
  <head>
    <HeadSEO
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
      modifiedTime={modifiedTime}
    />
    {/* crossorigin is required even same-origin: font requests are CORS-mode,
        and a preload whose mode differs is discarded and fetched twice. */}
    <link
      rel="preload"
      href={interLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ClientRouter />
  </head>
  <body class="site-body">
    {/* First focusable element on every page (WCAG 2.4.1): lets keyboard users
        jump past the sticky header's navigation (about 25 focus stops on
        desktop with every dropdown closed). Every page provides the #main
        target (ContentPageLayout's <main>, or the page's own). */}
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="site-shell">
      <Header />
      <div class="site-main">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6rem 1.1rem;
    background: #0f172a;
    color: var(--assured-accent-soft);
    border: 1px solid rgba(94, 234, 212, 0.6);
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    /* Offscreen until focused; stays in the tab order the whole time. */
    transform: translateY(calc(-100% - 1.5rem));
  }

  .skip-link:focus {
    transform: translateY(0);
    outline: 2px solid var(--assured-accent-soft);
    outline-offset: 2px;
  }
</style>

<script>
  /*
   * Processed scripts run once per browser session, so these window-level
   * listeners bind exactly once and query the DOM at event time; content
   * swapped in by the ClientRouter is picked up without rebinding.
   */

  // Print: closed <details> (Reveal, and any other disclosure) never render
  // on paper, so open every closed one on beforeprint and restore the
  // reader's state afterwards. EvasionPattern opens its own panels the same
  // way; a panel it already opened is skipped here, so the two never fight.
  const PRINT_EXPANDED = "data-print-expanded";
  window.addEventListener("beforeprint", () => {
    document
      .querySelectorAll<HTMLDetailsElement>("details:not([open])")
      .forEach((panel) => {
        panel.setAttribute(PRINT_EXPANDED, "true");
        panel.open = true;
      });
  });
  window.addEventListener("afterprint", () => {
    document
      .querySelectorAll<HTMLDetailsElement>(`details[${PRINT_EXPANDED}]`)
      .forEach((panel) => {
        panel.removeAttribute(PRINT_EXPANDED);
        panel.open = false;
      });
  });

  // ClientRouter teardown: the glossary pages register document-level key
  // handlers and timers and expose a cleanup function, but they only call it
  // when their own script runs again. Without this, "/" and "?" stay
  // hijacked on every page visited after a glossary. Run every registered
  // cleanup before each swap; a glossary page re-binds its own handlers when
  // its script re-executes on arrival.
  const GLOSSARY_CLEANUPS = [
    "__clearGlossaryCleanup",
    "__badGlossaryCleanup",
    "__catGlossaryCleanup",
  ] as const;
  document.addEventListener("astro:before-swap", () => {
    const registry = window as unknown as Record<string, unknown>;
    for (const name of GLOSSARY_CLEANUPS) {
      const cleanup = registry[name];
      if (typeof cleanup === "function") {
        try {
          cleanup();
        } catch {
          // A failing teardown must not block navigation.
        }
      }
    }
  });
</script>
