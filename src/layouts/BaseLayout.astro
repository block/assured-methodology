---
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/Footer.astro";
import HeadSEO from "@/components/HeadSEO.astro";
import Header from "@/components/Header.astro";
// Variable fonts (OFL-licensed, self-hosted via Fontsource). One file per
// family covers weights 100-900; unicode-range subsetting means browsers
// only fetch the latin subset for this site.
import "@fontsource-variable/inter";
import "@fontsource-variable/inter/wght-italic.css";
import "@fontsource-variable/jetbrains-mono";
// Preload the one render-critical font file (Inter latin, upright) so the
// fetch starts with the HTML instead of after the CSS that declares the
// @font-face. ?url resolves to the hashed /_astro/ URL of the same file the
// Fontsource CSS references, so the preload and @font-face always agree.
import interLatinWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "@/styles/global.css";
import "@/styles/glossary.css";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogImage?: URL | undefined;
  noindex?: boolean | undefined;
}

const { title, description, ogImage, noindex } = Astro.props;
---

<html lang="en">
  <head>
    <HeadSEO
      title={title}
      description={description}
      ogImage={ogImage}
      noindex={noindex}
    />
    {/* crossorigin is required even same-origin: font requests are CORS-mode,
        and a preload whose mode differs is discarded and fetched twice. */}
    <link
      rel="preload"
      href={interLatinWoff2}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen font-sans antialiased">
    {/* First focusable element on every page (WCAG 2.4.1): lets keyboard users
        jump past the sticky header's ~12 focus stops. Every page provides the
        #main target (ContentPageLayout's <main>, or the page's own). */}
    <a href="#main" class="skip-link">Skip to content</a>
    <div class="relative flex min-h-screen flex-col">
      <Header />
      <div class="flex-1">
        <slot />
      </div>
      <Footer />
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6rem 1.1rem;
    background: #0f172a;
    color: var(--assured-accent-soft);
    border: 1px solid rgba(94, 234, 212, 0.6);
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    /* Offscreen until focused; stays in the tab order the whole time. */
    transform: translateY(calc(-100% - 1.5rem));
  }

  .skip-link:focus {
    transform: translateY(0);
    outline: 2px solid var(--assured-accent-soft);
    outline-offset: 2px;
  }
</style>
