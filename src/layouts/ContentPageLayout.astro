---
import { getCollection } from "astro:content";
import SimpleTableOfContents from "@/components/SimpleTableOfContents.astro";
import { readingOrder } from "@/data/navigation";
import type { MarkdownHeading } from "astro";
import { Breadcrumbs } from "astro-breadcrumbs";
import BaseLayout from "./BaseLayout.astro";
import "../styles/breadcrumbs.css";
import "../styles/content-patterns.css";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  showTitleAsH1?: boolean;
  showBreadcrumbs?: boolean;
  /** When true, removes the narrow prose constraint so the page can host wider visual sections. */
  wide?: boolean;
  /** When false, suppresses the in-page TOC even if the page has headings.
   *  Useful for overview/landing pages where the TOC creates an asymmetric
   *  layout (extra right-side gutter) without adding navigational value. */
  showToc?: boolean;
  /** When true, hides breadcrumbs + H1 and removes shell padding so the page goes edge-to-edge.
   *  Use for pages that bring their own hero (glossaries, themed landing pages). */
  chromeless?: boolean;
}

const {
  title,
  description,
  headings,
  showTitleAsH1 = true,
  showBreadcrumbs = true,
  wide = false,
  chromeless = false,
  showToc = true,
} = Astro.props;

// Chromeless implies no breadcrumbs, no H1, full-bleed wide layout.
const effectiveBreadcrumbs = chromeless ? false : showBreadcrumbs;
const effectiveTitle = chromeless ? false : showTitleAsH1;
const effectiveWide = chromeless ? true : wide;

// Prev/next pager: this page's position in the canonical reading order.
// Pages outside the linear arc (glossaries) are absent from readingOrder
// and render no pager.
// Internal links use the trailing-slash form Vercel serves, so normalize
// the build-time pathname the same way before any comparison.
const pagePath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const orderIndex = readingOrder.indexOf(pagePath);
const prevHref = orderIndex > 0 ? readingOrder[orderIndex - 1] : null;
const nextHref =
  orderIndex >= 0 && orderIndex < readingOrder.length - 1
    ? readingOrder[orderIndex + 1]
    : null;

// Build the crumb list ourselves so intermediate crumbs carry real page
// titles from the docs collection instead of capitalized slugs (which
// rendered "Triage Vs Ir" and "Mitre"). Long chapter titles are trimmed at
// the colon ("Alert: Understanding detection logic" → "Alert"). The current
// page is excluded below (excludeCurrentPage): its H1 renders directly
// underneath, so repeating it in the trail was pure duplication.
const docsEntries =
  effectiveBreadcrumbs || orderIndex >= 0 ? await getCollection("docs") : [];
const titleBySlug = new Map(docsEntries.map((e) => [e.id, e.data.title]));
const crumbTitle = (slug: string, fallback: string) => {
  const full = titleBySlug.get(slug);
  if (!full) return fallback.charAt(0).toUpperCase() + fallback.slice(1);
  return full.split(":")[0].trim();
};
// Pager links reuse the same title map: an href's entry id is the path
// minus the "/docs/" prefix, and crumbTitle's colon-trim keeps chapter
// index labels short ("Risk: ..." → "Risk").
const pagerTitle = (href: string) => {
  const id = href.slice("/docs/".length).replace(/\/+$/, "");
  return crumbTitle(id, id.split("/").pop() ?? id);
};
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const crumbs = effectiveBreadcrumbs
  ? [
      { text: "Home", href: "/" },
      ...pathSegments.map((segment, i) => {
        if (i === 0) return { text: "Docs", href: "/docs/intro/" };
        return {
          text: crumbTitle(pathSegments.slice(1, i + 1).join("/"), segment),
          href: `/${pathSegments.slice(0, i + 1).join("/")}/`,
        };
      }),
    ]
  : [];

// Structured data. The BreadcrumbList is ours, not the component's
// (schemaJsonScript={false} below): the component copies each crumb's
// relative href into @id, and excludeCurrentPage strips the leaf from the
// schema along with the visible trail. Crawlers want absolute @ids and the
// full trail including the current page.
const canonicalHref = new URL(
  Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`,
  Astro.site,
).href;
const breadcrumbSchema = effectiveBreadcrumbs
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((crumb, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: { "@id": new URL(crumb.href, Astro.site).href, name: crumb.text },
      })),
    })
  : null;
const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  ...(description ? { description } : {}),
  url: canonicalHref,
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    name: "ASSURED Methodology",
    url: Astro.site?.href,
  },
});
---

<BaseLayout title={title} description={description}>
  {/* JSON-LD is valid anywhere in the document; emitting it here keeps
      HeadSEO free of docs-only concerns. */}
  <script is:inline type="application/ld+json" set:html={articleSchema} />
  {breadcrumbSchema && (
    <script is:inline type="application/ld+json" set:html={breadcrumbSchema} />
  )}
  <div class={`content-page ${chromeless ? "is-chromeless" : ""}`}>
    <div class={`content-page__shell ${chromeless ? "is-chromeless" : ""}`}>
      <main id="main" class={`content-page__main ${chromeless ? "is-chromeless" : ""}`}>
        <div data-pagefind-body class={`content-page__main-inner prose ${effectiveWide ? "is-wide" : ""} ${chromeless ? "is-chromeless" : ""}`}>
          {effectiveBreadcrumbs && (
            <div class="content-page__breadcrumbs">
              <Breadcrumbs
                crumbs={crumbs}
                mainBemClass="c-breadcrumbs"
                ariaLabel="Breadcrumb navigation"
                excludeCurrentPage={true}
                schemaJsonScript={false}
              >
                <span slot="separator">&nbsp;›&nbsp;</span>
                <Fragment slot="index">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9.5 12 3l9 6.5"></path>
                    <path d="M5 8.5V21h14V8.5"></path>
                    <path d="M10 21v-6h4v6"></path>
                  </svg>
                  <span class="crumb-home-label">Home</span>
                </Fragment>
              </Breadcrumbs>
            </div>
          )}

          {effectiveTitle && (
            <h1 class="content-page__title">{title}</h1>
          )}

          <slot />

          {(prevHref || nextHref) && (
            <nav class="content-page__pager" aria-label="Reading order" data-pagefind-ignore>
              {prevHref && (
                <a class="content-page__pager-link is-prev" href={prevHref} rel="prev">
                  <span class="content-page__pager-dir">&larr; Previous</span>
                  <span class="content-page__pager-name">{pagerTitle(prevHref)}</span>
                </a>
              )}
              {nextHref && (
                <a class="content-page__pager-link is-next" href={nextHref} rel="next">
                  <span class="content-page__pager-dir">Next &rarr;</span>
                  <span class="content-page__pager-name">{pagerTitle(nextHref)}</span>
                </a>
              )}
            </nav>
          )}
        </div>

        {/* Outside the data-pagefind-body div so search never indexes it.
            SC 2.1.4: the docs pages (and glossaries) listen for keyboard
            easter-egg sequences; this is the visible, persisted off switch
            every egg handler checks. */}
        <footer class="content-page__eggs">
          <button type="button" data-egg-toggle aria-pressed="true">
            Keyboard easter eggs: on
          </button>
        </footer>
      </main>

      {/* After <main> in DOM order so keyboard focus reaches the page content
          before the TOC links; flex order matches, no CSS swap needed. */}
      {!chromeless && showToc && headings && headings.length > 0 && (
        <aside class="content-page__toc" aria-label="In-page navigation">
          <div class="content-page__toc-inner">
            <SimpleTableOfContents headings={headings} />
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .content-page {
    position: relative;
    min-height: calc(100vh - 4rem);
  }

  .content-page__shell {
    max-width: 88rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    gap: 2.5rem;
  }

  .content-page__toc {
    display: none;
    flex-shrink: 0;
    width: 16rem;
  }

  @media (min-width: 1024px) {
    .content-page__toc { display: block; }
  }

  .content-page__toc-inner {
    position: sticky;
    top: calc(var(--header-height) + 16px);
    padding: 1.5rem 0;
    max-height: calc(100vh - var(--header-height) - 16px);
    overflow-y: auto;
  }

  .content-page__main {
    flex: 1;
    min-width: 0;
    padding: 2rem 0 4rem;
  }

  .content-page__main-inner {
    max-width: 58rem;
    margin: 0 auto;
  }

  /* Wide mode for overview pages with rich visual sections (intro, chapter overviews) */
  .content-page__main-inner.is-wide {
    max-width: 96rem;
  }

  /* Keep prose from stretching across the whole wide shell so reading stays
     comfortable. The children are slotted MDX, which never carries this
     component's scope attribute, so they must be :global() — the previous
     scoped version of this rule compiled to `p[data-astro-cid-*]` and
     matched nothing. Callouts are top-level MDX too, hence the class here. */
  .content-page__main-inner.is-wide > :global(p),
  .content-page__main-inner.is-wide > :global(ul),
  .content-page__main-inner.is-wide > :global(ol),
  .content-page__main-inner.is-wide > :global(blockquote),
  .content-page__main-inner.is-wide > :global(.assured-callout) {
    max-width: var(--assured-content-max);
  }

  /* 3rem = the wrapper's old 1.5rem plus the 1.5rem breadcrumbs.css used to
     add on .c-breadcrumbs itself; consolidated here when that file was
     rewritten, keeping the rendered gap identical. */
  .content-page__breadcrumbs {
    margin-bottom: 3rem;
  }

  /* Visually hidden "Home" label: the home crumb's accessible name used to be
     a raw 🏠 emoji; now the SVG is decorative and this text names the link. */
  .content-page__breadcrumbs :global(.crumb-home-label) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .content-page__title {
    font-size: var(--assured-type-h1);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 2rem 0;
  }

  /* Slim prev/next pager. Deliberately quiet: most pages already end with a
     ContinueCard or transition CTA, so this is a fallback rail, not a hero. */
  .content-page__pager {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
  }

  .content-page__pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 48%;
    text-decoration: none;
  }

  .content-page__pager-link.is-next {
    margin-left: auto;
    text-align: right;
  }

  .content-page__pager-dir {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    /* #a8b3c4, not the slate-400 dim token: the pager sits over the
       viewport-fixed gradient, whose light band (#334155) leaves anything
       darker below the 4.5:1 normal-text floor (WCAG 1.4.3). */
    color: #a8b3c4;
  }

  .content-page__pager-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--assured-text-muted);
    transition: color 0.15s ease;
  }

  .content-page__pager-link:hover .content-page__pager-name,
  .content-page__pager-link:focus-visible .content-page__pager-name {
    color: var(--assured-accent-soft);
  }

  .content-page__eggs {
    text-align: center;
    padding: 0 0 2rem;
  }

  .content-page__eggs button {
    background: none;
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 9999px;
    color: #a8b3c4;
    font-size: 0.75rem;
    font-family: inherit;
    padding: 0.4rem 0.95rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  /* WCAG 2.5.5: 44px touch-target floor on touch devices. */
  @media (pointer: coarse) {
    .content-page__eggs button { min-height: 2.75rem; }
  }

  .content-page__eggs button:hover {
    color: var(--assured-text-soft);
    border-color: rgba(94, 234, 212, 0.6);
  }

  .content-page__eggs button:focus-visible {
    outline: 2px solid var(--assured-accent-soft);
    outline-offset: 2px;
  }

  /* ---------------- Chromeless: edge-to-edge themed pages ---------------- */
  .content-page.is-chromeless { min-height: auto; }

  .content-page__shell.is-chromeless {
    max-width: none;
    margin: 0;
    padding: 0;
    gap: 0;
    display: block;
  }

  .content-page__main.is-chromeless {
    padding: 0;
  }

  .content-page__main-inner.is-chromeless {
    max-width: none;
    margin: 0;
    padding: 0;
  }
</style>

<style is:global>
  /* ----------------------------------------------------------------------
     Easter egg styles (chapter-themed). Activated by script below.
     These MUST be global so dynamically-appended elements get styled.
     ---------------------------------------------------------------------- */
  .egg-toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(120%);
    z-index: 9999;
    padding: 1rem 1.75rem;
    border-radius: 0.75rem;
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    background: linear-gradient(135deg, #1e293b, #0f172a);
    border: 1px solid rgba(255,255,255,0.15);
    box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
    max-width: min(92vw, 36rem);
    text-align: center;
    line-height: 1.5;
  }
  .egg-toast.is-show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .egg-toast.alert    { background: linear-gradient(135deg, #7f1d1d, #450a0a); border-color: #fca5a5; }
  .egg-toast.subject  { background: linear-gradient(135deg, #4c1d95, #1e1b4b); border-color: #c4b5fd; }
  .egg-toast.scope    { background: linear-gradient(135deg, #065f46, #064e3b); border-color: #6ee7b7; }
  .egg-toast.uncover  { background: linear-gradient(135deg, #1e3a8a, #172554); border-color: #93c5fd; }
  .egg-toast.risk     { background: linear-gradient(135deg, #92400e, #451a03); border-color: #fcd34d; }
  .egg-toast.escal    { background: linear-gradient(135deg, #b91c1c, #7f1d1d); border-color: #fecaca; }
  .egg-toast.doc      { background: linear-gradient(135deg, #155e75, #164e63); border-color: #67e8f9; }
  .egg-toast.intro    { background: linear-gradient(135deg, #5b21b6, #312e81); border-color: #c4b5fd; }

  .egg-flash {
    position: fixed; inset: 0; z-index: 9998;
    pointer-events: none; opacity: 0;
    transition: opacity 0.18s ease;
  }
  .egg-flash.is-on { opacity: 1; }
  /* 1s pulse period = at most 1 flash/sec on these full-viewport overlays;
     faster cycles (0.4-0.5s) approach the WCAG 2.3.1 three-flash threshold. */
  .egg-flash.alert { background: radial-gradient(circle at 50% 50%, rgba(220,38,38,0.55), rgba(127,29,29,0.85)); animation: egg-pulse 1s ease-in-out 2; }
  .egg-flash.risk  { background: radial-gradient(circle at 50% 50%, rgba(250,204,21,0.45), rgba(146,64,14,0.8)); }
  .egg-flash.escal { background: radial-gradient(circle at 50% 50%, rgba(248,113,113,0.5), rgba(127,29,29,0.85)); animation: egg-pulse 1s ease-in-out 2; }

  @keyframes egg-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  .egg-zoom {
    animation: egg-zoom-kf 1.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: center center;
  }
  @keyframes egg-zoom-kf {
    0% { transform: scale(1); }
    40% { transform: scale(0.92); }
    100% { transform: scale(1); }
  }

  .egg-boundary {
    position: fixed; inset: 1.5rem; z-index: 9997;
    pointer-events: none;
    border: 3px dashed #6ee7b7;
    border-radius: 1rem;
    opacity: 0;
    animation: egg-bound-kf 1.6s ease-out;
  }
  @keyframes egg-bound-kf {
    0% { opacity: 0; transform: scale(1.08); }
    20% { opacity: 1; transform: scale(1); }
    100% { opacity: 0; transform: scale(0.98); }
  }

  .egg-matrix {
    position: fixed; top: -2rem; z-index: 9996;
    font-family: ui-monospace, monospace;
    font-weight: 700;
    color: #60a5fa;
    text-shadow: 0 0 8px rgba(96,165,250,0.8);
    pointer-events: none;
    user-select: none;
    animation: egg-fall 2.4s linear forwards;
    font-size: 1.25rem;
    white-space: nowrap;
  }
  @keyframes egg-fall {
    0% { transform: translateY(0); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateY(105vh); opacity: 0; }
  }

  .egg-d20 {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 9999;
    width: clamp(8rem, 30vmin, 14rem);
    height: clamp(8rem, 30vmin, 14rem);
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #92400e, #451a03);
    border: 4px solid #fcd34d;
    color: #fef3c7;
    font-family: ui-monospace, monospace;
    font-weight: 800;
    font-size: clamp(3rem, 12vmin, 5rem);
    border-radius: 1rem;
    clip-path: polygon(50% 0%, 95% 25%, 95% 75%, 50% 100%, 5% 75%, 5% 25%);
    box-shadow: 0 25px 80px rgba(0,0,0,0.6), 0 0 60px rgba(252,211,77,0.5);
    animation: egg-d20-kf 3s ease-out forwards;
    pointer-events: none;
  }
  @keyframes egg-d20-kf {
    0%   { transform: translate(-50%, -50%) rotate(0deg) scale(0.2); opacity: 0; }
    15%  { transform: translate(-50%, -50%) rotate(540deg) scale(1.1); opacity: 1; }
    35%  { transform: translate(-50%, -50%) rotate(900deg) scale(1); opacity: 1; }
    90%  { transform: translate(-50%, -50%) rotate(900deg) scale(1); opacity: 1; }
    100% { transform: translate(-50%, -50%) rotate(900deg) scale(0.6); opacity: 0; }
  }

  .egg-confetti {
    position: fixed; top: -1rem;
    width: 0.6rem; height: 1rem;
    z-index: 9995;
    pointer-events: none;
    animation: egg-confetti-kf 3s cubic-bezier(0.2, 0.6, 0.4, 1) forwards;
  }
  @keyframes egg-confetti-kf {
    0% { transform: translateY(0) rotate(0deg); opacity: 1; }
    100% { transform: translateY(105vh) rotate(720deg); opacity: 0; }
  }

  .egg-glow-hero h1,
  .egg-glow-hero .content-page__title {
    animation: egg-glow-kf 1.6s ease-in-out 2;
  }
  @keyframes egg-glow-kf {
    0%, 100% { text-shadow: none; }
    50% { text-shadow: 0 0 24px rgba(167,139,250,0.9), 0 0 48px rgba(96,165,250,0.6); color: #fff; }
  }

  /* ---------- BREAKGLASS: cracked-screen overlay ---------- */
  .egg-glass {
    position: fixed;
    inset: 0;
    z-index: 10000;
    pointer-events: none;
    opacity: 0;
    animation: egg-glass-show 4.8s ease-out forwards;
  }
  .egg-glass svg { width: 100%; height: 100%; display: block; }
  .egg-glass__crack {
    fill: none;
    stroke: rgba(255, 255, 255, 0.92);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
    filter: drop-shadow(0 0 3px rgba(255, 255, 255, 0.6));
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
    animation: egg-glass-draw 0.45s cubic-bezier(0.2, 0.8, 0.3, 1) forwards;
  }
  @keyframes egg-glass-draw { to { stroke-dashoffset: 0; } }
  @keyframes egg-glass-show {
    0% { opacity: 0; }
    6% { opacity: 1; }
    85% { opacity: 1; }
    100% { opacity: 0; }
  }
  .egg-glass__impact {
    animation: egg-glass-impact 0.45s ease-out forwards;
  }
  @keyframes egg-glass-impact {
    0% { r: 4; opacity: 1; stroke-width: 3; }
    100% { r: 70; opacity: 0; stroke-width: 0.5; }
  }

  /* Screen shake on body (applies to whole layout) */
  .egg-shake { animation: egg-screen-shake 0.55s ease-out; }
  @keyframes egg-screen-shake {
    0%, 100% { transform: translate(0); }
    10% { transform: translate(-6px, 3px); }
    20% { transform: translate(7px, -4px); }
    30% { transform: translate(-5px, 2px); }
    40% { transform: translate(4px, -3px); }
    50% { transform: translate(-3px, 3px); }
    60% { transform: translate(4px, -3px); }
    70% { transform: translate(-2px, 1px); }
    85% { transform: translate(1px, -1px); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Disable egg motion outright rather than shortening it (a faster
       confetti fall is worse for vestibular users, not better). Elements
       whose keyframes doubled as their visibility get static visible
       states; the JS removal timers still clean everything up. The
       opacity-only fades (egg-glass-show, .egg-toast fade, .egg-flash
       fade) stay: they are not motion. */
    .egg-toast { transition: opacity 0.3s ease; transform: translateX(-50%) translateY(0); }
    .egg-glass__crack { animation: none; stroke-dashoffset: 0; }
    .egg-glass__impact { animation: none; opacity: 0; }
    .egg-shake { animation: none; }
    .egg-flash.alert, .egg-flash.escal { animation: none; }
    .egg-zoom { animation: none; }
    .egg-boundary { animation: none; opacity: 1; }
    /* Matrix rain and confetti are also skipped at spawn time by a JS
       matchMedia gate; animation:none here is belt-and-braces against the
       inline per-particle animation-duration randomization. */
    .egg-matrix, .egg-confetti { animation: none !important; opacity: 0; }
    .egg-d20 { animation: none; }
    .egg-glow-hero h1, .egg-glow-hero .content-page__title { animation: none; }
  }
</style>

<script>
  // Chapter easter-egg engine, bundled once site-wide instead of inlined
  // into every content page. Re-binds per navigation via onPageReady.
  import "@/scripts/chapter-eggs.js";
</script>
