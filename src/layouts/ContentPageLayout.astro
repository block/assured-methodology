---
import BaseLayout from "./BaseLayout.astro";
import type { MarkdownHeading } from "astro";
import { Breadcrumbs } from "astro-breadcrumbs";
import SimpleTableOfContents from "@/components/SimpleTableOfContents.astro";
import "../styles/breadcrumbs.css";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  showTitleAsH1?: boolean;
  showBreadcrumbs?: boolean;
}

const { title, description, headings, showTitleAsH1 = true, showBreadcrumbs = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="content-page">
    <div class="content-page__shell">
      {headings && headings.length > 0 && (
        <aside class="content-page__toc" aria-label="In-page navigation">
          <div class="content-page__toc-inner">
            <SimpleTableOfContents headings={headings} />
          </div>
        </aside>
      )}

      <main class="content-page__main">
        <div class="content-page__main-inner prose">
          {showBreadcrumbs && (
            <div class="content-page__breadcrumbs">
              <Breadcrumbs
                indexText="Home"
                mainBemClass="c-breadcrumbs"
                ariaLabel="Breadcrumb navigation"
                linkTextFormat="capitalized"
                excludeCurrentPage={false}
              >
                <span slot="separator">&nbsp;›&nbsp;</span>
                <span slot="index">🏠</span>
              </Breadcrumbs>
            </div>
          )}

          {showTitleAsH1 && (
            <h1 class="content-page__title">{title}</h1>
          )}

          <slot />
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .content-page {
    position: relative;
    min-height: calc(100vh - 4rem);
  }

  .content-page__shell {
    max-width: 88rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    gap: 2.5rem;
  }

  .content-page__toc {
    display: none;
    flex-shrink: 0;
    width: 16rem;
    order: 2;
  }

  @media (min-width: 1024px) {
    .content-page__toc { display: block; }
  }

  .content-page__toc-inner {
    position: sticky;
    top: 80px;
    padding: 1.5rem 0;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
  }

  .content-page__main {
    flex: 1;
    min-width: 0;
    order: 1;
    padding: 2rem 0 4rem;
  }

  .content-page__main-inner {
    max-width: 50rem;
    margin: 0 auto;
  }

  .content-page__breadcrumbs {
    margin-bottom: 1.5rem;
  }

  .content-page__title {
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 2rem 0;
  }
</style>
