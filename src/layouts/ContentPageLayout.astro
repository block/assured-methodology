---
import { getCollection } from "astro:content";
import type { MarkdownHeading } from "astro";
import { Breadcrumbs } from "astro-breadcrumbs";
import SimpleTableOfContents from "@/components/SimpleTableOfContents.astro";
import { findNavItem, navTrail, sequenceFor } from "@/data/navigation";
import { stableId } from "@/lib/stable-id";
import BaseLayout from "./BaseLayout.astro";
import "../styles/breadcrumbs.css";
import "../styles/content-patterns.css";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  showTitleAsH1?: boolean;
  showBreadcrumbs?: boolean;
  /** When true, removes the narrow prose constraint so the page can host wider visual sections. */
  wide?: boolean;
  /** When false, suppresses the in-page TOC even if the page has headings.
   *  Useful for overview/landing pages where the TOC creates an asymmetric
   *  layout (extra right-side gutter) without adding navigational value. */
  showToc?: boolean;
  /** When true, hides breadcrumbs + H1 and removes shell padding so the page goes edge-to-edge.
   *  Use for pages that bring their own hero (glossaries, themed landing pages). */
  chromeless?: boolean;
  /** ISO date the page's product and vendor facts were last checked
   *  (frontmatter techVerified). Rendered under the content. */
  techVerified?: string;
  /** Repo-relative path of the page's source file (the content entry's
   *  filePath, e.g. src/content/docs/risk/index.mdx). Drives the "Edit this
   *  page" link; chapter index pages with a slug override still resolve to
   *  their real file. */
  sourcePath?: string;
  /** Estimated reading time in minutes, rendered under the title. Omitted
   *  on pages where a reading time means nothing (quizzes, glossaries). */
  readingMinutes?: number;
}

const REPO = "https://github.com/block/assured-methodology";

const {
  title,
  description,
  headings,
  showTitleAsH1 = true,
  showBreadcrumbs = true,
  wide = false,
  chromeless = false,
  showToc = true,
  techVerified,
  sourcePath,
  readingMinutes,
} = Astro.props;

const editHref = sourcePath ? `${REPO}/edit/main/${sourcePath}` : null;
const correctionHref = `${REPO}/issues/new?template=content-correction.yml`;
const hasToc = !chromeless && showToc && !!headings && headings.length > 0;

// Chromeless implies no breadcrumbs, no H1, full-bleed wide layout.
const effectiveBreadcrumbs = chromeless ? false : showBreadcrumbs;
const effectiveTitle = chromeless ? false : showTitleAsH1;
const effectiveWide = chromeless ? true : wide;

// Prev/next pager: this page's position in its sequence. The learner spine
// (readingOrder) runs intro → seven chapters → the guides that compress or
// operate the method; the Operate, Teach and train and About groups have
// their own short sequences (groupSequences). Hubs, Field reference pages,
// glossaries and case files sit in neither and render no pager.
// Internal links use the trailing-slash form Vercel serves, so normalize
// the build-time pathname the same way before any comparison.
const pagePath = Astro.url.pathname.endsWith("/")
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const sequence = sequenceFor(pagePath);
const order = sequence?.order ?? [];
const orderIndex = order.indexOf(pagePath);
const prevHref = orderIndex > 0 ? order[orderIndex - 1] : null;
const nextHref =
  orderIndex >= 0 && orderIndex < order.length - 1
    ? order[orderIndex + 1]
    : null;
const pagerLabel =
  sequence && sequence.name !== "Reading order"
    ? `${sequence.name} pages`
    : "Reading order";

// Build the crumb list ourselves so intermediate crumbs carry real page
// titles from the docs collection instead of capitalized slugs (which
// rendered "Triage Vs Ir" and "Mitre"). Long chapter titles are trimmed at
// the colon ("Alert: Understanding detection logic" → "Alert"). The current
// page is excluded below (excludeCurrentPage): its H1 renders directly
// underneath, so repeating it in the trail was pure duplication.
const docsEntries =
  effectiveBreadcrumbs || orderIndex >= 0 ? await getCollection("docs") : [];
const titleBySlug = new Map(docsEntries.map((e) => [e.id, e.data.title]));
const crumbTitle = (slug: string, fallback: string) => {
  const full = titleBySlug.get(slug);
  if (!full) return fallback.charAt(0).toUpperCase() + fallback.slice(1);
  return full.split(":")[0].trim();
};
// Pager links prefer the navigation label (one source for names), then
// fall back to the same title map: an href's entry id is the path minus the
// "/docs/" prefix, and crumbTitle's colon-trim keeps chapter index labels
// short ("Risk: ..." → "Risk").
const pagerTitle = (href: string) => {
  const nav = findNavItem(href);
  if (nav) return nav.title;
  const id = href.slice("/docs/".length).replace(/\/+$/, "");
  return crumbTitle(id, id.split("/").pop() ?? id);
};
// Breadcrumbs follow the navigation when the page is in it (Home › Method ›
// Alert, Home › Field reference › Reading telemetry), so a page filed away
// from its URL's parent still shows where the menus put it. Pages the
// navigation does not list fall back to their URL path.
const trail = navTrail(pagePath);
const pathSegments = Astro.url.pathname.split("/").filter(Boolean);
const crumbs = effectiveBreadcrumbs
  ? [
      { text: "Home", href: "/" },
      ...(trail.length > 0 || findNavItem(pagePath)
        ? trail.map((item) => ({ text: item.title, href: item.href }))
        : pathSegments.slice(0, -1).map((segment, i) => {
            if (i === 0) return { text: "Docs", href: "/docs/start/" };
            return {
              text: crumbTitle(pathSegments.slice(1, i + 1).join("/"), segment),
              href: `/${pathSegments.slice(0, i + 1).join("/")}/`,
            };
          })),
      // The current page: excluded from the visible trail by
      // excludeCurrentPage, kept for the BreadcrumbList schema.
      { text: title, href: pagePath },
    ]
  : [];

// Structured data. The BreadcrumbList is ours, not the component's
// (schemaJsonScript={false} below): the component copies each crumb's
// relative href into @id, and excludeCurrentPage strips the leaf from the
// schema along with the visible trail. Crawlers want absolute @ids and the
// full trail including the current page.
const canonicalHref = new URL(
  Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`,
  Astro.site,
).href;
const breadcrumbSchema = effectiveBreadcrumbs
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((crumb, i) => ({
        "@type": "ListItem",
        position: i + 1,
        item: { "@id": new URL(crumb.href, Astro.site).href, name: crumb.text },
      })),
    })
  : null;
const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  ...(description ? { description } : {}),
  url: canonicalHref,
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    name: "ASSURED Methodology",
    url: Astro.site?.href,
  },
});
---

<BaseLayout title={title} description={description} modifiedTime={techVerified}>
  {/* JSON-LD is valid anywhere in the document; emitting it here keeps
      HeadSEO free of docs-only concerns. */}
  <script is:inline type="application/ld+json" set:html={articleSchema} />
  {breadcrumbSchema && (
    <script is:inline type="application/ld+json" set:html={breadcrumbSchema} />
  )}
  <div class={`content-page ${chromeless ? "is-chromeless" : ""}`}>
    <div class={`content-page__shell ${chromeless ? "is-chromeless" : ""}`}>
      <main id="main" class={`content-page__main ${chromeless ? "is-chromeless" : ""}`}>
        <div data-pagefind-body class={`content-page__main-inner prose ${effectiveWide ? "is-wide" : ""} ${chromeless ? "is-chromeless" : ""}`}>
          {effectiveBreadcrumbs && (
            <div class="content-page__breadcrumbs" data-pagefind-ignore>
              <Breadcrumbs
                crumbs={crumbs}
                mainBemClass="c-breadcrumbs"
                ariaLabel="Breadcrumb navigation"
                excludeCurrentPage={true}
                schemaJsonScript={false}
                id={stableId("breadcrumbs", Astro.url.pathname)}
              >
                <span slot="separator">&nbsp;›&nbsp;</span>
                <Fragment slot="index">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9.5 12 3l9 6.5"></path>
                    <path d="M5 8.5V21h14V8.5"></path>
                    <path d="M10 21v-6h4v6"></path>
                  </svg>
                  <span class="crumb-home-label">Home</span>
                </Fragment>
              </Breadcrumbs>
            </div>
          )}

          {effectiveTitle && (
            <h1 class={`content-page__title ${readingMinutes ? "has-meta" : ""}`}>{title}</h1>
          )}

          {effectiveTitle && readingMinutes && (
            <p class="content-page__meta" data-pagefind-ignore>
              About {readingMinutes} min read
            </p>
          )}

          {/* Below 1024px the sidebar TOC is hidden; a collapsed disclosure
              takes its place at the top of the page. */}
          {hasToc && headings && (
            <details class="content-page__toc-mobile" data-pagefind-ignore>
              <summary>On this page</summary>
              <SimpleTableOfContents headings={headings} id="table-of-contents-mobile" />
            </details>
          )}

          <slot />

          {(techVerified || editHref) && (
            <div class="content-page__provenance" data-pagefind-ignore>
              {techVerified && (
                <p class="content-page__verified">
                  Technical details verified <time datetime={techVerified}>{techVerified}</time>.
                  Product names, defaults and retention change; check your own tenant.
                </p>
              )}
              <p class="content-page__verified content-page__edit">
                {editHref && (
                  <a href={editHref} target="_blank" rel="noopener noreferrer">Edit this page on GitHub</a>
                )}
                {editHref && <span aria-hidden="true"> · </span>}
                <a href={correctionHref} target="_blank" rel="noopener noreferrer">Report a correction</a>
              </p>
            </div>
          )}

          {(prevHref || nextHref) && (
            <nav class="content-page__pager" aria-label={pagerLabel} data-pagefind-ignore>
              {prevHref && (
                <a class="content-page__pager-link is-prev" href={prevHref} rel="prev">
                  <span class="content-page__pager-dir">&larr; Previous</span>
                  <span class="content-page__pager-name">{pagerTitle(prevHref)}</span>
                </a>
              )}
              {nextHref && (
                <a class="content-page__pager-link is-next" href={nextHref} rel="next">
                  <span class="content-page__pager-dir">Next &rarr;</span>
                  <span class="content-page__pager-name">{pagerTitle(nextHref)}</span>
                </a>
              )}
            </nav>
          )}
        </div>

        {/* Outside the data-pagefind-body div so search never indexes it.
            SC 2.1.4: the docs pages (and glossaries) listen for keyboard
            easter-egg sequences; this is the visible, persisted switch
            every egg handler checks. Eggs are off until a reader turns
            them on (see the default-off seed in the script below). */}
        <footer class="content-page__eggs">
          <button type="button" data-egg-toggle aria-pressed="false">
            Keyboard easter eggs
          </button>
        </footer>
      </main>

      {/* After <main> in DOM order so keyboard focus reaches the page content
          before the TOC links; flex order matches, no CSS swap needed. */}
      {hasToc && headings && (
        <aside class="content-page__toc" aria-label="In-page navigation">
          <div class="content-page__toc-inner">
            <SimpleTableOfContents headings={headings} />
          </div>
        </aside>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .content-page {
    position: relative;
    min-height: calc(100vh - 4rem);
  }

  .content-page__shell {
    max-width: 88rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    gap: 2.5rem;
  }

  .content-page__toc {
    display: none;
    flex-shrink: 0;
    width: 16rem;
  }

  @media (min-width: 1024px) {
    .content-page__toc { display: block; }
  }

  .content-page__toc-inner {
    position: sticky;
    top: calc(var(--header-height) + 16px);
    padding: 1.5rem 0;
    max-height: calc(100vh - var(--header-height) - 16px);
    overflow-y: auto;
  }

  .content-page__main {
    flex: 1;
    min-width: 0;
    padding: 2rem 0 4rem;
  }

  .content-page__main-inner {
    max-width: 58rem;
    margin: 0 auto;
  }

  /* Wide mode for overview pages with rich visual sections (intro, chapter overviews) */
  .content-page__main-inner.is-wide {
    max-width: 96rem;
  }

  /* Keep running prose near 75 characters a line in every mode, so reading
     stays comfortable on normal and wide pages alike. Cards, tables,
     figures and callouts keep the full column: callouts are left out on
     purpose so they line up with the cards and phase blocks around them.
     The children are slotted MDX, which never carries this component's
     scope attribute, so they must be :global(); a scoped version of this
     rule would compile to `p[data-astro-cid-*]` and match nothing. */
  .content-page__main-inner > :global(p),
  .content-page__main-inner > :global(ul),
  .content-page__main-inner > :global(ol),
  .content-page__main-inner > :global(blockquote) {
    max-width: var(--assured-content-max);
  }

  /* 3rem = the wrapper's old 1.5rem plus the 1.5rem breadcrumbs.css used to
     add on .c-breadcrumbs itself; consolidated here when that file was
     rewritten, keeping the rendered gap identical. */
  .content-page__breadcrumbs {
    margin-bottom: 3rem;
  }

  /* Visually hidden "Home" label: the home crumb's accessible name used to be
     a raw 🏠 emoji; now the SVG is decorative and this text names the link. */
  .content-page__breadcrumbs :global(.crumb-home-label) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .content-page__title {
    font-size: var(--assured-type-h1);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin: 0 0 2rem 0;
  }

  .content-page__title.has-meta {
    margin-bottom: 0.6rem;
  }

  .content-page__meta {
    margin: 0 0 2rem;
    /* #a8b3c4: the title area sits over the page gradient's light band,
       where the slate-400 dim token falls under 4.5:1. */
    color: #a8b3c4;
    font-size: 0.85rem;
    font-weight: 500;
  }

  /* Collapsed in-page navigation for narrow screens. */
  .content-page__toc-mobile {
    margin: 0 0 2rem;
    padding: 0.6rem 1rem;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: var(--assured-radius-sm);
    background: var(--assured-panel);
  }

  .content-page__toc-mobile > summary {
    cursor: pointer;
    color: var(--assured-text-soft);
    font-size: 0.85rem;
    font-weight: 600;
    min-height: 2rem;
    display: flex;
    align-items: center;
  }

  .content-page__toc-mobile[open] > summary {
    margin-bottom: 0.5rem;
  }

  /* The summary already says "On this page". */
  .content-page__toc-mobile :global(.toc__title) {
    display: none;
  }

  @media (min-width: 1024px) {
    .content-page__toc-mobile { display: none; }
  }

  .content-page__provenance {
    margin-top: 2.5rem;
  }

  .content-page__verified {
    margin: 0 0 0.35rem;
    /* #a8b3c4 for the same light-band reason as the meta line above. */
    color: #a8b3c4;
    font-size: 0.82rem;
  }

  .content-page__edit a {
    color: var(--assured-text-muted);
    text-decoration: underline;
    text-decoration-color: rgba(148, 163, 184, 0.45);
    text-underline-offset: 0.2em;
  }

  .content-page__edit a:hover,
  .content-page__edit a:focus-visible {
    color: var(--assured-accent-soft);
  }

  /* Slim prev/next pager. Deliberately quiet: most pages already end with a
     ContinueCard or transition CTA, so this is a fallback rail, not a hero. */
  .content-page__pager {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
  }

  .content-page__pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 48%;
    text-decoration: none;
  }

  .content-page__pager-link.is-next {
    margin-left: auto;
    text-align: right;
  }

  .content-page__pager-dir {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    /* #a8b3c4, not the slate-400 dim token: the pager sits over the
       viewport-fixed gradient, whose light band (#334155) leaves anything
       darker below the 4.5:1 normal-text floor (WCAG 1.4.3). */
    color: #a8b3c4;
  }

  .content-page__pager-name {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--assured-text-muted);
    transition: color 0.15s ease;
  }

  .content-page__pager-link:hover .content-page__pager-name,
  .content-page__pager-link:focus-visible .content-page__pager-name {
    color: var(--assured-accent-soft);
  }

  .content-page__eggs {
    text-align: center;
    padding: 0 0 2rem;
  }

  .content-page__eggs button {
    background: none;
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 9999px;
    color: #a8b3c4;
    font-size: 0.75rem;
    font-family: inherit;
    padding: 0.4rem 0.95rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  /* WCAG 2.5.5: 44px touch-target floor on touch devices. */
  @media (pointer: coarse) {
    .content-page__eggs button { min-height: 2.75rem; }
  }

  /* The state lives in aria-pressed alone; the dot shows it visually. */
  .content-page__eggs button::before {
    content: "";
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.45rem;
    border-radius: 50%;
    border: 1px solid currentColor;
    vertical-align: 0.05em;
  }

  .content-page__eggs button[aria-pressed="true"] {
    color: var(--assured-accent-soft);
    border-color: rgba(94, 234, 212, 0.6);
  }

  .content-page__eggs button[aria-pressed="true"]::before {
    background: currentColor;
  }

  .content-page__eggs button:hover {
    color: var(--assured-text-soft);
    border-color: rgba(94, 234, 212, 0.6);
  }

  .content-page__eggs button:focus-visible {
    outline: 2px solid var(--assured-accent-soft);
    outline-offset: 2px;
  }

  /* ---------------- Chromeless: edge-to-edge themed pages ---------------- */
  .content-page.is-chromeless { min-height: auto; }

  .content-page__shell.is-chromeless {
    max-width: none;
    margin: 0;
    padding: 0;
    gap: 0;
    display: block;
  }

  .content-page__main.is-chromeless {
    padding: 0;
  }

  .content-page__main-inner.is-chromeless {
    max-width: none;
    margin: 0;
    padding: 0;
  }
</style>

<script>
  // Keyboard easter eggs are off by default. The chapter engine treats any
  // stored value except "on" as off, so this "off" seed is belt-and-braces
  // for the glossary pages' own handlers; the toggle in the page footer
  // stores "on" when a reader opts in. Seeding runs before the engine loads
  // (a dynamic import, which also keeps the engine and its lazily loaded
  // CSS out of the main bundle).
  try {
    if (localStorage.getItem("assured-eggs") === null) {
      localStorage.setItem("assured-eggs", "off");
    }
  } catch {
    // Storage blocked: the engine's own fallback applies.
  }
  // Chapter easter-egg engine, bundled once site-wide instead of inlined
  // into every content page. Re-binds per navigation via onPageReady.
  void import("@/scripts/chapter-eggs.js");
</script>
