---

/**
 * This is a base layout for all content pages backed by Markdown. It accepts a named 
 * slot "navbar", and the main slot is typically filled with Markdown content. Typical usage 
 * may look like like:
 * 
 * <ContentPageLayout title={title} 
 *   description={description} 
 *   headings={headings} 
 *   maxWidth="wide">
 *   
 *   <ComponentsNavbar slot="navbar" />
 *   <Content components={MDXComponents} />
 * 
 * </ContentPageLayout>
 * 
 * If the "navbar" slot is omitted, the left sidebar will not be present. If the 
 * "headings" are not passed, the right sidebar will not be present.
 */


import BaseLayout from "./BaseLayout.astro";
import type { MarkdownHeading } from 'astro';
import { Breadcrumbs } from "astro-breadcrumbs";
import SimpleTableOfContents from "@/components/SimpleTableOfContents.astro";
import "../styles/breadcrumbs.css";

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
  showTitleAsH1?: boolean;
  showBreadcrumbs?: boolean;
}

const { title, description, headings, showTitleAsH1 = true, showBreadcrumbs = true } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="relative min-h-[calc(100vh-4rem)]">
    <!-- Cybersecurity Background Pattern -->
    <div class="absolute inset-0 bg-cyber-pattern" style="opacity: 0.1;"></div>

    <!-- Main Layout -->
    <div class="relative mx-auto max-w-[1800px] px-6 flex flex-col lg:flex-row gap-6 max-md:px-4">
      
      <!-- Left Sidebar: On This Page -->
      {headings && headings.length > 0 && (
        <nav class="lg:w-64 flex-shrink-0 order-2 lg:order-1 hidden lg:block">
          <div class="py-6 px-6 border-r border-gray-200 dark:border-gray-700 bg-white/60 dark:bg-slate-800/60 backdrop-blur-sm">
            <SimpleTableOfContents headings={headings} />
          </div>
        </nav>
      )}

      <!-- Main Content -->
      <main class="flex-1 order-1 lg:order-2 min-w-0 py-8 px-10 xl:px-6 lg:px-6 md:px-4">
        <div id="mainContent" class="prose prose-slate dark:prose-invert mx-auto" style="max-width: none;">
          
          {/** Breadcrumbs */}
          {showBreadcrumbs && (
            <div class="mb-6 mt-2">
              <Breadcrumbs 
                indexText="Home"
                mainBemClass="c-breadcrumbs"
                ariaLabel="Breadcrumb navigation"
                linkTextFormat="capitalized"
                excludeCurrentPage={false}
              >
                <span slot="separator">&nbsp;›&nbsp;</span>
                <span slot="index">
                  🏠
                </span>
              </Breadcrumbs>
            </div>
          )}
          
          {/** h1 with the page title */}
          {showTitleAsH1 && (
            <h1 class="text-4xl md:text-5xl font-bold mb-8 leading-tight">{title}</h1>
          )}
          <slot />
        </div>
      </main>

    </div>
  </div>
</BaseLayout>

<style>
  /* Cybersecurity background pattern */
  .bg-cyber-pattern {
    background-image: 
      radial-gradient(circle at 20% 20%, rgba(59, 130, 246, 0.3) 0%, transparent 20%),
      radial-gradient(circle at 80% 80%, rgba(16, 185, 129, 0.3) 0%, transparent 20%),
      radial-gradient(circle at 40% 60%, rgba(139, 92, 246, 0.2) 0%, transparent 15%),
      linear-gradient(rgba(59, 130, 246, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(59, 130, 246, 0.1) 1px, transparent 1px);
    background-size: 200px 200px, 300px 300px, 150px 150px, 40px 40px, 40px 40px;
    background-position: 0 0, 100px 100px, 50px 50px, 0 0, 0 0;
  }

  /* Improve scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Override prose max-width */
  .prose {
    max-width: none !important;
  }

  /* Ensure list items can span full width */
  .prose ul, .prose ol {
    width: 100% !important;
    display: block !important;
  }
  
  .prose li {
    width: 100% !important;
    display: list-item !important;
    white-space: normal !important;
  }

  /* Clean, minimal sidebar styling */

  /* Mobile adjustments */
  @media (max-width: 1024px) {
    /* Hide sidebar on mobile */
    nav {
      display: none !important;
    }
  }
</style>