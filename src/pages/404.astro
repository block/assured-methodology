---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 - Not Found"
  description="404 Error, this page was not found"
  noindex
>
  <main id="main" class="not-found">
    <p class="not-found__code">404</p>
    <h1 class="not-found__title">Page not found</h1>
    <p class="not-found__lede">
      Sorry, we couldn't find the page you're looking for.
    </p>
    <a href="/" class="assured-cta">Go back home</a>
    <p class="not-found__links">
      Or start from the <a href="/docs/intro/">introduction</a>, skim the
      <a href="/docs/reference/">quick reference</a>, or search the site from
      the header.
    </p>
  </main>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 8rem 2rem 4rem;
  }

  .not-found__code {
    margin: 0 0 0.5rem 0;
    color: var(--assured-text-dim);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
  }

  .not-found__title {
    margin: 0 0 1.5rem 0;
  }

  .not-found__lede {
    margin: 0 0 2rem 0;
    color: var(--assured-text-muted);
  }

  .not-found__links {
    margin: 2rem 0 0 0;
    max-width: 34rem;
    color: var(--assured-text-dim);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .not-found__links a {
    color: var(--assured-accent-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
