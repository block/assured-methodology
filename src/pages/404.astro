---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 - Not Found"
  description="404 Error, this page was not found"
>
  <main id="main" class="mt-32 flex flex-col items-center justify-center px-8">
    <p class="text-muted-foreground text-sm">404</p>
    <h1 class="scroll-m-20 text-4xl font-extrabold tracking-tight lg:text-5xl">
      Page not found
    </h1>
    <p class="mb-4 leading-7 [&:not(:first-child)]:mt-6">
      Sorry, we couldn't find the page you're looking for.
    </p>
    <a href="/" rel="noreferrer" class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow hover:bg-primary/90 h-9 px-4 py-2"> Go back home</a>
  </main>
</BaseLayout>
