---
import { getCollection, render } from "astro:content";
import ContentPageLayout from "@/layouts/ContentPageLayout.astro";

/**
 * Magic required function for dynamic routes; determines the slug
 */
export async function getStaticPaths() {
  const docs = await getCollection("docs");

  // The entry id is the route: the glob loader derives it from the file
  // path, or from a frontmatter `slug` override where one is declared
  // (chapter index pages).
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: doc,
  }));
}

/**
 * Properties used on this page
 */
const doc = Astro.props;
const title = doc.data.title;
const description = doc.data.description;
const wide = doc.data.wide ?? false;
const chromeless = doc.data.chromeless ?? false;
const showToc = doc.data.showToc ?? true;
const { Content, headings } = await render(doc);
---

<ContentPageLayout
  title={title}
  description={description}
  headings={headings}
  wide={wide}
  chromeless={chromeless}
  showToc={showToc}
  showTitleAsH1={true}
  showBreadcrumbs={true}
>
  <Content />
</ContentPageLayout>