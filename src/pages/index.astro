---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroPuzzle from "@/components/assured/HeroPuzzle.astro";
import ChapterCard from "@/components/assured/ChapterCard.astro";
import FlipCard from "@/components/assured/FlipCard.astro";

const chapterStatus = {
  alert: "live",
  subject: "soon",
  scope: "soon",
  uncover: "soon",
  risk: "soon",
  escalation: "soon",
  documentation: "soon",
} as const;
---

<BaseLayout
  title="ASSURED: Triage with confidence"
  description="ASSURED is a structured, repeatable methodology for security event triage. Turn raw alerts into clear decisions, fast."
>
  <!-- HERO -->
  <section class="home-hero">
    <div class="home-hero__inner">
      <span class="home-hero__overline">A · S · S · U · R · E · D</span>

      <h1 class="home-hero__headline">
        Triage with confidence.
        <span class="home-hero__accent">Assemble the puzzle.</span>
      </h1>

      <p class="home-hero__lede">
        ASSURED is a structured, repeatable methodology for security event
        triage. Each alert is its own puzzle, and the analyst's job is to
        assemble just enough of the picture to know what they are looking at
        and what to do next. Seven components, three phases, one consistent
        way to work.
      </p>

      <div class="home-hero__cta-row">
        <a href="/docs/intro" class="assured-cta">
          Read the introduction
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="M13 5l7 7-7 7"></path>
          </svg>
        </a>
        <a href="/docs/alert" class="assured-cta assured-cta--ghost">
          Jump to the Alert chapter
        </a>
      </div>

      <HeroPuzzle />
    </div>

    <div class="home-hero__decor" aria-hidden="true"></div>
  </section>

  <!-- WHY ASSURED -->
  <section class="home-section home-section--alt">
    <div class="home-section__inner">
      <header class="home-section__head">
        <span class="home-section__overline">Why this exists</span>
        <h2 class="home-section__title">
          Most frameworks tell you what to do <em>after</em> you already know
          what you are looking at.
        </h2>
        <p class="home-section__lede">
          ASSURED is about the step before that. Event triage is a distinct
          skill, separate from the broader incident response work it feeds
          into, and until now it did not have a dedicated method that
          analysts could learn, teach, and refine.
        </p>
        <p class="home-section__hint">Tap any card to see the full picture.</p>
      </header>

      <div class="flip-grid">
        <FlipCard icon="🕒" title="A method for the first 30 minutes" accent="teal">
          NIST, SANS PICERL, and MITRE ATT&CK describe a complete response
          once you already have the picture. ASSURED gives you a repeatable
          way to *build* that picture, alert by alert, in the critical
          window before an incident is declared.
        </FlipCard>

        <FlipCard icon="🪜" title="Built for mentees and seasoned analysts" accent="blue">
          Every chapter pairs a concept with the questions a triage analyst
          should ask and the artifacts they should leave behind. Junior
          analysts get scaffolding to lean on while their instincts develop.
          Senior analysts get a checklist that travels with the handoff.
        </FlipCard>

        <FlipCard icon="🔁" title="Triage is not strictly linear" accent="green">
          ASSURED's seven components have a default order, but feedback loops
          back to earlier phases are explicit. Risk findings send you back
          to Uncover. Uncover surfaces new Subjects. The methodology
          embraces that flow rather than pretending triage is an assembly
          line.
        </FlipCard>
      </div>
    </div>
  </section>

  <!-- CHAPTERS GRID -->
  <section class="home-section">
    <div class="home-section__inner">
      <header class="home-section__head">
        <span class="home-section__overline">Explore the methodology</span>
        <h2 class="home-section__title">Seven letters. One question per letter.</h2>
        <p class="home-section__lede">
          Each phase answers a single, specific question. Only Alert is
          published right now. The rest are being moved from the source
          manuscript.
        </p>
      </header>

      <div class="assured-phase-grid">
        <ChapterCard
          letter="A"
          phase="alert"
          title="Alert"
          description="Understand detection logic, validate the signal, parse alert metadata into something an analyst can act on."
          href="/docs/alert"
          status="live"
          topics={[
            "Detection mechanisms: signature, anomaly, rule, behavioral",
            "Validation across technical, environmental, intelligence, and business dimensions",
            "Parsing command lines, process trees, network activity, file system, schema",
          ]}
        />

        <ChapterCard
          letter="S"
          phase="subject"
          title="Subject"
          description="Identify the who. Any entity that authenticated or acted: user, robot account, EC2 instance, cloud role, service."
          href="/docs/subject"
          status={chapterStatus.subject}
          topics={[
            "The four dimensions: authentication, authorization, behavior, relationships",
            "Entity types: users, endpoints, services, identifiers",
            "Insider analysis and the Insider Threat Matrix",
          ]}
        />

        <ChapterCard
          letter="S"
          phase="scope"
          title="Scope"
          description="Decide where the lines are. Time windows, entities in play, regulatory boundaries. Without scope, investigations sprawl."
          href="/docs/scope"
          status={chapterStatus.scope}
          topics={[
            "Regulatory requirements: GDPR, CCPA, HIPAA, PCI-DSS, SOX",
            "Time-based parameters and historical windows",
            "Entity-based scope and dependency tracing",
          ]}
        />

        <ChapterCard
          letter="U"
          phase="uncover"
          title="Uncover"
          description="Pull the evidence. Correlate endpoint, network, identity, and cloud telemetry to find root cause."
          href="/docs/uncover"
          status={chapterStatus.uncover}
          topics={[
            "Data sources for evidence gathering",
            "Threat intelligence: tiers, validation, scoring",
            "MITRE ATT&CK: tactics, techniques, procedures",
          ]}
        />

        <ChapterCard
          letter="R"
          phase="risk"
          title="Risk"
          description="Decide how bad. Asset criticality, attacker sophistication, business impact, likelihood. Risk turns evidence into priority."
          href="/docs/risk"
          status={chapterStatus.risk}
          topics={[
            "Risk-based alert triage matrix",
            "Impact, likelihood, and actor sophistication",
            "The value of investigating a false positive",
          ]}
        />

        <ChapterCard
          letter="E"
          phase="escalation"
          title="Escalation"
          description="Hand it off cleanly. The triage analyst's deliverable is the handoff packet: context, evidence, and a recommendation."
          href="/docs/escalation"
          status={chapterStatus.escalation}
          topics={[
            "Criteria for escalation",
            "Internal and external protocols",
            "Event triage vs. incident response",
          ]}
        />

        <ChapterCard
          letter="D"
          phase="documentation"
          title="Documentation"
          description="Close the loop. Decisions, evidence, and reasoning so the next analyst and the auditor can replay your thinking."
          href="/docs/documentation"
          status={chapterStatus.documentation}
          topics={[
            "Standards for consistency",
            "Templates for efficient recording",
            "Documentation pitfalls and how to avoid them",
          ]}
        />
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="home-section home-section--alt">
    <div class="home-section__inner home-closing">
      <h2>Ready to begin?</h2>
      <p>
        Read the introduction for the full picture, or jump straight into
        Alert. The first piece of the puzzle.
      </p>
      <div class="home-closing__cta-row">
        <a href="/docs/intro" class="assured-cta">
          Read the introduction
        </a>
        <a href="/docs/alert" class="assured-cta assured-cta--ghost">
          Start with Alert →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .home-hero {
    position: relative;
    padding: clamp(3rem, 8vw, 6rem) 1.5rem clamp(3rem, 6vw, 4rem);
    overflow: hidden;
  }

  .home-hero__inner {
    max-width: 64rem;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .home-hero__overline {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    border-radius: 9999px;
    background: rgba(20, 184, 166, 0.15);
    border: 1px solid rgba(20, 184, 166, 0.35);
    color: #5eead4;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
  }

  .home-hero__headline {
    font-size: clamp(2rem, 5.5vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #f8fafc;
    margin: 0 0 1rem 0;
  }

  .home-hero__accent {
    display: block;
    background: linear-gradient(135deg, #5eead4, #60a5fa);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .home-hero__lede {
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    color: #cbd5e1;
    max-width: 56ch;
    margin: 0 auto 2rem auto;
    line-height: 1.65;
  }

  .home-hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 3rem;
  }

  .home-hero__decor {
    position: absolute;
    top: -10%;
    right: -10%;
    width: 50vw;
    height: 50vw;
    max-width: 700px;
    max-height: 700px;
    background: radial-gradient(circle, rgba(20, 184, 166, 0.12), transparent 60%);
    filter: blur(40px);
    pointer-events: none;
  }

  /* Section scaffolding */
  .home-section {
    padding: clamp(3rem, 6vw, 5rem) 1.5rem;
  }

  .home-section--alt {
    background: rgba(15, 23, 42, 0.45);
    border-top: 1px solid rgba(148, 163, 184, 0.12);
    border-bottom: 1px solid rgba(148, 163, 184, 0.12);
  }

  .home-section__inner {
    max-width: 76rem;
    margin: 0 auto;
  }

  .home-section__head {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .home-section__overline {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    background: rgba(20, 184, 166, 0.14);
    color: #5eead4;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }

  .home-section__title {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: #f8fafc;
    margin: 0 auto 0.85rem;
    max-width: 38ch;
    line-height: 1.2;
  }

  .home-section__lede {
    color: #cbd5e1;
    max-width: 60ch;
    margin: 0 auto;
    line-height: 1.65;
  }

  .home-section__hint {
    margin: 0.85rem auto 0;
    font-size: 0.82rem;
    color: #5eead4;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* Flip grid (for FlipCard rows) */
  .flip-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .flip-grid { grid-template-columns: 1fr 1fr 1fr; }
  }

  /* Why grid (legacy, kept for layout fallback) */
  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .why-grid { grid-template-columns: 1fr 1fr 1fr; }
  }

  .why-card {
    padding: 1.5rem;
    border-radius: 1rem;
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid rgba(148, 163, 184, 0.2);
    backdrop-filter: blur(8px);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .why-card:hover {
    transform: translateY(-3px);
    border-color: rgba(20, 184, 166, 0.4);
  }

  .why-card__icon {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .why-card h3 {
    margin: 0 0 0.5rem 0;
    color: #f8fafc;
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .why-card p {
    margin: 0;
    color: #cbd5e1;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Closing */
  .home-closing {
    text-align: center;
  }

  .home-closing h2 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    color: #f8fafc;
    margin: 0 0 0.75rem 0;
  }

  .home-closing p {
    color: #cbd5e1;
    max-width: 50ch;
    margin: 0 auto 1.75rem auto;
  }

  .home-closing__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
