{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/intro/",
      "permanent": true
    },
    {
      "source": "/docs/",
      "destination": "/docs/intro/",
      "permanent": true
    },
    {
      "source": "/docs/overview",
      "destination": "/docs/intro/",
      "permanent": true
    },
    {
      "source": "/docs/overview/",
      "destination": "/docs/intro/",
      "permanent": true
    },
    {
      "source": "/docs/alert/parsing/schema",
      "destination": "/docs/alert/parsing/multi-format/",
      "permanent": true
    },
    {
      "source": "/docs/alert/parsing/schema/",
      "destination": "/docs/alert/parsing/multi-format/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), midi=(), serial=(), sync-xhr=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-1VyaPi83Nnn/zk9KP6zMgnZ0DGCZUFN2J8klBKhqEEk=' 'sha256-XNzjNTmys34CdI7SJlLQO/G80tIk5kxES52mbdJ4QBk=' 'sha256-ba/OKjQVScGefFrfrDvKenCzGaec9hZZ11QvA4Gktrs=' 'sha256-fDYeTC+QfIWybmtdD+Mm+By3Nu0rmReKAFHu+3O3rAM=' 'sha256-sg2Q2Pa5OMX+UEvg+UgUaxw5mzEg3RSeeopyhIS6QME=' 'sha256-wcAwqNyTV9C3VsHJxs82eZIUQX7ezPlwurmCP38OvJc='; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pagefind/fragment/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pagefind/index/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pagefind/pagefind.(.*).pf_meta",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/pagefind/wasm.(.*).pagefind",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/pagefind/(pagefind|pagefind-ui|pagefind-highlight).(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
